<!DOCTYPE html>

<html lang="es">

<head>
    


    <link rel="stylesheet"
          href="~/css/accesibilidad-lavielle.css"
          asp-append-version="true" />

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - L'Avielle
    </title>

    <link rel="stylesheet"
          href="~/css/especialista2.css" />

    <link rel="stylesheet"
          href="~/css/especialista.css" />

          
<!-- ESTILOS DEL ESPECIALISTA -->
<link rel="stylesheet"
      href="~/css/especialista2.css" />

<link rel="stylesheet"
      href="~/css/especialista.css" />

<!-- MENÚ DE ACCESIBILIDAD -->
<link rel="stylesheet"
      href="~/css/accesibilidad-lavielle.css" />

<!-- ESTILOS PARTICULARES DE CADA VISTA -->
@await RenderSectionAsync("Styles", required: false)

<!-- TEMA OSCURO DEL ESPECIALISTA -->
<link rel="stylesheet"
      href="~/css/accesibilidad-especialista-temas.css"
      asp-append-version="true" />
      
<script src="@Url.Content("~/js/accesibilidad-global.js")"></script>

</head>


<body>

    <div class="especialista-layout">


        <aside class="sidebar-especialista">


            <div class="logo-especialista">
                L'Avielle
            </div>


            
            <strong>
                @(ViewBag.NombreEspecialista ?? "Especialista")
            </strong>

            <span>
                @(ViewBag.RolEspecialista ?? "")
            </span>



            <nav class="menu-especialista">


               
                <a asp-controller="EspecialistaAgenda"
                   asp-action="MiAgenda">
                    Mi Agenda
                </a>



                
                <a href="@Url.Action("Disponibilidad", "EspecialistaDisponibilidad")">
                    Disponibilidad
                </a>



                <a asp-controller="Especialista"
                   asp-action="PerfilEspecialista">

                    Mi Perfil

                </a>


            </nav>


            
<div class="cerrar-especialista">

    <form action="@Url.Action("CerrarSesion", "Login")"
          method="post">

        @Html.AntiForgeryToken()

        <button type="submit"
                class="btn-cerrar-sesion">
            Cerrar Sesión
        </button>

    </form>

</div>



        </aside>


        <main class="contenido-especialista">

            @RenderBody()

        </main>


    </div>


    <footer class="footer">

        <div class="footer-seccion">

            <h2>
                L’Avielle
            </h2>

            <p>
                Un concepto exclusivo de salón de belleza
                y spa de bienestar, donde el lujo se
                traduce en calma, elegancia y atención
                de nivel internacional.
            </p>

        </div>


        <div class="footer-seccion">

            <h4>
                NAVEGACIÓN
            </h4>

            <p>
                Mi Agenda
            </p>

            <a href="@Url.Action("Disponibilidad", "EspecialistaDisponibilidad")">
                Disponibilidad
            </a>


            <p>
                Mi Perfil
            </p>

        </div>


        <div class="footer-seccion">

            <h4>
                CONTACTO & UBICACIÓN
            </h4>

            <p>
                Paseo de la Reforma 402,
                Juárez, CDMX
            </p>

            <p>
                +52 55 1234 5678
            </p>

            <p>
                contacto@lavielle.com
            </p>

        </div>

    </footer>
    

    <!-- MENÚ DE ACCESIBILIDAD -->
    @await Html.PartialAsync(
        "~/Views/Shared/_MenuAccesibilidad.cshtml"
    )

    <!-- JAVASCRIPT DE ACCESIBILIDAD -->
    <script src="@Url.Content("~/js/accesibilidad-lavielle.js")"
            defer></script>

    @await RenderSectionAsync("Scripts", required: false)


</body>

</html>