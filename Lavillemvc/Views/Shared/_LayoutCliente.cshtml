<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - L'Avielle</title>

    <link rel="stylesheet" href="~/css/especialista2.css" />

    <script src="@Url.Content("~/js/accesibilidad-global.js")"></script>


</head>

<body>

    <div class="pagina">

        <aside class="sidebar">

            <div class="logo">
                L'Avielle
            </div>

            <nav class="menu">

                <a asp-controller="Cliente"
                   asp-action="DashboardCliente">
                    Dashboard
                </a>

                <a asp-controller="Cliente"
                   asp-action="ReservarCita">
                    Reservar Cita
                </a>

                <a asp-controller="Cliente"
                   asp-action="MisReservas">
                    Mis Reservas
                </a>

                <a asp-controller="Cliente"
                   asp-action="Promociones">
                    Promociones
                </a>

                <a asp-controller="Cliente"
                   asp-action="PerfilCliente">
                    Mi Perfil
                </a>

            </nav>

            <div class="cerrar">
                Cerrar Sesión
            </div>

        </aside>


        <main class="contenido">

            @RenderBody()

        </main>

    </div>


    <footer class="footer">

        <div class="footer-seccion">

            <h2>
                L’Avielle
            </h2>

            <p>
                Un concepto exclusivo de salón de belleza
                y spa de bienestar, donde el lujo se
                traduce en calma, elegancia y atención
                de nivel internacional.
            </p>

        </div>


        <div class="footer-seccion">

            <h4>
                NAVEGACIÓN
            </h4>

            <p>Inicio</p>
            <p>Servicios</p>
            <p>Especialistas</p>
            <p>Perfil</p>
            <p>Registrarse</p>

        </div>


        <div class="footer-seccion">

            <h4>
                CONTACTO & UBICACIÓN
            </h4>

            <p>
                Paseo de la Reforma 402,
                Juárez, CDMX
            </p>

            <p>
                +52 55 1234 5678
            </p>

            <p>
                contacto@lavielle.com
            </p>

        </div>

    </footer>


    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>