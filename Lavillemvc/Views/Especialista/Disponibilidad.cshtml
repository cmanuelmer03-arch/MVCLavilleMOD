@model Lavillemvc.Models.EspecialistaDisponibilidad
@using System.Globalization
@using System.Linq
@{
    Layout = "~/Views/Shared/_LayoutEspecialista.cshtml";
    ViewData["Title"] = "Mi Disponibilidad";
    var cultura = CultureInfo.GetCultureInfo("es-SV");
    var fechaMin = Model.FechaHoy.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture);
}

@section Styles {
    <link rel="stylesheet" href="@Url.Content("~/css/especialista-disponibilidad-conexion.css")" asp-append-version="true" />
}

<div class="disponibilidad-page">
    <header class="disponibilidad-header">
        <h1>Mi Disponibilidad</h1>
        <p>Configura tus horarios de atención para que los clientes puedan reservar contigo.</p>
        <p class="disp-nombre">@Model.NombreEspecialista · @Model.NombreEspecialidad</p>
    </header>

    @if (ViewBag.ModoPrueba == true)
    {
        <p class="disp-mensaje disp-aviso" role="status">
            Modo de desarrollo: estás viendo los datos del especialista de prueba.
            Los cambios que guardes se escribirán en Supabase.
        </p>
    }
    @if (TempData["DisponibilidadExito"] is string exito)
    {
        <p class="disp-mensaje disp-exito" role="status">@exito</p>
    }
    @if (TempData["DisponibilidadError"] is string error)
    {
        <p class="disp-mensaje disp-error" role="alert">@error</p>
    }

    <div class="disponibilidad-contenido">
        <!-- HORARIOS REALES DE SUPABASE -->
        <section class="horarios-card" aria-labelledby="horarios-titulo">
            <h2 id="horarios-titulo">HORARIOS SEMANALES HABITUALES</h2>
            @if (!Model.TieneHorarioConfigurado)
            {
                <p class="disp-ayuda">Todavía no has guardado ningún horario semanal. Activa los días que trabajarás y guarda los cambios.</p>
            }
            <form id="form-horario" method="post"
                  action="@Url.Action("GuardarHorario", "EspecialistaDisponibilidad")">
                @Html.AntiForgeryToken()
                @for (int i = 0; i < Model.Horarios.Count; i++)
                {
                    var d = Model.Horarios[i];
                    <div class="dia-horario @(d.Habilitado ? "" : "apagado")">
                        <div class="disp-dia-identidad">
                            <label class="switch-horario" title="Activar o desactivar @d.NombreDia">
                                <input type="checkbox"
                                       name="Horarios[@i].Habilitado"
                                       value="true"
                                       checked="@d.Habilitado"
                                       aria-label="Trabajar el @d.NombreDia" />
                                <span class="disp-switch-pista"></span>
                            </label>
                            <input type="hidden" name="Horarios[@i].Habilitado" value="false" />
                            <input type="hidden" name="Horarios[@i].DiaSemana" value="@d.DiaSemana" />
                            <strong>@d.NombreDia</strong>
                        </div>

                        <div class="disp-horas" aria-label="Jornada de @d.NombreDia">
                            <label>
                                <small>Inicio</small>
                                <input type="time" name="Horarios[@i].HoraInicio"
                                       value="@(d.HoraInicio ?? "09:00")" step="900"
                                       aria-label="Inicio de @d.NombreDia" />
                            </label>
                            <span class="disp-separador">a</span>
                            <label>
                                <small>Fin</small>
                                <input type="time" name="Horarios[@i].HoraFin"
                                       value="@(d.HoraFin ?? "18:00")" step="900"
                                       aria-label="Fin de @d.NombreDia" />
                            </label>
                        </div>
                        <div class="almuerzo-horario">
                            <small>ALMUERZO (opcional)</small>
                            <label>
                                <span class="sr-only">Inicio del almuerzo de @d.NombreDia</span>
                                <input type="time" name="Horarios[@i].InicioAlmuerzo"
                                       value="@(d.InicioAlmuerzo ?? "")" step="900" />
                            </label>
                            <span class="disp-separador">a</span>
                            <label>
                                <span class="sr-only">Fin del almuerzo de @d.NombreDia</span>
                                <input type="time" name="Horarios[@i].FinAlmuerzo"
                                       value="@(d.FinAlmuerzo ?? "")" step="900" />
                            </label>
                        </div>
                        @if (!d.Configurado)
                        {
                            <small class="disp-sin-guardar">Sin configurar</small>
                        }
                    </div>
                }
            </form>
        </section>

        <!-- AUSENCIAS Y RESUMEN REAL -->
        <div class="disponibilidad-derecha">
            <section class="ausencias-card" aria-labelledby="ausencias-titulo">
                <h2 id="ausencias-titulo">Días Especiales / Ausencias</h2>
                @if (!Model.Ausencias.Any())
                {
                    <p class="disp-ayuda">No tienes ausencias registradas.</p>
                }
                else
                {
                    @foreach (var ausencia in Model.Ausencias)
                    {
                        <div class="ausencia-item">
                            <div>
                                <strong>@ausencia.Titulo</strong>
                                <small>
                                    @ausencia.FechaInicio.ToString("dd MMM yyyy", cultura)
                                    @if (ausencia.FechaFin != ausencia.FechaInicio)
                                    {
                                        <text> al @ausencia.FechaFin.ToString("dd MMM yyyy", cultura)</text>
                                    }
                                </small>
                                @if (!string.IsNullOrWhiteSpace(ausencia.Descripcion))
                                {
                                    <small>@ausencia.Descripcion</small>
                                }
                            </div>
                            <span class="disp-tipo-ausencia @(ausencia.Tipo.Equals("Vacaciones", StringComparison.OrdinalIgnoreCase) ? "ausencia-vacaciones" : ausencia.Tipo.Equals("Capacitación", StringComparison.OrdinalIgnoreCase) ? "ausencia-capacitacion" : "ausencia-personal")">
                                @ausencia.Tipo
                            </span>
                        </div>
                    }
                }

                <details class="disp-nueva-ausencia">
                    <summary class="agregar-ausencia">+ Agregar Ausencia o Día Especial</summary>
                    <form method="post" action="@Url.Action("AgregarAusencia", "EspecialistaDisponibilidad")" class="disp-ausencia-form">
                        @Html.AntiForgeryToken()
                        <label>
                            Título
                            <input type="text" name="Titulo" maxlength="100" minlength="3"
                                   placeholder="Ej. Vacaciones" required />
                        </label>
                        <label>
                            Tipo
                            <select name="Tipo" required>
                                <option value="">Selecciona...</option>
                                <option value="Vacaciones">Vacaciones</option>
                                <option value="Capacitación">Capacitación</option>
                                <option value="Personal">Personal</option>
                                <option value="Otro">Otro</option>
                            </select>
                        </label>
                        <div class="disp-fechas-ausencia">
                            <label>
                                Desde
                                <input type="date" name="FechaInicio" min="@fechaMin" required />
                            </label>
                            <label>
                                Hasta
                                <input type="date" name="FechaFin" min="@fechaMin" required />
                            </label>
                        </div>
                        <label>
                            Descripción (opcional)
                            <textarea name="Descripcion" rows="2" maxlength="500"
                                      placeholder="Información adicional"></textarea>
                        </label>
                        <p class="disp-ayuda">Si ya tienes citas pendientes o confirmadas durante esas fechas, primero deberás reprogramarlas.</p>
                        <button type="submit" class="btn-guardar-horario">Registrar ausencia</button>
                    </form>
                </details>
            </section>

            <section class="resumen-semanal" aria-labelledby="resumen-titulo">
                <h2 id="resumen-titulo">Resumen Semanal</h2>
                <div>
                    <span>Horas semanales de atención</span>
                    <strong>@(Model.HorasSemanales.HasValue ? Model.HorasSemanales.Value.ToString("0.##", cultura) + " h" : "Sin configurar")</strong>
                </div>
                <div>
                    <span>Días de atención activos</span>
                    <strong>@Model.DiasActivos días</strong>
                </div>
                <div>
                    <span>Descanso semanal</span>
                    <strong>@(Model.DescansoSemanal ?? "Sin configurar")</strong>
                </div>
                <div>
                    <span>Próxima ausencia programada</span>
                    <strong class="proxima-ausencia">
                        @if (Model.ProximaAusenciaInicio.HasValue)
                        {
                            @Model.ProximaAusenciaInicio.Value.ToString("dd MMM yyyy", cultura)
                            <text> (@Model.ProximaAusenciaTitulo)</text>
                        }
                        else
                        {
                            <text>Sin ausencias próximas</text>
                        }
                    </strong>
                </div>
            </section>
        </div>
    </div>

    <div class="disponibilidad-acciones">
        <button type="reset" form="form-horario" class="btn-restablecer">
            Deshacer cambios
        </button>
        <button type="submit" form="form-horario" class="btn-guardar-horario">
            Guardar Cambios
        </button>
    </div>
</div>

@section Scripts {
    <script src="@Url.Content("~/js/especialista-disponibilidad.js")" asp-append-version="true"></script>
}
