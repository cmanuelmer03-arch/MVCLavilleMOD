@{
    ViewData["Title"] = "Mi Perfil";
    Layout = "~/Views/Shared/_LayoutEspecialista.cshtml";
}

<div class="perfil-especialista">

    <div class="perfil-especialista-titulo">

        <h1>Mi Perfil</h1>

        <p>
            Gestiona tu información profesional, datos personales y preferencias de trabajo.
        </p>

    </div>


    <div class="perfil-especialista-presentacion">

        <div class="perfil-especialista-foto">

            <div class="foto-especialista">
                VR
            </div>

            <button type="button">
                Cambiar Foto
            </button>

        </div>


        <div class="perfil-especialista-datos">

            <div class="perfil-especialista-nombre">

                <h2>Valentina Rojas</h2>

                <span>COLORISTA EXPERTA</span>

            </div>

            <p>
                <strong>Correo:</strong>
                valentina.rojas@lavielle.com
            </p>

            <p>
                Especialista en coloración, balayage y tratamientos capilares.
            </p>

            <p>
                Miembro del equipo desde Enero 2024
            </p>

        </div>

    </div>


    <div class="perfil-especialista-columnas">


        <div class="perfil-especialista-card">

            <h2>Información Personal</h2>

            <hr />

            <div class="perfil-especialista-form">

                <div class="campo-especialista">

                    <label>Nombre</label>

                    <input type="text" value="Valentina" />

                </div>


                <div class="campo-especialista">

                    <label>Apellido</label>

                    <input type="text" value="Rojas" />

                </div>


                <div class="campo-especialista">

                    <label>Correo Electrónico</label>

                    <input type="text" value="valentina.rojas@lavielle.com" />

                </div>


                <div class="campo-especialista">

                    <label>Teléfono</label>

                    <input type="text" value="+52 55 9876 4321" />

                </div>


                <div class="campo-especialista">

                    <label>Especialidad</label>

                    <input type="text" value="Colorista Experta" />

                </div>


                <div class="campo-especialista">

                    <label>Experiencia</label>

                    <input type="text" value="8 años" />

                </div>

            </div>


            <div class="guardar-especialista">

                <button type="button">
                    Guardar Cambios
                </button>

            </div>

        </div>


        <div class="perfil-especialista-derecha">


            <div class="perfil-especialista-card">

                <h2>Información Profesional</h2>

                <hr />


                <div class="dato-profesional">

                    <span>Especialidad Principal</span>

                    <strong>Coloración y Balayage</strong>

                </div>


                <div class="dato-profesional">

                    <span>Servicios que realiza</span>

                    <strong>Balayage, Mechas, Tintes y Corrección de Color</strong>

                </div>


                <div class="dato-profesional">

                    <span>Sucursal Asignada</span>

                    <strong>L'Avielle Las Mercedes</strong>

                </div>


                <div class="dato-profesional">

                    <span>Horario Habitual</span>

                    <strong>Lunes a Sábado</strong>

                </div>


                <div class="dato-profesional">

                    <span>Clientes atendidos</span>

                    <strong>248 clientes</strong>

                </div>

            </div>


            <div class="perfil-especialista-card">

                <h2>Preferencias de Trabajo</h2>

                <hr />


                <div class="preferencia-especialista">

                    <div>

                        <strong>Nuevas reservas</strong>

                        <p>
                            Recibir notificaciones cuando un cliente reserve una cita.
                        </p>

                    </div>

                    <label class="switch-especialista">

                        <input type="checkbox" checked />

                        <span></span>

                    </label>

                </div>


                <div class="preferencia-especialista">

                    <div>

                        <strong>Recordatorios de citas</strong>

                        <p>
                            Recibir recordatorios antes de cada servicio.
                        </p>

                    </div>

                    <label class="switch-especialista">

                        <input type="checkbox" checked />

                        <span></span>

                    </label>

                </div>


                <div class="preferencia-especialista">

                    <div>

                        <strong>Promociones internas</strong>

                        <p>
                            Recibir información sobre promociones y eventos.
                        </p>

                    </div>

                    <label class="switch-especialista">

                        <input type="checkbox" />

                        <span></span>

                    </label>

                </div>

            </div>


            <div class="perfil-especialista-card configuracion-especialista">

                <h2>Configuración de la Cuenta</h2>

                <hr />

                <div class="configuracion-especialista-item">
                    Cambiar Contraseña
                </div>

                <div class="configuracion-especialista-item">
                    <span>Idioma</span>
                    <span>Español (ES)</span>
                </div>

                <div class="configuracion-especialista-item eliminar-especialista">
                    Cerrar cuenta
                </div>

            </div>

        </div>

    </div>

</div>