@model Lavillemvc.Models.AdminDashboardGeneral
@using System
@using System.Linq
@using System.Globalization
@using System.Collections.Generic

@{
    Layout = null;

    var cultura = CultureInfo.GetCultureInfo("es-SV");
    var culturaDinero = CultureInfo.GetCultureInfo("en-US");

    string fechaPanel = Model.FechaReferencia == default
        ? "Fecha no disponible"
        : cultura.TextInfo.ToTitleCase(
            Model.FechaReferencia.ToString("MMMM yyyy", cultura));

    var sucursales = Model.RendimientoSucursales;
    var reservasEstado = Model.ReservasPorEstado;
    var actividades = Model.ActividadReciente;

    decimal ingresoMaximo = sucursales.Count > 0
        ? sucursales.Max(s => s.IngresosMes)
        : 0;

    int totalEstados = reservasEstado.Sum(
        e => Math.Max(0, e.Cantidad));

    var colores = new Dictionary<string, string>(
        StringComparer.OrdinalIgnoreCase)
    {
        ["Confirmadas"] = "#62463a",
        ["Completadas"] = "#cba45b",
        ["Canceladas"] = "#e8c7c8",
        ["Pendientes"] = "#a67c6b",
        ["Otros"] = "#d7d1cd"
    };

    var sectores = new List<string>();
    decimal anguloActual = 0;

    foreach (var estado in reservasEstado)
    {
        if (estado.Cantidad <= 0 || totalEstados == 0)
        {
            continue;
        }

        decimal inicio = anguloActual;

        anguloActual +=
            (decimal)estado.Cantidad / totalEstados * 360m;

        string color = colores.TryGetValue(
            estado.Estado, out var colorEstado)
            ? colorEstado
            : "#d7d1cd";

        sectores.Add(
            $"{color} " +
            $"{inicio.ToString("0.###", CultureInfo.InvariantCulture)}deg " +
            $"{anguloActual.ToString("0.###", CultureInfo.InvariantCulture)}deg"
        );
    }

    string estiloDona = sectores.Count > 0
        ? $"background: conic-gradient({string.Join(", ", sectores)});"
        : "background: #eee4db;";
}

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Dashboard General - L'Avielle</title>

    <link href="~/css/dashboard.css" rel="stylesheet" />
</head>

<body>
    <div class="page">

        <div class="content-wrapper">

            <!-- SIDEBAR -->
            <aside class="sidebar">

                <div class="sidebar-top">

                    <div class="brand-group">
                        <div class="brand-logo">
                            L'Avielle
                        </div>

                        <div class="admin-badge">
                            Administrador General
                        </div>
                    </div>

                    <nav class="nav-list">

                        <a href="@Url.Action("Dashboard", "Admin")"
                           class="sidebar-link active">

                            <span class="nav-icon">
                                <svg viewBox="0 0 24 24">
                                    <rect x="3" y="3" width="7" height="7" rx="1"></rect>
                                    <rect x="14" y="3" width="7" height="7" rx="1"></rect>
                                    <rect x="3" y="14" width="7" height="7" rx="1"></rect>
                                    <rect x="14" y="14" width="7" height="7" rx="1"></rect>
                                </svg>
                            </span>

                            <span class="tab-text">
                                Dashboard General
                            </span>

                            <span class="active-indicator"></span>
                        </a>

                        <a href="@Url.Action("GestionUsuarios", "Admin")"
                           class="sidebar-link">

                            <span class="nav-icon">
                                <svg viewBox="0 0 24 24">
                                    <circle cx="9" cy="8" r="3"></circle>
                                    <path d="M3 20c0-3.2 2.7-5 6-5s6 1.8 6 5"></path>
                                    <path d="M16 11c2.8 0 5 1.5 5 4"></path>
                                </svg>
                            </span>

                            <span class="tab-text">
                                Gestión de Usuarios
                            </span>
                        </a>

                        <a href="@Url.Action("GestionSucursales", "Admin")"
                           class="sidebar-link">

                            <span class="nav-icon">
                                <svg viewBox="0 0 24 24">
                                    <rect x="4" y="3" width="16" height="18" rx="1"></rect>
                                    <path d="M8 7h1M12 7h1M16 7h1"></path>
                                    <path d="M8 11h1M12 11h1M16 11h1"></path>
                                    <path d="M8 15h1M12 15h1M16 15h1"></path>
                                    <path d="M10 21v-3h4v3"></path>
                                </svg>
                            </span>

                            <span class="tab-text">
                                Gestión de Sucursales
                            </span>
                        </a>

                        <a href="@Url.Action("GestionServicios", "Admin")"
                           class="sidebar-link">

                            <span class="nav-icon">
                                <svg viewBox="0 0 24 24">
                                    <path d="M12 3l1.3 4.7L18 9l-4.7 1.3L12 15l-1.3-4.7L6 9l4.7-1.3z"></path>
                                    <path d="m19 14 .7 2.3L22 17l-2.3.7L19 20l-.7-2.3L16 17l2.3-.7z"></path>
                                </svg>
                            </span>

                            <span class="tab-text">
                                Gestión de Servicios
                            </span>
                        </a>

                        <a href="@Url.Action("ReportesGenerales", "Admin")"
                           class="sidebar-link">

                            <span class="nav-icon">
                                <svg viewBox="0 0 24 24">
                                    <path d="M4 19V9"></path>
                                    <path d="M10 19V5"></path>
                                    <path d="M16 19v-7"></path>
                                    <path d="M22 19V3"></path>
                                </svg>
                            </span>

                            <span class="tab-text">
                                Reportes
                            </span>
                        </a>

                    </nav>
                </div>

                <!-- CERRAR SESIÓN -->
                <div class="sidebar-bottom">

                    <div class="divider"></div>

                    <a href="@Url.Action("Index", "Login")"
                       class="sidebar-link logout-link">

                        <span class="nav-icon">
                            <svg viewBox="0 0 24 24">
                                <path d="M9 4H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h4"></path>
                                <path d="M14 8l4 4-4 4"></path>
                                <path d="M10 12h8"></path>
                            </svg>
                        </span>

                        <span class="tab-text">
                            Cerrar Sesión
                        </span>
                    </a>
                </div>

            </aside>

            <!-- CONTENIDO PRINCIPAL -->
            <main class="main-content">

                <div class="welcome-header">

                    <div class="header-text">
                        <h1>Dashboard General</h1>

                        <div class="header-sub">

                            <span>
                                L'Avielle - Panel Administrativo
                            </span>

                            <span class="sub-dot"></span>

                            <span class="date">
                                @fechaPanel
                            </span>
                        </div>
                    </div>
                </div>

                @if (ViewBag.ErrorDashboard != null)
                {
                    <div style="padding:15px; background:#fff4ef;
                        border:1px solid #e8c7c8;
                        border-radius:10px; color:#824b40;">
                        @ViewBag.ErrorDashboard
                    </div>
                }

                <!-- TARJETAS PRINCIPALES -->
                <section class="kpi-cards-row">

                    <div class="kpi-card">
                        <div class="kpi-header">
                            <span class="kpi-title">
                                Reservas Totales
                            </span>

                            <span class="icon-container">
                                <svg viewBox="0 0 24 24">
                                    <rect x="3" y="4" width="18" height="17" rx="2"></rect>
                                    <path d="M7 2v4M17 2v4M3 9h18"></path>
                                    <path d="m9 15 2 2 4-4"></path>
                                </svg>
                            </span>
                        </div>

                        <div class="kpi-value">
                            @Model.ReservasTotales.ToString("N0", cultura)
                        </div>
                    </div>

                    <div class="kpi-card">
                        <div class="kpi-header">

                            <span class="kpi-title">
                                Usuarios Registrados
                            </span>

                            <span class="icon-container">
                                <svg viewBox="0 0 24 24">
                                    <circle cx="9" cy="8" r="3"></circle>
                                    <path d="M3 20c0-3.2 2.7-5 6-5s6 1.8 6 5"></path>
                                    <path d="M16 11c2.8 0 5 1.5 5 4"></path>
                                </svg>
                            </span>
                        </div>

                        <div class="kpi-value">
                            @Model.UsuariosRegistrados.ToString("N0", cultura)
                        </div>
                    </div>

                    <div class="kpi-card">
                        <div class="kpi-header">

                            <span class="kpi-title">
                                Sucursales Activas
                            </span>

                            <span class="icon-container">
                                <svg viewBox="0 0 24 24">
                                    <path d="M12 21s7-6.4 7-12a7 7 0 1 0-14 0c0 5.6 7 12 7 12z"></path>
                                    <circle cx="12" cy="9" r="2.5"></circle>
                                </svg>
                            </span>
                        </div>

                        <div class="kpi-value">
                            @Model.SucursalesActivas.ToString("N0", cultura)
                        </div>
                    </div>

                    <div class="kpi-card">
                        <div class="kpi-header">

                            <span class="kpi-title">
                                Servicios Disponibles
                            </span>

                            <span class="icon-container">
                                <svg viewBox="0 0 24 24">
                                    <path d="M12 3l1.3 4.7L18 9l-4.7 1.3L12 15l-1.3-4.7L6 9l4.7-1.3z"></path>
                                    <path d="m19 14 .7 2.3L22 17l-2.3.7L19 20l-.7-2.3L16 17l2.3-.7z"></path>
                                </svg>
                            </span>
                        </div>

                        <div class="kpi-value">
                            @Model.ServiciosDisponibles.ToString("N0", cultura)
                        </div>
                    </div>

                    <div class="kpi-card">
                        <div class="kpi-header">

                            <span class="kpi-title">
                                Promociones Activas
                            </span>

                            <span class="icon-container">
                                <svg viewBox="0 0 24 24">
                                    <circle cx="8" cy="8" r="3"></circle>
                                    <circle cx="16" cy="16" r="3"></circle>
                                    <path d="M5 19 19 5"></path>
                                </svg>
                            </span>
                        </div>

                        <div class="kpi-value">
                            @Model.PromocionesActivas.ToString("N0", cultura)
                        </div>
                    </div>

                    <div class="kpi-card">
                        <div class="kpi-header">

                            <span class="kpi-title">
                                Ingresos del Mes
                            </span>

                            <span class="icon-container">
                                <svg viewBox="0 0 24 24">
                                    <rect x="3" y="6" width="18" height="12" rx="2"></rect>
                                    <circle cx="12" cy="12" r="2.5"></circle>
                                </svg>
                            </span>
                        </div>

                        <div class="kpi-value money">
                            @Model.IngresosMes.ToString("C2", culturaDinero)
                        </div>
                    </div>

                </section>

                <!-- GRÁFICOS -->
                <section class="visual-section">

                    <!-- RENDIMIENTO POR SUCURSAL -->
                    <div class="performance-card">

                        <h2>Rendimiento por Sucursal</h2>

                        <div class="horizontal-bars-container">

                            @if (sucursales.Count > 0)
                            {
                                foreach (var sucursal in sucursales)
                                {
                                    decimal porcentaje = ingresoMaximo > 0
                                        ? Math.Max(0,
                                            sucursal.IngresosMes / ingresoMaximo * 100m)
                                        : 0;

                                    porcentaje = Math.Min(100, porcentaje);

                                    string ancho =
                                        porcentaje.ToString(
                                            "0.##",
                                            CultureInfo.InvariantCulture);

                                    <div class="bar-row">

                                        <div class="bar-labels">
                                            <span>
                                                @sucursal.NombreSucursal
                                            </span>

                                            <strong>
                                                @sucursal.IngresosMes.ToString("C2", culturaDinero)
                                            </strong>
                                        </div>

                                        <div class="bar-track">
                                            <div class="bar-fill"
                                                 style="width:@(ancho)%;">
                                            </div>
                                        </div>

                                    </div>
                                }
                            }
                            else
                            {
                                <div class="feed-content">
                                    <span>
                                        No hay sucursales para mostrar.
                                    </span>
                                </div>
                            }

                        </div>
                    </div>

                    <!-- RESERVAS DEL MES -->
                    <div class="reservations-card">

                        <h2>Reservas del Mes</h2>

                        <div class="donut-display-area">

                            <div class="donut-chart"
                                 style="@estiloDona">

                                <div class="donut-center"></div>
                            </div>

                            <div class="donut-legend">

                                @foreach (var estado in reservasEstado)
                                {
                                    int porcentaje = totalEstados > 0
                                        ? (int)Math.Round(
                                            (decimal)Math.Max(0, estado.Cantidad)
                                            / totalEstados * 100m,
                                            0)
                                        : 0;

                                    string color = colores.TryGetValue(
                                        estado.Estado, out var colorEstado)
                                        ? colorEstado
                                        : "#d7d1cd";

                                    <div class="legend-item">

                                        <span class="legend-dot"
                                              style="background:@color;">
                                        </span>

                                        <span>
                                            @estado.Estado (@porcentaje%)
                                        </span>
                                    </div>
                                }

                            </div>
                        </div>

                        <div class="donut-divider"></div>

                        <div class="donut-footer">

                            <strong>
                                @Model.ReservasMes.ToString("N0", cultura)
                                reservas
                            </strong>

                            <span>
                                registradas este mes
                            </span>
                        </div>
                    </div>

                </section>

                <!-- ACTIVIDAD Y ESTADÍSTICAS -->
                <section class="bottom-grid">

                    <!-- ACTIVIDAD RECIENTE -->
                    <div class="activity-feed-card">

                        <h2>Actividad Reciente</h2>

                        <div class="activity-items-list">

                            @if (actividades.Count > 0)
                            {
                                foreach (var actividad in actividades)
                                {
                                    <div class="feed-item">

                                        <div class="feed-icon">
                                            <svg viewBox="0 0 24 24">
                                                <circle cx="12" cy="12" r="9"></circle>
                                                <path d="M12 8v4l2.5 1.5"></path>
                                            </svg>
                                        </div>

                                        <div class="feed-content">

                                            <strong>
                                                @actividad.Descripcion
                                            </strong>

                                            <span>
                                                @actividad.FechaEvento.ToString(
                                                    "dd/MM/yyyy HH:mm",
                                                    cultura)
                                            </span>

                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="feed-item last">

                                    <div class="feed-icon">
                                        <svg viewBox="0 0 24 24">
                                            <circle cx="12" cy="12" r="9"></circle>
                                            <path d="M12 8v4l2.5 1.5"></path>
                                        </svg>
                                    </div>

                                    <div class="feed-content">

                                        <strong>
                                            Sin actividad reciente
                                        </strong>

                                        <span>
                                            No hay movimientos registrados.
                                        </span>
                                    </div>
                                </div>
                            }

                        </div>
                    </div>

                    <!-- ESTADÍSTICAS RÁPIDAS -->
                    <div class="quick-stats-column">

                        <h2>Estadísticas Rápidas</h2>

                        <div class="stat-mini-card">

                            <div class="mini-icon-container">
                                <svg viewBox="0 0 24 24">
                                    <circle cx="12" cy="8" r="3"></circle>
                                    <path d="M5 21c0-3.5 3.1-6 7-6s7 2.5 7 6"></path>
                                </svg>
                            </div>

                            <div class="mini-meta">

                                <span>
                                    Clientes Nuevos este Mes
                                </span>

                                <strong>
                                    @Model.ClientesNuevosMes.ToString("N0", cultura)
                                </strong>
                            </div>
                        </div>

                        <div class="stat-mini-card">

                            <div class="mini-icon-container">
                                <svg viewBox="0 0 24 24">
                                    <path d="M4 16l6-6 4 4 6-7"></path>
                                    <path d="M16 7h4v4"></path>
                                </svg>
                            </div>

                            <div class="mini-meta">

                                <span>
                                    Tasa de Repetición
                                </span>

                                <strong>
                                    @Model.TasaRepeticionClientes.ToString("N1", cultura)%
                                </strong>
                            </div>
                        </div>

                        <div class="stat-mini-card">

                            <div class="mini-icon-container">
                                <svg viewBox="0 0 24 24">
                                    <circle cx="12" cy="8" r="4"></circle>
                                    <path d="m9 12-2 8 5-3 5 3-2-8"></path>
                                </svg>
                            </div>

                            <div class="mini-meta">

                                <span>
                                    Servicio más Popular
                                </span>

                                <strong>
                                    @(string.IsNullOrWhiteSpace(Model.ServicioMasPopular)
                                        ? "Sin datos"
                                        : Model.ServicioMasPopular)
                                </strong>
                            </div>
                        </div>

                        <div class="stat-mini-card">

                            <div class="mini-icon-container">
                                <svg viewBox="0 0 24 24">
                                    <path d="m3 7 3 3 6-7 6 7 3-3-2 13H5L3 7z"></path>
                                </svg>
                            </div>

                            <div class="mini-meta">

                                <span>
                                    Sucursal Top
                                </span>

                                <strong>
                                    @(string.IsNullOrWhiteSpace(Model.SucursalTop)
                                        ? "Sin datos"
                                        : Model.SucursalTop)
                                </strong>
                            </div>
                        </div>

                    </div>

                </section>

            </main>
        </div>

        <!-- FOOTER -->
        <footer class="footer">

            <div class="footer-upper">

                <div class="footer-about">

                    <div class="footer-logo">
                        L'Avielle
                    </div>

                    <p>
                        Un concepto exclusivo de salón de belleza y spa de bienestar,
                        donde el lujo se traduce en calma, elegancia y atención
                        de nivel internacional.
                    </p>

                    <div class="social-row">

                        <a href="#" class="social-button">
                            Instagram
                        </a>

                        <a href="#" class="social-button">
                            Facebook
                        </a>

                        <a href="#" class="social-button">
                            Web
                        </a>

                    </div>
                </div>

                <div class="footer-column">

                    <h3>Navegación</h3>

                    <div class="footer-links">

                        <a href="@Url.Action("Dashboard", "Admin")">
                            Inicio
                        </a>

                        <a href="@Url.Action("GestionServicios", "Admin")">
                            Servicios
                        </a>

                        <a href="@Url.Action("GestionUsuarios", "Admin")">
                            Usuarios
                        </a>

                        <a href="@Url.Action("GestionSucursales", "Admin")">
                            Sucursales
                        </a>

                        <a href="@Url.Action("ReportesGenerales", "Admin")">
                            Reportes
                        </a>

                    </div>
                </div>

                <div class="footer-column">

                    <h3>Contacto &amp; Ubicación</h3>

                    <div class="contact-list">

                        <div class="contact-item">
                            Paseo de la Reforma 402, Juárez, CDMX
                        </div>

                        <div class="contact-item">
                            +52 55 1234 5678
                        </div>

                        <div class="contact-item">
                            contacto&#64;lavielle.com
                        </div>

                    </div>
                </div>

            </div>

            <div class="footer-divider"></div>

            <div class="footer-bottom">

                <span>
                    © 2026 L'Avielle Salón de Belleza.
                    Todos los derechos reservados.
                </span>

                <div class="footer-legal">

                    <a href="#">
                        Política de Privacidad
                    </a>

                    <a href="#">
                        Términos del Servicio
                    </a>

                </div>

            </div>
        </footer>
    </div>
</body>
</html>
