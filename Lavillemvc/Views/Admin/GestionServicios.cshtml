                                </svg>
                            </span>

                            <span class="tab-text">
                                Gestión de Servicios
                            </span>

                            <span class="active-indicator"></span>

                        </a>


                        <a href="@Url.Action("ReportesGenerales", "Admin")" class="sidebar-link">

                            <span class="nav-icon">
                                <svg viewBox="0 0 24 24">
