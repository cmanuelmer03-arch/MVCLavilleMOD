                                <div class="benefits-list">

                                    <div class="benefit">
                                        <span>✓</span>
                                        <p>40% descuento en todos los servicios</p>
                                    </div>

                                    <div class="benefit">
                                        <span>✓</span>
                                        <p>Atención personalizada</p>
                                    </div>

                                    <div class="benefit">
                                        <span>✓</span>
                                        <p>2 servicios de cortesía mensuales</p>
                                    </div>

                                    <div class="benefit">
                                        <span>✓</span>
                                        <p>Productos premium incluidos</p>
                                    </div>

                                    <div class="benefit">
                                        <span>✓</span>
                                        <p>Acceso ilimitado a eventos</p>
