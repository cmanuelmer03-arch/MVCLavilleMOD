                                </div>

                            </div>

                        </div>


                        <div class="membership-card vip-card">

                            <div class="membership-top">

                                <div class="vip-title-row">

                                    <h3>
                                        Plan VIP
                                    </h3>

                                    <span class="popular-badge">
                                        POPULAR
