            // =========================================
            // VER MIEMBROS DE UNA MEMBRESÍA
            // =========================================

            function fechaLegible(valor) {

                if (!valor) {
                    return 'No registrada';
                }

                const fecha = new Date(valor);

                if (Number.isNaN(fecha.getTime())) {
                    return 'No registrada';
                }

                return fecha.toLocaleDateString('es-SV', {
                    day: '2-digit',
                    month: '2-digit',
                    year: 'numeric'
                });
            }

            function verMiembros(membresia) {

                const id = Number(
                    obtener(membresia, 'IdMembresia', 0)
                );

                const nombre = obtener(
                    membresia, 'Nombre', ''
                );

                document.getElementById('tituloModalMiembros')
                    .textContent = 'Miembros de ' + nombre;

                const contenedor =
                    document.getElementById('contenidoMiembros');

                contenedor.replaceChildren();

                const asociados = miembros.filter(
                    function(miembro) {

                        return Number(
                            obtener(miembro, 'IdMembresia', 0)
                        ) === id;
                    }
                );

                if (asociados.length === 0) {

                    contenedor.appendChild(
                        elemento(
                            'p',
                            'lv-modal-description',
                            'No hay clientes asociados a esta membresía.'
                        )
                    );

                    abrirModal('modalMiembros');

                    return;
                }

                const cantidadVigentes =
                    asociados.filter(function(miembro) {

                        return obtener(
                            miembro, 'EsVigente', false
                        ) === true;
                    }).length;

                contenedor.appendChild(
                    elemento(
                        'p',
                        'lv-modal-description',
                        'Clientes asociados: ' +
                        asociados.length +
                        ' | Membresías vigentes: ' +
                        cantidadVigentes
                    )
                );

                asociados.forEach(function(miembro) {

                    const nombreCliente = obtener(
                        miembro,
                        'NombreCompleto',
                        'Cliente'
                    );

                    const vigente = obtener(
                        miembro,
                        'EsVigente',
                        false
                    ) === true;

                    const estado = obtener(
                        miembro,
                        'EstadoMembresia',
                        'Sin estado'
                    );

                    const inicio = obtener(
                        miembro,
                        'FechaInicio',
                        null
                    );

                    const fin = obtener(
                        miembro,
                        'FechaFin',
                        null
                    );

                    const fila = elemento(
                        'div',
                        'lv-member-entry'
                    );

                    fila.appendChild(
                        elemento(
                            'strong',
                            '',
                            nombreCliente
                        )
                    );

                    fila.appendChild(
                        elemento(
                            'span',
                            vigente
                                ? 'lv-member-active'
                                : 'lv-member-inactive',
                            vigente
                                ? 'Membresía vigente'
                                : 'Membresía no vigente'
                        )
                    );

                    fila.appendChild(
                        elemento(
                            'span',
                            '',
                            'Estado registrado: ' + estado
                        )
                    );

                    fila.appendChild(
                        elemento(
                            'span',
                            '',
                            'Inicio: ' + fechaLegible(inicio)
                        )
                    );

                    fila.appendChild(
                        elemento(
                            'span',
                            '',
                            'Vencimiento: ' + fechaLegible(fin)
                        )
                    );

                    contenedor.appendChild(fila);
                });

                abrirModal('modalMiembros');
            }

            // =========================================
            // CONFIRMACIONES GENERALES
            // =========================================

            function prepararConfirmacion(
                accion,
                titulo,
                mensaje,
                parametros,
                textoBoton,
                esEliminacion
            ) {

                formConfirmar.action = accion;

                document.getElementById('tituloConfirmar')
                    .textContent = titulo;

                document.getElementById('textoConfirmar')
                    .textContent = mensaje;

                const campos =
                    document.getElementById('camposConfirmar');

                campos.replaceChildren();

                Object.entries(parametros).forEach(
                    function(entrada) {

                        const campo = document.createElement('input');

                        campo.type = 'hidden';

                        campo.name = entrada[0];

                        campo.value = String(entrada[1]);

                        campos.appendChild(campo);
                    }
                );

                const boton =
                    document.getElementById('botonConfirmar');

                boton.textContent = textoBoton;

                boton.className = esEliminacion
                    ? 'lv-btn-danger'
                    : 'lv-btn-save';

                abrirModal('modalConfirmar');
            }

            // =========================================
            // ACTIVAR / DESACTIVAR SERVICIO
            // =========================================

            function confirmarEstadoServicio(servicio) {

                recordarPestaña('servicios');

                const id = obtener(
                    servicio, 'IdServicio', 0
                );

                const nombre = obtener(
                    servicio, 'Nombre', ''
                );

                const disponible = obtener(
                    servicio, 'Disponible', false
                ) === true;

                const activar = !disponible;

                prepararConfirmacion(

                    rutas.estadoServicio,

                    activar
                        ? 'Activar Servicio'
                        : 'Desactivar Servicio',

                    activar
                        ? '¿Deseas activar el servicio "' +
                        nombre + '"?'
                        : '¿Deseas desactivar el servicio "' +
                        nombre +
                        '"? Se conservarán las reservas y registros históricos.',

                    {
                        idServicio: id,
                        activar: activar
                    },

                    activar
                        ? 'Sí, activar'
                        : 'Sí, desactivar',

                    false
                );
            }

            // =========================================
            // ELIMINAR SERVICIO
            // =========================================

            function confirmarEliminarServicio(servicio) {

                recordarPestaña('servicios');

                const id = obtener(
                    servicio, 'IdServicio', 0
                );

                const nombre = obtener(
                    servicio, 'Nombre', ''
                );

                prepararConfirmacion(

                    rutas.eliminarServicio,

                    'Eliminar Servicio',

                    '¿Seguro que deseas eliminar "' +
                    nombre +
                    '"? Esta acción es permanente. Si tiene citas, promociones u otros registros relacionados, no podrá eliminarse. En ese caso puedes desactivarlo.',

                    {
                        idServicio: id
                    },

                    'Sí, eliminar servicio',

                    true
                );
            }

            // =========================================
            // ACTIVAR / DESACTIVAR MEMBRESÍA
            // =========================================

            function confirmarEstadoMembresia(membresia) {

                recordarPestaña('membresias');

                const id = obtener(
                    membresia, 'IdMembresia', 0
                );

                const nombre = obtener(
                    membresia, 'Nombre', ''
                );

                const activo = obtener(
                    membresia, 'Activo', false
                ) === true;

                const activar = !activo;

                prepararConfirmacion(

                    rutas.estadoMembresia,

                    activar
                        ? 'Activar Membresía'
                        : 'Desactivar Membresía',

                    activar
                        ? '¿Deseas activar el plan "' +
                        nombre + '"?'
                        : '¿Deseas desactivar "' +
                        nombre +
                        '"? Los clientes que ya tienen esta membresía conservarán sus registros e historial.',

                    {
                        idMembresia: id,
                        activar: activar
                    },

                    activar
                        ? 'Sí, activar'
                        : 'Sí, desactivar',

                    false
                );
            }

            // =========================================
            // ELIMINAR MEMBRESÍA
            // =========================================

            function confirmarEliminarMembresia(membresia) {

                recordarPestaña('membresias');

                const id = obtener(
                    membresia, 'IdMembresia', 0
                );

                const nombre = obtener(
                    membresia, 'Nombre', ''
                );

                prepararConfirmacion(

                    rutas.eliminarMembresia,

                    'Eliminar Membresía',

                    '¿Seguro que deseas eliminar el plan "' +
                    nombre +
                    '"? La eliminación es permanente y solo será permitida si no tiene clientes ni registros relacionados. Puedes desactivarlo para conservar su historial.',

                    {
                        idMembresia: id
                    },

                    'Sí, eliminar membresía',

                    true
                );
            }

            // =========================================
            // CONSERVAR LA PESTAÑA AL GUARDAR
            // =========================================

            formServicio.addEventListener(
                'submit',
                function() {
                    recordarPestaña('servicios');
                }
            );

            formMembresia.addEventListener(
                'submit',
                function() {
                    recordarPestaña('membresias');
                }
            );

            // =========================================
            // INICIAR PANTALLA
            // =========================================

            cargarDatos();

    </script>

</body>

</html>
