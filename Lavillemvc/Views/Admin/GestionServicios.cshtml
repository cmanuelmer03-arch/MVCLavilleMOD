                                    <div class="benefit">
                                        <span>✓</span>
                                        <p>Acceso a eventos exclusivos</p>
                                    </div>

                                </div>

                            </div>


                            <div class="membership-divider"></div>


                            <div class="membership-bottom">

                                <div class="members-count">

