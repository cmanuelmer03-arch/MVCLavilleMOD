    <script>

            // =========================================
            // CONEXIÓN CON ADMINREPORTESCONTROLLER
            // =========================================

            const rutaReportes =
                '@Url.Action("Datos", "AdminReportes")';

            // =========================================
            // FECHAS
            // =========================================

            const hoy = new Date();

            let periodoActual = new Date(
                hoy.getFullYear(),
                hoy.getMonth(),
                1
            );

            const ultimoPeriodo = new Date(
                hoy.getFullYear(),
                hoy.getMonth(),
                1
            );

            const anterior = document.getElementById(
                'mesAnterior'
            );

            const siguiente = document.getElementById(
                'mesSiguiente'
            );

            const tituloMes = document.getElementById(
                'mesSeleccionado'
            );

            let numeroPeticion = 0;

            function leer(objeto, propiedad, defecto) {

                if (!objeto) {
                    return defecto;
                }

                const nombreCamel =
                    propiedad.charAt(0).toLowerCase()
                    + propiedad.slice(1);

                if (objeto[nombreCamel] !== undefined) {
                    return objeto[nombreCamel];
                }

                if (objeto[propiedad] !== undefined) {
                    return objeto[propiedad];
                }

                return defecto;
            }

            function numero(valor) {

                const resultado = Number(valor);

                return Number.isFinite(resultado)
                    ? resultado
                    : 0;
            }

            function entero(valor) {

                return new Intl.NumberFormat('es-SV')
                    .format(numero(valor));
            }

            function dinero(valor) {

                return new Intl.NumberFormat('en-US', {
                    style: 'currency',
                    currency: 'USD'
                }).format(numero(valor));
            }

            function dineroCorto(valor) {

                const n = numero(valor);

                if (n === 0) {
                    return '$0';
                }

                if (Math.abs(n) >= 1000000) {
                    return '$' +
                        (n / 1000000).toFixed(1) + 'M';
                }

                if (Math.abs(n) >= 1000) {
                    return '$' +
                        (n / 1000).toFixed(1) + 'K';
                }

                return '$' + n.toFixed(0);
            }

            function elemento(tipo, clase, contenido) {

                const nodo = document.createElement(tipo);

                if (clase) {
                    nodo.className = clase;
                }

                if (contenido !== undefined) {
                    nodo.textContent = String(contenido);
                }

                return nodo;
            }

            function actualizarMes() {

                const texto = periodoActual.toLocaleDateString(
                    'es-SV',
                    {
                        month: 'long',
                        year: 'numeric'
                    }
                );

                tituloMes.textContent =
                    texto.charAt(0).toUpperCase()
                    + texto.slice(1);

                const esUltimo =
                    periodoActual.getFullYear() ===
                    ultimoPeriodo.getFullYear()
                    &&
                    periodoActual.getMonth() ===
                    ultimoPeriodo.getMonth();

                siguiente.classList.toggle(
                    'disabled',
                    esUltimo
                );

                siguiente.setAttribute(
                    'aria-disabled',
                    esUltimo ? 'true' : 'false'
                );
            }

            async function cambiarMes(diferencia) {

                const nuevo = new Date(
                    periodoActual.getFullYear(),
                    periodoActual.getMonth() + diferencia,
                    1
                );

                if (nuevo > ultimoPeriodo) {
                    return;
                }

                periodoActual = nuevo;

                await cargarReporte();
            }

            anterior.addEventListener(
                'click',
                function() {
                    cambiarMes(-1);
                }
            );

            siguiente.addEventListener(
                'click',
                function() {
                    cambiarMes(1);
                }
            );

            [anterior, siguiente].forEach(function(control) {

                control.addEventListener('keydown', function(e) {

                    if (e.key === 'Enter' || e.key === ' ') {

                        e.preventDefault();
                        control.click();
                    }
                });
            });

            // =========================================
            // MENSAJES
            // =========================================

            function aviso(texto, error) {

                const contenedor =
                    document.getElementById('avisoReporte');

                contenedor.hidden = !texto;

                contenedor.textContent = texto || '';

                contenedor.className = error
                    ? 'report-notice error'
                    : 'report-notice';
            }

            // =========================================
            // VARIACIONES RESPECTO AL MES ANTERIOR
            // =========================================

            function tendencia(actual, anterior, id) {

                const nodo = document.getElementById(id);

                const previo = numero(anterior);
                const valor = numero(actual);

                if (previo === 0) {

                    nodo.textContent = 'Sin comparativo';
                    nodo.className = 'trend neutral';

                    return;
                }

                const cambio =
                    (valor - previo) / previo * 100;

                const texto =
                    (cambio > 0 ? '+' : '') +
                    cambio.toFixed(1) + '%';

                nodo.textContent = texto;

                nodo.className =
                    'trend ' +
                    (
                        cambio > 0
                            ? 'positive'
                            : cambio < 0
                                ? 'negative'
                                : 'neutral'
                    );
            }

            // =========================================
            // INDICADORES GENERALES
            // =========================================

            function renderizarIndicadores(datos) {

                const reservas = leer(
                    datos, 'Reservas', 0
                );

                const ingresos = leer(
                    datos, 'Ingresos', 0
                );

                const clientes = leer(
                    datos, 'ClientesConReservas', 0
                );

                const ocupacion = leer(
                    datos, 'TasaOcupacion', null
                );

                const ticket = leer(
                    datos, 'TicketPromedio', 0
                );

                document.getElementById('totalReservas')
                    .textContent = entero(reservas);

                document.getElementById('totalIngresos')
                    .textContent = dinero(ingresos);

                document.getElementById('totalClientes')
                    .textContent = entero(clientes);

                document.getElementById('ticketPromedio')
                    .textContent = dinero(ticket);

                document.getElementById('tasaOcupacion')
                    .textContent =
                    ocupacion === null
                        ? 'N/D'
                        : numero(ocupacion).toFixed(1) + '%';

                document.getElementById('reservasDonut')
                    .textContent = entero(reservas);

                tendencia(
                    reservas,
                    leer(datos, 'ReservasMesAnterior', 0),
                    'variacionReservas'
                );

                tendencia(
                    ingresos,
                    leer(datos, 'IngresosMesAnterior', 0),
                    'variacionIngresos'
                );

                tendencia(
                    clientes,
                    leer(datos, 'ClientesMesAnterior', 0),
                    'variacionClientes'
                );
            }

            // =========================================
            // GRÁFICO DE INGRESOS MENSUALES
            // =========================================

            function renderizarIngresos(datos) {

                const meses = leer(
                    datos, 'IngresosMensuales', []
                ) || [];

                const grafico = document.getElementById(
                    'graficoIngresos'
                );

                const ejeY = document.getElementById(
                    'ejeIngresos'
                );

                const ejeX = document.getElementById(
                    'mesesIngresos'
                );

                grafico.replaceChildren();
                ejeY.replaceChildren();
                ejeX.replaceChildren();

                if (meses.length === 0) {
                    return;
                }

                const valores = meses.map(function(mes) {

                    return numero(
                        leer(mes, 'Ingresos', 0)
                    );
                });

                const maximo = Math.max(
                    0,
                    ...valores
                );

                // Seis marcas de escala desde el valor
                // máximo hasta cero.

                for (let i = 0; i < 6; i++) {

                    const marca = maximo === 0
                        ? 0
                        : maximo * (5 - i) / 5;

                    ejeY.appendChild(
                        elemento(
                            'span',
                            '',
                            dineroCorto(marca)
                        )
                    );
                }

                const ancho = 450;
                const alto = 140;
                const margenSuperior = 12;
                const margenInferior = 118;

                const puntos = valores.map(
                    function(valor, indice) {

                        const x = valores.length === 1
                            ? ancho / 2
                            : indice * ancho /
                            (valores.length - 1);

                        const proporcion = maximo > 0
                            ? valor / maximo
                            : 0;

                        const y = margenInferior
                            - proporcion *
                            (margenInferior - margenSuperior);

                        return {
                            x: x,
                            y: y,
                            valor: valor
                        };
                    }
                );

                const namespace =
                    'http://www.w3.org/2000/svg';

                const linea = document.createElementNS(
                    namespace,
                    'polyline'
                );

                linea.setAttribute(
                    'points',
                    puntos.map(function(p) {

                        return p.x + ',' + p.y;
                    }).join(' ')
                );

                grafico.appendChild(linea);

                puntos.forEach(function(p) {

                    const circulo = document.createElementNS(
                        namespace,
                        'circle'
                    );

                    circulo.setAttribute('cx', p.x);
                    circulo.setAttribute('cy', p.y);
                    circulo.setAttribute('r', '4');

                    const titulo = document.createElementNS(
                        namespace,
                        'title'
                    );

                    titulo.textContent = dinero(p.valor);

                    circulo.appendChild(titulo);

                    grafico.appendChild(circulo);
                });

                meses.forEach(function(mes) {

                    ejeX.appendChild(
                        elemento(
                            'span',
                            '',
                            leer(mes, 'Etiqueta', '')
                        )
                    );
                });
            }

            // =========================================
            // SERVICIOS MÁS SOLICITADOS
            // =========================================

            function renderizarServicios(datos) {

                const contenedor = document.getElementById(
                    'serviciosPopulares'
                );

                const servicios = leer(
                    datos, 'ServiciosPopulares', []
                ) || [];

                contenedor.replaceChildren();

                if (servicios.length === 0) {

                    contenedor.appendChild(
                        elemento(
                            'p',
                            'report-empty',
                            'Sin servicios reservados durante este mes.'
                        )
                    );

                    return;
                }

                const maximo = Math.max(
                    1,
                    ...servicios.map(function(s) {

                        return numero(
                            leer(s, 'Reservas', 0)
                        );
                    })
                );

                servicios.forEach(function(servicio) {

                    const nombre = leer(
                        servicio, 'Nombre', ''
                    );

                    const cantidad = numero(
                        leer(servicio, 'Reservas', 0)
                    );

                    const porcentaje =
                        cantidad / maximo * 100;

                    const fila = elemento(
                        'div',
                        'popularity-row'
                    );

                    fila.appendChild(
                        elemento('span', '', nombre)
                    );

                    const pista = elemento(
                        'div',
                        'popularity-track'
                    );

                    const barra = elemento('div');

                    barra.style.width =
                        porcentaje.toFixed(1) + '%';

                    pista.appendChild(barra);

                    fila.appendChild(pista);

                    fila.appendChild(
                        elemento(
                            'strong',
                            '',
                            entero(cantidad)
                        )
                    );

                    contenedor.appendChild(fila);
                });
            }

            // =========================================
            // RENDIMIENTO POR SUCURSAL
            // =========================================

            function renderizarSucursales(datos) {

                const contenedor = document.getElementById(
                    'tablaSucursales'
                );

                const sucursales = leer(
                    datos, 'Sucursales', []
                ) || [];

                // Conservamos el encabezado original.

                contenedor.querySelectorAll(
                    '.performance-row:not(.performance-header)'
                ).forEach(function(fila) {
                    fila.remove();
                });

                if (sucursales.length === 0) {
                    return;
                }

                sucursales.forEach(function(sucursal, indice) {

                    const fila = elemento(
                        'div',
                        indice % 2 === 0
                            ? 'performance-row'
                            : 'performance-row highlighted'
                    );

                    const nombre = leer(
                        sucursal, 'Nombre', ''
                    );

                    const reservas = numero(
                        leer(sucursal, 'Reservas', 0)
                    );

                    const ingresos = numero(
                        leer(sucursal, 'Ingresos', 0)
                    );

                    const ocupacion = leer(
                        sucursal, 'Ocupacion', null
                    );

                    const valoracion = leer(
                        sucursal, 'Valoracion', null
                    );

                    const top = leer(
                        sucursal,
                        'ServicioTop',
                        'Sin reservas'
                    );

                    const variacion = leer(
                        sucursal,
                        'TendenciaReservas',
                        null
                    );

                    fila.appendChild(
                        elemento(
                            'div',
                            'branch-name',
                            nombre
                        )
                    );

                    fila.appendChild(
                        elemento(
                            'div',
                            '',
                            entero(reservas)
                        )
                    );

                    fila.appendChild(
                        elemento(
                            'div',
                            'income',
                            dinero(ingresos)
                        )
                    );

                    fila.appendChild(
                        elemento(
                            'div',
                            ocupacion === null
                                ? 'no-data'
                                : '',
                            ocupacion === null
                                ? 'N/D'
                                : numero(ocupacion).toFixed(1) + '%'
                        )
                    );

                    fila.appendChild(
                        elemento(
                            'div',
                            '',
                            top
                        )
                    );

                    fila.appendChild(
                        elemento(
                            'div',
                            valoracion === null
                                ? 'no-data'
                                : '',
                            valoracion === null
                                ? 'N/D'
                                : '☆ ' +
                                numero(valoracion).toFixed(1)
                        )
                    );

                    let claseTendencia =
                        'growth neutral-growth';

                    let textoTendencia =
                        'Sin comparativo';

                    if (variacion !== null) {

                        const valor = numero(variacion);

                        if (valor > 0) {
                            claseTendencia = 'growth';
                        }
                        else if (valor < 0) {
                            claseTendencia = 'growth negative';
                        }

                        textoTendencia =
                            (valor > 0 ? '↑ +' :
                                valor < 0 ? '↓ ' : '→ ') +
                            valor.toFixed(1) + '%';
                    }

                    fila.appendChild(
                        elemento(
                            'div',
                            claseTendencia,
                            textoTendencia
                        )
                    );

                    contenedor.appendChild(fila);
                });
            }

            // =========================================
            // ACTIVIDAD DEL SISTEMA
            // =========================================

            function renderizarActividad(datos) {

                const contenedor = document.getElementById(
                    'actividadSistema'
                );

                const actividades = leer(
                    datos, 'Actividad', []
                ) || [];

                contenedor.replaceChildren();

                if (actividades.length === 0) {

                    contenedor.appendChild(
                        elemento(
                            'p',
                            'report-empty',
                            'Sin citas ni registros de clientes en este período.'
                        )
                    );

                    return;
                }

                actividades.forEach(function(actividad) {

                    const textoFecha = leer(
                        actividad, 'Fecha', null
                    );

                    const citas = numero(
                        leer(actividad, 'CitasProgramadas', 0)
                    );

                    const registros = numero(
                        leer(actividad, 'ClientesRegistrados', 0)
                    );

                    const fecha = textoFecha
                        ? new Date(textoFecha)
                        : null;

                    const dia =
                        fecha &&
                            !Number.isNaN(fecha.getTime())
                            ? fecha.toLocaleDateString(
                                'es-SV',
                                {
                                    day: '2-digit',
                                    month: 'short'
                                })
                            : 'Sin fecha';

                    const fila = elemento(
                        'div',
                        'timeline-row'
                    );

                    fila.appendChild(
                        elemento(
                            'span',
                            'date-tag',
                            dia
                        )
                    );

                    fila.appendChild(
                        elemento(
                            'span',
                            '',
                            entero(citas) +
                            ' citas programadas, ' +
                            entero(registros) +
                            ' clientes registrados'
                        )
                    );

                    contenedor.appendChild(fila);
                });
            }

            // =========================================
            // DISTRIBUCIÓN DE RESERVAS
            // =========================================

            function renderizarEstados(datos) {

                const registros = leer(
                    datos, 'EstadosReservas', []
                ) || [];

                const leyenda = document.getElementById(
                    'leyendaReservas'
                );

                const grafico = document.getElementById(
                    'graficoReservas'
                );

                leyenda.replaceChildren();

                const categorias = [
                    {
                        nombre: 'Completadas',
                        color: '#9d7964',
                        clase: 'completed'
                    },
                    {
                        nombre: 'Confirmadas',
                        color: '#c9a488',
                        clase: 'confirmed'
                    },
                    {
                        nombre: 'Canceladas',
                        color: '#b76562',
                        clase: 'cancelled'
                    },
                    {
                        nombre: 'Pendientes',
                        color: '#e2c38f',
                        clase: 'pending'
                    },
                    {
                        nombre: 'No asistieron',
                        color: '#8c8b93',
                        clase: 'no-show'
                    },
                    {
                        nombre: 'Otros',
                        color: '#d7d0c8',
                        clase: ''
                    }
                ];

                const valores = categorias.map(function(categoria) {

                    const encontrado = registros.find(
                        function(registro) {

                            return leer(
                                registro, 'Estado', ''
                            ) === categoria.nombre;
                        }
                    );

                    return encontrado
                        ? numero(leer(encontrado, 'Cantidad', 0))
                        : 0;
                });

                const total = valores.reduce(
                    function(a, b) {
                        return a + b;
                    },
                    0
                );

                if (total === 0) {

                    grafico.style.setProperty(
                        'background',
                        '#e7dfd6',
                        'important'
                    );

                    leyenda.appendChild(
                        elemento(
                            'p',
                            'report-empty',
                            'Sin reservas en este mes.'
                        )
                    );

                    return;
                }

                let porcentajeAcumulado = 0;

                const sectores = [];

                categorias.forEach(function(categoria, indice) {

                    const cantidad = valores[indice];

                    if (cantidad === 0) {
                        return;
                    }

                    const porcentaje =
                        cantidad / total * 100;

                    const desde = porcentajeAcumulado;

                    porcentajeAcumulado += porcentaje;

                    sectores.push(
                        categoria.color + ' ' +
                        desde.toFixed(3) + '% ' +
                        porcentajeAcumulado.toFixed(3) + '%'
                    );

                    const fila = elemento('div');

                    const punto = elemento(
                        'span',
                        'legend-dot ' + categoria.clase
                    );

                    punto.style.backgroundColor =
                        categoria.color;

                    fila.appendChild(punto);

                    fila.appendChild(
                        elemento(
                            'span',
                            '',
                            categoria.nombre +
                            ': ' +
                            entero(cantidad) +
                            ' (' +
                            porcentaje.toFixed(1) +
                            '%)'
                        )
                    );

                    leyenda.appendChild(fila);
                });

                grafico.style.setProperty(
                    'background',
                    'conic-gradient(' +
                    sectores.join(', ') +
                    ')',
                    'important'
                );
            }

            // =========================================
            // CONSULTA PRINCIPAL A SUPABASE
            // =========================================

            async function cargarReporte() {

                actualizarMes();

                const peticionActual = ++numeroPeticion;

                aviso('Cargando reporte desde Supabase...', false);

                const anio = periodoActual.getFullYear();

                const mes = periodoActual.getMonth() + 1;

                const url =
                    rutaReportes +
                    '?anio=' + encodeURIComponent(anio) +
                    '&mes=' + encodeURIComponent(mes);

                try {

                    const respuesta = await fetch(
                        url,
                        {
                            method: 'GET',
                            headers: {
                                'Accept': 'application/json'
                            },
                            cache: 'no-store'
                        }
                    );

                    if (!respuesta.ok) {

                        let mensaje =
                            'No se pudo consultar el reporte.';

                        try {

                            const detalle = await respuesta.json();

                            mensaje = leer(
                                detalle,
                                'mensaje',
                                mensaje
                            );
                        }
                        catch (error) {
                            // Se conserva el mensaje general.
                        }

                        throw new Error(mensaje);
                    }

                    const datos = await respuesta.json();

                    // Evita que una petición anterior
                    // reemplace un mes seleccionado después.

                    if (peticionActual !== numeroPeticion) {
                        return;
                    }

                    renderizarIndicadores(datos);

                    renderizarIngresos(datos);

                    renderizarServicios(datos);

                    renderizarSucursales(datos);

                    renderizarActividad(datos);

                    renderizarEstados(datos);

                    aviso('', false);

                }
                catch (error) {

                    if (peticionActual !== numeroPeticion) {
                        return;
                    }

                    aviso(
                        'Error al cargar el reporte: ' +
                        error.message,
                        true
                    );
                }
            }

            // =========================================
            // INICIAR
            // =========================================

            cargarReporte();

    </script>

</body>

</html>
