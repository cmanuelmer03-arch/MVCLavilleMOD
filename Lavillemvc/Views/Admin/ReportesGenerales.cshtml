@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Reportes Generales - L'Avielle</title>

    <link href="~/css/reportesgenerales.css"
          rel="stylesheet" />

    <style>
            /* Complementos funcionales del diseño original */

            .date-range-selector .arrow-left,
            .date-range-selector .arrow-right {
                cursor: pointer;
                user-select: none;
            }

                .date-range-selector .arrow-right.disabled {
                    opacity: .3;
                    cursor: not-allowed;
                }

            .report-notice {
                margin: 12px 0 22px;
                background: #f5eee8;
                color: #705248;
                border-radius: 10px;
                padding: 12px 16px;
                font-size: 14px;
            }

                .report-notice.error {
                    background: #fff0eb;
                    color: #a4493d;
                }

            .report-empty {
                padding: 20px 10px;
                color: #90796d;
                font-size: 14px;
                text-align: center;
            }

            .trend.neutral {
                color: #897970;
            }

            .revenue-chart {
                min-height: 190px;
            }

                .revenue-chart .chart-area {
                    min-width: 0;
                }

                .revenue-chart .revenue-line {
                    width: 100%;
                    height: 140px;
                    overflow: visible;
                }

            .revenue-line polyline {
                fill: none;
                stroke: #ad836d;
                stroke-width: 3;
                stroke-linejoin: round;
                stroke-linecap: round;
            }

            .revenue-line circle {
                fill: #ad836d;
                stroke: white;
                stroke-width: 1.5;
            }

            .revenue-chart .x-axis {
                display: flex;
                justify-content: space-between;
            }

            .popularity-track {
                overflow: hidden;
            }

                .popularity-track div {
                    height: 100%;
                    background: #b99077;
                    border-radius: inherit;
                }

            .performance-table {
                overflow-x: auto;
            }

            .performance-row {
                min-width: 780px;
            }

                .performance-row .no-data {
                    color: #97867d;
                }

            .growth.negative {
                color: #b25a4c;
            }

            .growth.neutral-growth {
                color: #918178;
            }

            .donut-chart {
                background: #e9dfd6;
            }

            .donut-legend .legend-dot {
                display: inline-block;
                width: 10px;
                height: 10px;
                border-radius: 50%;
                flex-shrink: 0;
            }

            .donut-legend > div {
                display: flex;
                align-items: center;
                gap: 9px;
            }

                .donut-legend > div span:last-child {
                    overflow-wrap: anywhere;
                }

            .date-range-selector [role="button"]:focus-visible {
                outline: 2px solid #96725e;
                outline-offset: 4px;
            }

            .report-footnote {
                color: #938077;
                font-size: 12px;
                line-height: 1.6;
                margin-top: 12px;
            }
    </style>

</head>

