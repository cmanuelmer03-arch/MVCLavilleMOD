
@model Lavillemvc.Models.InventarioPanelInventario
@using System
@{
    Layout = null;
    ViewData["Title"] = "Panel de Inventario";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Panel de Inventario - L'Avielle</title>
    <style>
        :root {
            --bg: #faf6f1;
            --surface: #ffffff;
            --ink: #302825;
            --muted: #9a8174;
            --brown: #62463a;
            --brown-dark: #1b1919;
            --gold: #cba45b;
            --border: #eaded4;
            --pink: #e8c7c8;
            --green: #2f7d52;
            --red: #bb4545;
        }

        * {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            min-height: 100%;
        }

        body {
            background: var(--bg);
            color: var(--ink);
            font-family: Arial, Helvetica, sans-serif;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        .layout {
            min-height: 100vh;
        }

        .sidebar {
            position: fixed;
            inset: 0 auto 0 0;
            width: 250px;
            padding: 32px 22px;
            background: var(--brown-dark);
            color: #d4cdca;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            z-index: 10;
        }

        .brand {
            margin: 0 0 6px;
            color: var(--gold);
            font: 38px/1.1 Georgia, 'Times New Roman', serif;
        }

        .role {
            display: inline-block;
            background: #302825;
            border-radius: 6px;
            color: var(--pink);
            padding: 7px 9px;
            font-size: 12px;
        }

        .nav {
            display: grid;
            gap: 9px;
            margin-top: 44px;
        }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 13px 12px;
            border-radius: 8px;
            color: #d4cdca;
            font-size: 14px;
        }

        .nav-link:hover,
        .nav-link.active {
            background: #3b3028;
            color: var(--gold);
        }

        .nav-symbol {
            width: 22px;
            text-align: center;
            font-size: 18px;
        }

        .sidebar-bottom {
            border-top: 1px solid #39312d;
            padding-top: 20px;
        }

        .main {
            margin-left: 250px;
            padding: 38px 42px 30px;
            max-width: 1900px;
        }

        .page-head {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 20px;
            margin-bottom: 28px;
        }

        h1 {
            margin: 0 0 9px;
            color: #563b32;
            font: 42px/1.1 Georgia, 'Times New Roman', serif;
            font-weight: 400;
        }

        .subtitle {
            color: var(--muted);
            font-size: 14px;
            line-height: 1.6;
        }

        .profile {
            display: flex;
            align-items: center;
            gap: 12px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 12px;
            padding: 10px 14px;
        }

        .avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #ead8c8;
            color: var(--brown);
            display: grid;
            place-items: center;
            font-weight: 700;
        }

        .profile strong {
            display: block;
            font-size: 13px;
        }

        .profile span {
            display: block;
            margin-top: 4px;
            color: var(--muted);
            font-size: 12px;
        }

        .kpis {
            display: grid;
            grid-template-columns: repeat(5, minmax(0, 1fr));
            gap: 16px;
            margin-bottom: 24px;
        }

        .card {
            min-width: 0;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 15px;
            box-shadow: 0 3px 12px rgba(68, 47, 36, .035);
        }

        .kpi {
            padding: 21px 20px;
        }

        .kpi-label {
            color: var(--muted);
            font-size: 12px;
            font-weight: 700;
            letter-spacing: .045em;
            text-transform: uppercase;
        }

        .kpi-number {
            margin-top: 16px;
            color: #1c1a1a;
            font: 32px/1 Georgia, 'Times New Roman', serif;
            overflow-wrap: anywhere;
        }

        .kpi-note {
            margin-top: 11px;
            color: var(--muted);
            font-size: 12px;
        }

        .content-grid {
            display: grid;
            grid-template-columns: minmax(0, 1.2fr) minmax(330px, .8fr);
            gap: 20px;
            margin-bottom: 22px;
        }

        .section-card {
            padding: 23px;
        }

        .section-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            margin-bottom: 16px;
        }

        h2 {
            margin: 0;
            color: #563b32;
            font: 25px/1.2 Georgia, 'Times New Roman', serif;
            font-weight: 400;
        }

        .section-meta {
            color: var(--muted);
            font-size: 12px;
        }

        .movement {
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto;
            gap: 6px 15px;
            padding: 15px 0;
            border-bottom: 1px solid #f0e8e1;
        }

        .movement:last-child {
            border-bottom: 0;
            padding-bottom: 0;
        }

        .movement-name {
            font-size: 14px;
            font-weight: 700;
        }

        .movement-sub {
            margin-top: 5px;
            color: var(--muted);
            font-size: 12px;
            line-height: 1.5;
        }

        .movement-qty {
            align-self: center;
            font-size: 14px;
            font-weight: 700;
            white-space: nowrap;
        }

        .pill {
            display: inline-block;
            margin-left: 7px;
            padding: 5px 8px;
            border-radius: 20px;
            background: #e8f3eb;
            color: var(--green);
            font-size: 11px;
            font-weight: 700;
        }

        .pill.out {
            background: #fbebeb;
            color: var(--red);
        }

        .alert-row {
            display: grid;
            grid-template-columns: minmax(0, 1fr) auto;
            align-items: center;
            gap: 12px;
            padding: 14px 0;
            border-bottom: 1px solid #f0e8e1;
        }

        .alert-row:last-child {
            border-bottom: 0;
            padding-bottom: 0;
        }

        .alert-name {
            font-size: 14px;
            font-weight: 700;
        }

        .alert-detail {
            margin-top: 5px;
            color: var(--muted);
            font-size: 12px;
        }

        .status {
            border-radius: 20px;
            padding: 6px 9px;
            font-size: 11px;
            font-weight: 700;
            white-space: nowrap;
            background: #fff2d9;
            color: #956b1d;
        }

        .status.critical {
            background: #fbebeb;
            color: var(--red);
        }

        .categories {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 14px;
            margin-top: 17px;
        }

        .category {
            padding: 18px;
            background: #fffdfa;
            border: 1px solid var(--border);
            border-radius: 12px;
        }

        .category-name {
            font-weight: 700;
            font-size: 14px;
        }

        .category-count {
            margin-top: 13px;
            color: #563b32;
            font: 27px/1 Georgia, 'Times New Roman', serif;
        }

        .category-meta {
            margin-top: 7px;
            color: var(--muted);
            font-size: 12px;
        }

        .empty {
            padding: 19px 0;
            color: var(--muted);
            font-size: 13px;
        }

        .footer {
            margin-top: 24px;
            border-top: 1px solid var(--border);
            padding-top: 18px;
            color: var(--muted);
            font-size: 12px;
        }

        @@media (max-width: 1300px) {
            .main {
                padding: 32px 25px;
            }

            .kpis {
                grid-template-columns: repeat(3, minmax(0, 1fr));
            }

            .categories {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media (max-width: 950px) {
            .sidebar {
                width: 215px;
                padding: 25px 15px;
            }

            .main {
                margin-left: 215px;
            }

            .content-grid {
                grid-template-columns: 1fr;
            }

            .page-head {
                flex-direction: column;
            }
        }

        @@media (max-width: 650px) {
            .sidebar {
                position: static;
                width: 100%;
                min-height: auto;
                gap: 24px;
            }

            .nav {
                grid-template-columns: 1fr 1fr;
                margin-top: 22px;
            }

            .main {
                margin-left: 0;
                padding: 24px 15px;
            }

            h1 {
                font-size: 34px;
            }

            .kpis {
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 10px;
            }

            .kpi {
                padding: 16px;
            }

            .kpi-number {
                font-size: 27px;
            }

            .categories {
                grid-template-columns: 1fr 1fr;
                gap: 10px;
            }

            .section-card {
                padding: 17px;
            }

            h2 {
                font-size: 22px;
            }
        }
    </style>
</head>

<body>
    <div class="layout">
        <aside class="sidebar">
            <div>
                <div class="brand">L'Avielle</div>
                <div class="role">Módulo de Inventario</div>

                <nav class="nav" aria-label="Navegación de inventario">
                    <a class="nav-link active" href="@Url.Action("PanelInventario", "Inventario")">
                        <span class="nav-symbol">▦</span>
                        <span>Panel Inventario</span>
                    </a>

                    <a class="nav-link" href="@Url.Action("GestionProductos", "Inventario")">
                        <span class="nav-symbol">□</span>
                        <span>Gestión de Productos</span>
                    </a>
                </nav>
            </div>

            <div class="sidebar-bottom">
                <a class="nav-link" href="#">
                    <span class="nav-symbol">⇥</span>
                    <span>Cerrar Sesión</span>
                </a>
            </div>
        </aside>

        <main class="main">
            <header class="page-head">
                <div>
                    <h1>Panel de Inventario</h1>

                    <div class="subtitle">
                        <strong>@Model.NombreSucursal</strong><br />
                        @Model.Direccion
                        <span>
                            · Última actualización:
                            @(Model.UltimaActualizacion?.ToString("dd/MM/yyyy HH:mm") ?? "Sin registro")
                        </span>
                    </div>
                </div>

                <div class="profile">
                    <div class="avatar">
                        @((Model.Encargado ?? "I").Length > 0
                            ? (Model.Encargado ?? "I").Substring(0, 1).ToUpperInvariant()
                            : "I")
                    </div>

                    <div>
                        <strong>
                            @(string.IsNullOrWhiteSpace(Model.Encargado)
                                ? "Sin encargado asignado"
                                : Model.Encargado)
                        </strong>
                        <span>Encargado de inventario</span>
                    </div>
                </div>
            </header>

            <section class="kpis" aria-label="Indicadores del inventario">
                <article class="card kpi">
                    <div class="kpi-label">Total de productos</div>
                    <div class="kpi-number">@Model.TotalProductos.ToString("N0")</div>
                    <div class="kpi-note">Productos registrados</div>
                </article>

                <article class="card kpi">
                    <div class="kpi-label">Stock bajo</div>
                    <div class="kpi-number">@Model.StockBajo.ToString("N0")</div>
                    <div class="kpi-note">Requieren revisión</div>
                </article>

                <article class="card kpi">
                    <div class="kpi-label">Sin stock</div>
                    <div class="kpi-number">@Model.SinStock.ToString("N0")</div>
                    <div class="kpi-note">Productos agotados</div>
                </article>

                <article class="card kpi">
                    <div class="kpi-label">Total de unidades</div>
                    <div class="kpi-number">@Model.TotalUnidades.ToString("N0")</div>
                    <div class="kpi-note">Unidades disponibles</div>
                </article>

                <article class="card kpi">
                    <div class="kpi-label">Valor total</div>
                    <div class="kpi-number">Bs. @Model.ValorTotal.ToString("N2")</div>
                    <div class="kpi-note">Valor registrado del inventario</div>
                </article>
            </section>

            <section class="content-grid">
                <article class="card section-card">
                    <div class="section-head">
                        <h2>Movimientos recientes</h2>
                        <span class="section-meta">
                            @Model.Movimientos.Count registro(s)
                        </span>
                    </div>

                    @if (Model.Movimientos.Count == 0)
                    {
                        <div class="empty">No hay movimientos registrados.</div>
                    }
                    else
                    {
                        foreach (var movimiento in Model.Movimientos)
                        {
                            var esEntrada = string.Equals(
                                movimiento.Tipo,
                                "Entrada",
                                StringComparison.OrdinalIgnoreCase
                            );

                            <div class="movement">
                                <div>
                                    <div class="movement-name">
                                        @movimiento.Producto
                                        <span class="pill @(esEntrada ? "" : "out")">
                                            @movimiento.Tipo
                                        </span>
                                    </div>

                                    <div class="movement-sub">
                                        @movimiento.Fecha.ToString("dd/MM/yyyy HH:mm")
                                        · Responsable: @movimiento.Responsable
                                    </div>
                                </div>

                                <div class="movement-qty">
                                    @(esEntrada ? "+" : "−")@movimiento.Cantidad
                                </div>
                            </div>
                        }
                    }
                </article>

                <article class="card section-card">
                    <div class="section-head">
                        <h2>Alertas de inventario</h2>
                        <span class="section-meta">
                            @Model.Alertas.Count alerta(s)
                        </span>
                    </div>

                    @if (Model.Alertas.Count == 0)
                    {
                        <div class="empty">No hay alertas de inventario.</div>
                    }
                    else
                    {
                        foreach (var alerta in Model.Alertas)
                        {
                            <div class="alert-row">
                                <div>
                                    <div class="alert-name">
                                        @alerta.NombreProducto
                                    </div>

                                    <div class="alert-detail">
                                        Cantidad: @alerta.Cantidad
                                        · Precio: Bs. @alerta.Precio.ToString("N2")
                                    </div>
                                </div>

                                <span class="status @(alerta.Cantidad <= 0 ? "critical" : "")">
                                    @alerta.NivelAlerta
                                </span>
                            </div>
                        }
                    }
                </article>
            </section>

            <section class="card section-card">
                <div class="section-head">
                    <h2>Productos por categoría</h2>
                    <span class="section-meta">
                        @Model.Categorias.Count categoría(s)
                    </span>
                </div>

                @if (Model.Categorias.Count == 0)
                {
                    <div class="empty">No hay categorías registradas.</div>
                }
                else
                {
                    <div class="categories">
                        @foreach (var categoria in Model.Categorias)
                        {
                            <article class="category">
                                <div class="category-name">
                                    @categoria.Categoria
                                </div>

                                <div class="category-count">
                                    @categoria.CantidadProductos.ToString("N0")
                                </div>

                                <div class="category-meta">productos</div>

                                <div class="category-meta">
                                    Unidades en inventario:
                                    <strong>@categoria.TotalUnidades.ToString("N0")</strong>
                                </div>
                            </article>
                        }
                    </div>
                }
            </section>

            <footer class="footer">
                © @DateTime.Now.Year L'Avielle · Panel de Inventario
                · Sucursal: @Model.NombreSucursal
            </footer>
        </main>
    </div>
</body>
</html>
