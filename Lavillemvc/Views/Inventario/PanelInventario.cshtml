@model Lavillemvc.Models.InventarioPanelInventario
@using System

@{
    Layout = null;
    ViewData["Title"] = "Panel de Inventario";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Panel de Inventario - L'Avielle</title>

    <link rel="stylesheet" href="~/css/inventario.css" />
</head>
<body>
    <div class="page">
        <div class="content-wrapper">

            <aside class="sidebar">
                <div class="sidebar-top">
                    <div class="brand-group">
                        <div class="brand-logo">L'Avielle</div>

                        <div class="role-badge">
                            Encargado de Inventario — Las Mercedes
                        </div>
                    </div>

                    <nav class="nav-list" aria-label="Navegación de inventario">
                        <a href="@Url.Action("PanelInventario", "Inventario")"
                           class="sidebar-link active">
                            <span class="nav-icon">
                                <svg viewBox="0 0 24 24">
                                    <rect x="4" y="4" width="16" height="16" rx="2"></rect>
                                    <path d="M8 8h8"></path>
                                    <path d="M8 12h5"></path>
                                    <path d="M8 16h4"></path>
                                </svg>
                            </span>
                            <span class="tab-text">Panel de Inventario</span>
                            <span class="active-indicator"></span>
                        </a>

                        <a href="@Url.Action("GestionProductos", "Inventario")"
                           class="sidebar-link">
                            <span class="nav-icon">
                                <svg viewBox="0 0 24 24">
                                    <path d="M5 7h14"></path>
                                    <path d="M5 12h14"></path>
                                    <path d="M5 17h14"></path>
                                    <circle cx="8" cy="7" r="1"></circle>
                                    <circle cx="8" cy="12" r="1"></circle>
                                    <circle cx="8" cy="17" r="1"></circle>
                                </svg>
                            </span>
                            <span class="tab-text">Gestión de Productos</span>
                        </a>
                    </nav>
                </div>

                <div class="sidebar-bottom">
                    <div class="divider"></div>

                    <a href="@Url.Action("Index", "Login")"
                       class="sidebar-link logout-link">
                        <span class="nav-icon">
                            <svg viewBox="0 0 24 24">
                                <path d="M9 4H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h4"></path>
                                <path d="M14 8l4 4-4 4"></path>
                                <path d="M10 12h8"></path>
                            </svg>
                        </span>
                        <span class="tab-text">Cerrar Sesión</span>
                    </a>
                </div>
            </aside>

            <main class="main-content">

                <header class="inventory-header">
                    <div class="header-text">
                        <h1>Panel de Inventario</h1>
                        <p>
                            <strong>@Model.NombreSucursal</strong>
                            · @Model.Direccion
                        </p>
                        <p>
                            Última actualización:
                            @(Model.UltimaActualizacion?.ToString("dd/MM/yyyy HH:mm")
                                ?? "Sin registro")
                        </p>
                    </div>

                    <div class="profile-area">
                        <div class="profile-avatar">
                            @(!string.IsNullOrWhiteSpace(Model.Encargado)
                                ? Model.Encargado.Substring(0, 1).ToUpperInvariant()
                                : "I")
                        </div>

                        <div class="profile-info">
                            <strong>
                                @(string.IsNullOrWhiteSpace(Model.Encargado)
                                    ? "Sin encargado asignado"
                                    : Model.Encargado)
                            </strong>
                            <span>Encargado de inventario</span>
                        </div>
                    </div>
                </header>

                <section class="kpi-cards-row">
                    <article class="kpi-card">
                        <div class="kpi-header">
                            <span class="kpi-title">Total de productos</span>
                        </div>
                        <div class="kpi-value">
                            @Model.TotalProductos.ToString("N0")
                        </div>
                    </article>

                    <article class="kpi-card">
                        <div class="kpi-header">
                            <span class="kpi-title">Stock bajo</span>
                        </div>
                        <div class="kpi-value">
                            @Model.StockBajo.ToString("N0")
                        </div>
                    </article>

                    <article class="kpi-card">
                        <div class="kpi-header">
                            <span class="kpi-title">Sin stock</span>
                        </div>
                        <div class="kpi-value">
                            @Model.SinStock.ToString("N0")
                        </div>
                    </article>

                    <article class="kpi-card">
                        <div class="kpi-header">
                            <span class="kpi-title">Total de unidades</span>
                        </div>
                        <div class="kpi-value">
                            @Model.TotalUnidades.ToString("N0")
                        </div>
                    </article>

                    <article class="kpi-card">
                        <div class="kpi-header">
                            <span class="kpi-title">Valor total</span>
                        </div>
                        <div class="kpi-value money">
                            $ @Model.ValorTotal.ToString("N2")
                        </div>
                    </article>
                </section>

                <section class="visual-section">

                    <article class="performance-card">
                        <h2>Movimientos recientes</h2>

                        @if (Model.Movimientos.Count == 0)
                        {
                            <p>No hay movimientos registrados.</p>
                        }
                        else
                        {
                            foreach (var movimiento in Model.Movimientos)
                            {
                                var esEntrada = string.Equals(
                                    movimiento.Tipo,
                                    "Entrada",
                                    StringComparison.OrdinalIgnoreCase);

                                <div class="movement-row">
                                    <div class="movement-info">
                                        <strong>@movimiento.Producto</strong>

                                        <span class="@(esEntrada ? "entry" : "exit")">
                                            @movimiento.Tipo
                                        </span>

                                        <p>
                                            @movimiento.Fecha.ToString("dd/MM/yyyy HH:mm")
                                            · Responsable: @movimiento.Responsable
                                        </p>
                                    </div>

                                    <strong class="@(esEntrada ? "entry" : "exit")">
                                        @(esEntrada ? "+" : "−")@movimiento.Cantidad
                                    </strong>
                                </div>
                            }
                        }
                    </article>

                    <article class="reservations-card">
                        <h2>Alertas de inventario</h2>

                        @if (Model.Alertas.Count == 0)
                        {
                            <p>No hay alertas de inventario.</p>
                        }
                        else
                        {
                            foreach (var alerta in Model.Alertas)
                            {
                                var claseAlerta =
                                    alerta.Cantidad <= 0 || alerta.NivelAlerta == "Crítico"
                                        ? "critical"
                                        : "low";

                                <div class="alert-row">
                                    <div>
                                        <strong>@alerta.NombreProducto</strong>

                                        <p>
                                            Cantidad: @alerta.Cantidad
                                            · Precio: $ @alerta.Precio.ToString("N2")
                                        </p>
                                    </div>

                                    <b class="@claseAlerta">
                                        @alerta.NivelAlerta
                                    </b>
                                </div>
                            }
                        }
                    </article>

                </section>

                <section class="categories-section">
                    <h2>Productos por categoría</h2>

                    @if (Model.Categorias.Count == 0)
                    {
                        <p>No hay categorías registradas.</p>
                    }
                    else
                    {
                        <div class="category-grid">
                            @foreach (var categoria in Model.Categorias)
                            {
                                <article class="category-card">
                                    <h3>@categoria.Categoria</h3>

                                    <strong>
                                        @categoria.CantidadProductos.ToString("N0")
                                    </strong>

                                    <p>Productos registrados</p>

                                    <p>
                                        Unidades en inventario:
                                        @categoria.TotalUnidades.ToString("N0")
                                    </p>
                                </article>
                            }
                        </div>
                    }
                </section>

            </main>
        </div>
    </div>
</body>
</html>