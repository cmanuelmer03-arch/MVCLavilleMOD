@using System
@using System.Linq
@using System.Globalization
@using Lavillemvc.Controllers
@model List<Lavillemvc.Controllers.ProductoInventarioItem>

@{
    Layout = null;

    var busqueda = ViewBag.Busqueda as string ?? "";
    var categoriaActual = ViewBag.Categoria as string ?? "Todos";
    var ordenarPor = ViewBag.OrdenarPor as string ?? "Nombre";

    int paginaActual = (int)(ViewBag.PaginaActual ?? 1);
    int totalPaginas = (int)(ViewBag.TotalPaginas ?? 1);
    int totalFiltrados = (int)(ViewBag.TotalFiltrados ?? 0);
    int mostrarDesde = (int)(ViewBag.MostrarDesde ?? 0);
    int mostrarHasta = (int)(ViewBag.MostrarHasta ?? 0);

    var categorias = ViewBag.CategoriasDisponibles as string[]
        ?? Array.Empty<string>();

    // Opciones conocidas más las existentes en Supabase.
    var categoriasFormulario = new[]
    {
        "Coloración",
        "Consumibles",
        "Cuidado Capilar",
        "Herramientas"
    }
    .Concat(categorias)
    .Where(c => !string.IsNullOrWhiteSpace(c))
    .Distinct(StringComparer.OrdinalIgnoreCase)
    .OrderBy(c => c)
    .ToArray();

    bool formularioAbierto =
        (bool)(ViewBag.FormularioAbierto ?? false);

    var productoFormulario =
        ViewBag.ProductoFormulario as ProductoInventarioItem
        ?? new ProductoInventarioItem();

    var productoDetalle =
        ViewBag.ProductoDetalle as ProductoInventarioItem;

    bool esEdicion = productoFormulario.Id > 0;

    string? mensaje = ViewBag.Mensaje as string;
    string? mensajeError = ViewBag.MensajeError as string;

    DateTime? ultimaActualizacion =
        ViewBag.UltimaActualizacion as DateTime?;

    // Al agregar, obligamos a seleccionar una categoría.
    // Al editar, conservamos la categoría actual.
    // Si falla el POST, conservamos la elección realizada.
    string categoriaSeleccionada =
        esEdicion ||
        string.Equals(
            Context.Request.Method,
            "POST",
            StringComparison.OrdinalIgnoreCase)
        ? productoFormulario.Categoria
        : "";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Gestión de Productos - L'Avielle</title>

    <link rel="stylesheet" href="~/css/inventario.css" />
</head>
<body>
    <div class="page">
        <div class="content-wrapper">

            <aside class="sidebar">
                <div class="sidebar-top">
                    <div class="brand-group">
                        <div class="brand-logo">L'Avielle</div>

                        <div class="role-badge">
                            Gestión de inventario
                        </div>
                    </div>

                    <nav class="nav-list"
                         aria-label="Navegación de inventario">

                        <a href="@Url.Action("PanelInventario", "Inventario")"
                           class="sidebar-link">

                            <span class="nav-icon">
                                <svg viewBox="0 0 24 24">
                                    <rect x="4" y="4"
                                          width="16" height="16" rx="2"></rect>
                                    <path d="M8 8h8"></path>
                                    <path d="M8 12h5"></path>
                                    <path d="M8 16h4"></path>
                                </svg>
                            </span>

                            <span class="tab-text">
                                Panel de Inventario
                            </span>
                        </a>

                        <a href="@Url.Action("GestionProductos", "Inventario")"
                           class="sidebar-link active">

                            <span class="nav-icon">
                                <svg viewBox="0 0 24 24">
                                    <path d="M5 7h14"></path>
                                    <path d="M5 12h14"></path>
                                    <path d="M5 17h14"></path>
                                    <circle cx="8" cy="7" r="1"></circle>
                                    <circle cx="8" cy="12" r="1"></circle>
                                    <circle cx="8" cy="17" r="1"></circle>
                                </svg>
                            </span>

                            <span class="tab-text">
                                Gestión de Productos
                            </span>

                            <span class="active-indicator"></span>
                        </a>
                    </nav>
                </div>

                <div class="sidebar-bottom">
                    <div class="divider"></div>

                    <a href="@Url.Action("Index", "Login")"
                       class="sidebar-link logout-link">

                        <span class="nav-icon">
                            <svg viewBox="0 0 24 24">
                                <path d="M9 4H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h4"></path>
                                <path d="M14 8l4 4-4 4"></path>
                                <path d="M10 12h8"></path>
                            </svg>
                        </span>

                        <span class="tab-text">Cerrar Sesión</span>
                    </a>
                </div>
            </aside>

            <main class="main-content">

                <section class="products-header">
                    <div class="header-text">
                        <h1>Gestión de Productos</h1>

                        <p>
                            Visualiza, edita y añade productos
                            al catálogo de L'Avielle.
                        </p>
                    </div>

                    <form class="product-actions"
                          method="get"
                          action="@Url.Action("GestionProductos", "Inventario")">

                        <div class="product-search">
                            <span class="search-icon">
                                <svg viewBox="0 0 24 24">
                                    <circle cx="10.5" cy="10.5" r="6"></circle>
                                    <path d="m15 15 5 5"></path>
                                </svg>
                            </span>

                            <input type="search"
                                   name="busqueda"
                                   value="@busqueda"
                                   placeholder="Buscar por nombre, marca o código..."
                                   aria-label="Buscar productos" />
                        </div>

                        <input type="hidden"
                               name="categoria"
                               value="@categoriaActual" />

                        <input type="hidden"
                               name="ordenarPor"
                               value="@ordenarPor" />

                        <button type="submit"
                                class="secondary-button">
                            Buscar
                        </button>

                        <a href="@Url.Action("GestionProductos", "Inventario", new
                           {
                               busqueda,
                               categoria = categoriaActual,
                               ordenarPor,
                               mostrarFormulario = true,
                               pagina = paginaActual
                           })"
                           class="add-product-button">
                            + Agregar Producto
                        </a>
                    </form>
                </section>

                @if (!string.IsNullOrWhiteSpace(mensaje))
                {
                    <div class="inventory-message">
                        @mensaje
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(mensajeError))
                {
                    <div class="inventory-message error">
                        @mensajeError
                    </div>
                }

                @if (formularioAbierto)
                {
                    <section class="product-form-card">

                        <div class="section-head">
                            <h2>
                                @(esEdicion
                                    ? "Editar producto"
                                    : "Agregar producto")
                            </h2>

                            <a class="secondary-button"
                               href="@Url.Action("GestionProductos", "Inventario")">
                                Cancelar
                            </a>
                        </div>

                        @if (!ViewData.ModelState.IsValid)
                        {
                            @Html.ValidationSummary(
                                false,
                                "Revisa los siguientes datos:"
                            )
                        }

                        <form method="post"
                              action="@Url.Action("GuardarProducto", "Inventario")">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="Id"
                                   value="@productoFormulario.Id" />

                            <input type="hidden"
                                   name="busquedaRegreso"
                                   value="@busqueda" />

                            <input type="hidden"
                                   name="categoriaRegreso"
                                   value="@categoriaActual" />

                            <input type="hidden"
                                   name="ordenarPorRegreso"
                                   value="@ordenarPor" />

                            <input type="hidden"
                                   name="paginaRegreso"
                                   value="@paginaActual" />

                            <div class="product-form-grid">

                                <div class="product-form-field">
                                    <label for="Nombre">
                                        Nombre del producto
                                    </label>

                                    <input id="Nombre"
                                           name="Nombre"
                                           maxlength="120"
                                           required
                                           value="@productoFormulario.Nombre" />

                                    @Html.ValidationMessage("Nombre")
                                </div>

                                <div class="product-form-field">
                                    <label for="Categoria">
                                        Categoría
                                    </label>

                                    <select id="Categoria"
                                            name="Categoria"
                                            required
                                            aria-label="Seleccionar categoría">

                                        @if (string.IsNullOrWhiteSpace(categoriaSeleccionada))
                                        {
                                            <option value="" disabled selected>
                                                Selecciona una categoría
                                            </option>
                                        }
                                        else
                                        {
                                            <option value="" disabled>
                                                Selecciona una categoría
                                            </option>
                                        }

                                        @foreach (var cat in categoriasFormulario)
                                        {
                                            if (string.Equals(
                                                categoriaSeleccionada,
                                                cat,
                                                StringComparison.OrdinalIgnoreCase))
                                            {
                                                <option value="@cat" selected>
                                                    @cat
                                                </option>
                                            }
                                            else
                                            {
                                                <option value="@cat">
                                                    @cat
                                                </option>
                                            }
                                        }
                                    </select>

                                    @Html.ValidationMessage("Categoria")
                                </div>

                                <div class="product-form-field">
                                    <label for="Marca">Marca</label>

                                    <input id="Marca"
                                           name="Marca"
                                           maxlength="80"
                                           required
                                           value="@productoFormulario.Marca" />

                                    @Html.ValidationMessage("Marca")
                                </div>

                                <div class="product-form-field">
                                    <label for="StockActual">
                                        Stock actual
                                    </label>

                                    <input id="StockActual"
                                           name="StockActual"
                                           type="number"
                                           min="0"
                                           max="1000000"
                                           step="1"
                                           required
                                           value="@productoFormulario.StockActual" />

                                    @Html.ValidationMessage("StockActual")
                                </div>

                                <div class="product-form-field">
                                    <label for="Precio">
                                        Precio unitario ($)
                                    </label>

                                    <input id="Precio"
                                           name="Precio"
                                           type="number"
                                           min="0"
                                           step="0.01"
                                           required
                                           value="@productoFormulario.Precio.ToString("0.00", CultureInfo.InvariantCulture)" />

                                    @Html.ValidationMessage("Precio")
                                </div>

                            </div>

                            <div class="product-form-actions">
                                <button class="add-product-button"
                                        type="submit">
                                    @(esEdicion
                                        ? "Guardar cambios"
                                        : "Guardar producto")
                                </button>

                                <a class="secondary-button"
                                   href="@Url.Action("GestionProductos", "Inventario")">
                                    Cancelar
                                </a>
                            </div>

                        </form>
                    </section>
                }

                @if (productoDetalle != null)
                {
                    <section class="product-form-card">
                        <div class="section-head">
                            <h2>Detalle del producto</h2>

                            <a class="secondary-button"
                               href="@Url.Action("GestionProductos", "Inventario")">
                                Cerrar
                            </a>
                        </div>

                        <div class="product-details-grid">
                            <div>
                                <span>Código</span>
                                <strong>@productoDetalle.Codigo</strong>
                            </div>

                            <div>
                                <span>Producto</span>
                                <strong>@productoDetalle.Nombre</strong>
                            </div>

                            <div>
                                <span>Categoría</span>
                                <strong>@productoDetalle.Categoria</strong>
                            </div>

                            <div>
                                <span>Marca</span>
                                <strong>@productoDetalle.Marca</strong>
                            </div>

                            <div>
                                <span>Stock actual</span>
                                <strong>@productoDetalle.StockActual</strong>
                            </div>

                            <div>
                                <span>Stock mínimo</span>
                                <strong>@productoDetalle.StockMinimo</strong>
                            </div>

                            <div>
                                <span>Precio unitario</span>
                                <strong>
                                    $ @productoDetalle.Precio.ToString("N2")
                                </strong>
                            </div>

                            <div>
                                <span>Estado</span>
                                <strong>@productoDetalle.Estado</strong>
                            </div>
                        </div>
                    </section>
                }

                <section class="filters-row">

                    <div class="filter-options">
                        <a href="@Url.Action("GestionProductos", "Inventario", new
                           {
                               busqueda,
                               categoria = "Todos",
                               ordenarPor,
                               pagina = 1
                           })"
                           class="filter @(categoriaActual == "Todos" ? "selected" : "")">
                            Todos
                        </a>

                        @foreach (var cat in categorias)
                        {
                            <a href="@Url.Action("GestionProductos", "Inventario", new
                               {
                                   busqueda,
                                   categoria = cat,
                                   ordenarPor,
                                   pagina = 1
                               })"
                               class="filter @(categoriaActual == cat ? "selected" : "")">
                                @cat
                            </a>
                        }
                    </div>

                    <form class="sort-box"
                          method="get"
                          action="@Url.Action("GestionProductos", "Inventario")">

                        <span>Ordenar por:</span>

                        <input type="hidden"
                               name="busqueda"
                               value="@busqueda" />

                        <input type="hidden"
                               name="categoria"
                               value="@categoriaActual" />

                        <select name="ordenarPor"
                                onchange="this.form.submit()"
                                aria-label="Ordenar productos">

                            <option value="Nombre"
                                    selected="@(ordenarPor == "Nombre" ? "selected" : null)">
                                Nombre A-Z
                            </option>

                            <option value="NombreDesc"
                                    selected="@(ordenarPor == "NombreDesc" ? "selected" : null)">
                                Nombre Z-A
                            </option>

                            <option value="PrecioAsc"
                                    selected="@(ordenarPor == "PrecioAsc" ? "selected" : null)">
                                Precio menor a mayor
                            </option>

                            <option value="PrecioDesc"
                                    selected="@(ordenarPor == "PrecioDesc" ? "selected" : null)">
                                Precio mayor a mayor
                            </option>

                            <option value="StockAsc"
                                    selected="@(ordenarPor == "StockAsc" ? "selected" : null)">
                                Stock menor a mayor
                            </option>

                            <option value="StockDesc"
                                    selected="@(ordenarPor == "StockDesc" ? "selected" : null)">
                                Stock mayor a menor
                            </option>
                        </select>
                    </form>
                </section>

                <form method="post"
                      action="@Url.Action("EliminarProductos", "Inventario")"
                      id="eliminarProductosForm">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="busquedaRegreso"
                           value="@busqueda" />

                    <input type="hidden"
                           name="categoriaRegreso"
                           value="@categoriaActual" />

                    <input type="hidden"
                           name="ordenarPorRegreso"
                           value="@ordenarPor" />

                    <input type="hidden"
                           name="paginaRegreso"
                           value="@paginaActual" />

                    <section class="products-table-card">

                        <div class="product-form-actions">
                            <button type="submit"
                                    class="secondary-button"
                                    onclick="return confirmarEliminacion();">
                                Eliminar seleccionados
                            </button>

                            <span>
                                Marca uno o varios productos para eliminarlos.
                            </span>
                        </div>

                        <div class="products-table-header">
                            <div>
                                <input type="checkbox"
                                       id="seleccionarTodos"
                                       aria-label="Seleccionar todos los productos de esta página" />
                                CÓDIGO
                            </div>

                            <div>PRODUCTO</div>
                            <div>CATEGORÍA</div>
                            <div>MARCA</div>
                            <div>STOCK ACT.</div>
                            <div>STOCK MÍN.</div>
                            <div>PRECIO UNIT.</div>
                            <div>ESTADO</div>
                            <div>ACCIONES</div>
                        </div>

                        @if (Model == null || Model.Count == 0)
                        {
                            <div class="product-empty">
                                No se encontraron productos con los filtros seleccionados.
                            </div>
                        }
                        else
                        {
                            foreach (var producto in Model)
                            {
                                var claseEstado =
                                    producto.Estado == "En Stock"
                                        ? "in-stock"
                                        : producto.Estado == "Crítico" ||
                                          producto.Estado == "Sin stock"
                                            ? "critical-status"
                                            : "low-status";

                                <div class="product-row">

                                    <div class="code">
                                        <input type="checkbox"
                                               class="seleccionar-producto"
                                               name="ids"
                                               value="@producto.Id"
                                               aria-label="Seleccionar @producto.Nombre" />

                                        <span>@producto.Codigo</span>
                                    </div>

                                    <div class="product-name">
                                        @producto.Nombre
                                    </div>

                                    <div>@producto.Categoria</div>

                                    <div>@producto.Marca</div>

                                    <div class="@(producto.StockActual < producto.StockMinimo ? "warning-text" : "")">
                                        @producto.StockActual
                                    </div>

                                    <div>@producto.StockMinimo</div>

                                    <div>
                                        $ @producto.Precio.ToString("N2")
                                    </div>

                                    <div>
                                        <span class="stock-status @claseEstado">
                                            @producto.Estado
                                        </span>
                                    </div>

                                    <div class="row-actions">
                                        <a href="@Url.Action("GestionProductos", "Inventario", new
                                           {
                                               busqueda,
                                               categoria = categoriaActual,
                                               ordenarPor,
                                               pagina = paginaActual,
                                               detalleId = producto.Id
                                           })">
                                            Ver
                                        </a>

                                        <span>·</span>

                                        <a href="@Url.Action("GestionProductos", "Inventario", new
                                           {
                                               busqueda,
                                               categoria = categoriaActual,
                                               ordenarPor,
                                               pagina = paginaActual,
                                               editarId = producto.Id
                                           })">
                                            Editar
                                        </a>
                                    </div>
                                </div>
                            }
                        }

                        <div class="table-bottom">
                            <span>
                                Mostrando @mostrarDesde-@mostrarHasta
                                de @totalFiltrados productos
                            </span>

                            <div class="pagination">
                                @if (paginaActual > 1)
                                {
                                    <a href="@Url.Action("GestionProductos", "Inventario", new
                                       {
                                           busqueda,
                                           categoria = categoriaActual,
                                           ordenarPor,
                                           pagina = paginaActual - 1
                                       })">
                                        Anterior
                                    </a>
                                }
                                else
                                {
                                    <span>Anterior</span>
                                }

                                @for (
                                    int p = Math.Max(1, paginaActual - 1);
                                    p <= Math.Min(totalPaginas, paginaActual + 2);
                                    p++)
                                {
                                    <a href="@Url.Action("GestionProductos", "Inventario", new
                                       {
                                           busqueda,
                                           categoria = categoriaActual,
                                           ordenarPor,
                                           pagina = p
                                       })"
                                       class="@(p == paginaActual ? "current-page" : "")">
                                        @p
                                    </a>
                                }

                                @if (paginaActual < totalPaginas)
                                {
                                    <a href="@Url.Action("GestionProductos", "Inventario", new
                                       {
                                           busqueda,
                                           categoria = categoriaActual,
                                           ordenarPor,
                                           pagina = paginaActual + 1
                                       })">
                                        Siguiente
                                    </a>
                                }
                                else
                                {
                                    <span>Siguiente</span>
                                }
                            </div>
                        </div>

                    </section>
                </form>

                <section class="inventory-summary">
                    <div>
                        <span>PRODUCTOS REGISTRADOS</span>
                        <strong>@ViewBag.TotalProductos</strong>
                    </div>

                    <div>
                        <span>STOCK BAJO</span>
                        <strong>@ViewBag.StockBajo</strong>
                    </div>

                    <div>
                        <span>SIN STOCK</span>
                        <strong>@ViewBag.SinStock</strong>
                    </div>

                    <div class="last-update">
                        Última actualización:
                        @(ultimaActualizacion?.ToString("dd/MM/yyyy HH:mm")
                            ?? "Sin registro")
                    </div>
                </section>

            </main>
        </div>
    </div>

    <script>
            const seleccionarTodos =
                document.getElementById('seleccionarTodos');

            const casillasProducto = () =>
                Array.from(
                    document.querySelectorAll('.seleccionar-producto')
                );

            seleccionarTodos?.addEventListener('change', function() {
                casillasProducto().forEach(casilla => {
                    casilla.checked = seleccionarTodos.checked;
                });
            });

            casillasProducto().forEach(casilla => {
                casilla.addEventListener('change', function() {
                    if (seleccionarTodos) {
                        seleccionarTodos.checked =
                            casillasProducto().length > 0 &&
                            casillasProducto().every(item => item.checked);
                    }
                });
            });

            function confirmarEliminacion() {
                const seleccionados =
                    casillasProducto().filter(
                        casilla => casilla.checked
                    ).length;

                if (seleccionados === 0) {
                    alert('Selecciona al menos un producto para eliminar.');
                    return false;
                }

                return confirm(
                    `¿Seguro que quieres eliminar ${seleccionados} producto(s) del inventario?`
                );
            }
    </script>
</body>
</html>
