                        <div>
                            <span class="stock-status low-status">
                                Bajo
                            </span>
                        </div>

                        <div class="row-actions">
                            Ver · Editar
                        </div>

                    </div>


                    <!-- PAGINACIÓN -->

                    <div class="table-bottom">

                        <span>
                            Mostrando 1-7 de 156 productos
                        </span>

                        <div class="pagination">

                            <a href="#">
                                Anterior
