@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Gestión de Productos - L'Avielle</title>

    <link rel="stylesheet" href="~/css/inventario.css" />

</head>

<body>

    <div class="page">

        <div class="content-wrapper">

            <!-- SIDEBAR -->
            <aside class="sidebar">

                <div class="sidebar-top">

                    <div class="brand-group">

                        <div class="brand-logo">
                            L'Avielle
                        </div>

                        <div class="role-badge">
                            Encargado de Inventario — Las Mercedes
                        </div>

                    </div>

                    <nav class="nav-list">

                        <a href="@Url.Action("PanelInventario", "Inventario")"
                           class="sidebar-link">

                            <span class="nav-icon">
                                <svg viewBox="0 0 24 24">
                                    <rect x="4" y="4" width="16" height="16" rx="2"></rect>
                                    <path d="M8 8h8"></path>
                                    <path d="M8 12h5"></path>
                                    <path d="M8 16h4"></path>
                                </svg>
                            </span>

                            <span class="tab-text">
                                Panel de Inventario
                            </span>

                        </a>


                        <a href="@Url.Action("GestionProductos", "Inventario")"
                           class="sidebar-link active">

                            <span class="nav-icon">
                                <svg viewBox="0 0 24 24">
                                    <path d="M5 7h14"></path>
                                    <path d="M5 12h14"></path>
                                    <path d="M5 17h14"></path>
                                    <circle cx="8" cy="7" r="1"></circle>
                                    <circle cx="8" cy="12" r="1"></circle>
                                    <circle cx="8" cy="17" r="1"></circle>
                                </svg>
                            </span>

                            <span class="tab-text">
                                Gestión de Productos
                            </span>

                            <span class="active-indicator"></span>

                        </a>

                    </nav>

                </div>


                <div class="sidebar-bottom">

                    <div class="divider"></div>

                    <a href="#" class="sidebar-link logout-link">

                        <span class="nav-icon">
                            <svg viewBox="0 0 24 24">
                                <path d="M9 4H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h4"></path>
                                <path d="M14 8l4 4-4 4"></path>
                                <path d="M10 12h8"></path>
                            </svg>
                        </span>

                        <span class="tab-text">
                            Cerrar Sesión
                        </span>

                    </a>

                </div>

            </aside>


            <!-- CONTENIDO -->
            <main class="main-content">

                <section class="products-header">

                    <div class="header-text">

                        <h1>
                            Gestión de Productos
                        </h1>

                        <p>
                            Visualiza, edita y añade productos al catálogo de L'Avielle.
                        </p>

                    </div>


                    <div class="product-actions">

                        <div class="product-search">

                            <span class="search-icon">
                                <svg viewBox="0 0 24 24">
                                    <circle cx="10.5" cy="10.5" r="6"></circle>
                                    <path d="m15 15 5 5"></path>
                                </svg>
                            </span>

                            <span>
                                Buscar por nombre, marca o código...
                            </span>

                        </div>


                        <a href="#" class="add-product-button">
                            + Agregar Producto
                        </a>

                    </div>

                </section>


                <!-- FILTROS -->
                <section class="filters-row">

                    <div class="filter-options">

                        <a href="#" class="filter selected">
                            Todos
                        </a>

                        <a href="#" class="filter">
                            Coloración
                        </a>

                        <a href="#" class="filter">
                            Cuidado Capilar
                        </a>

                        <a href="#" class="filter">
                            Herramientas
                        </a>

                        <a href="#" class="filter">
                            Consumibles
                        </a>

                        <a href="#" class="filter">
                            Mobiliario
                        </a>

                    </div>


                    <div class="sort-box">

                        <span>
                            Ordenar por:
                        </span>

                        <strong>
                            Nombre
                        </strong>

                        <span>
                            ▼
                        </span>

                    </div>

                </section>


                <!-- TABLA -->
                <section class="products-table-card">

                    <div class="products-table-header">

                        <div>CÓDIGO</div>
                        <div>PRODUCTO</div>
                        <div>CATEGORÍA</div>
                        <div>MARCA</div>
                        <div>STOCK ACT.</div>
                        <div>STOCK MÍN.</div>
                        <div>PRECIO UNIT.</div>
                        <div>ESTADO</div>
                        <div>ACCIONES</div>

                    </div>


                    <div class="product-row">

                        <div class="code">
                            PRD-001
                        </div>

                        <div class="product-name">
