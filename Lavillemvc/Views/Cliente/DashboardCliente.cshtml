@model Lavillemvc.Models.DashboardClienteCompleto

@{
    ViewData["Title"] = "Dashboard Cliente";
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";
}

<div class="dashboard">

    <div class="dashboard-header">

        <div class="titulo-dashboard">

            <h1>Bienvenida, @Model.Nombre</h1>

            <p>
                Tu resumen de belleza
                <span>•</span>

                @if (Model.FechaProximaCita.HasValue)
                {
                    <strong>
                        @Model.FechaProximaCita.Value.ToString("dddd, d 'de' MMMM 'de' yyyy")
                    </strong>
                }
            </p>

        </div>

        <div class="usuario">

            <div class="usuario-info">

                <strong>@Model.NombreCompleto</strong>

                <small>
                    Socio @Model.Membresia
                </small>

            </div>

        </div>

    </div>


    <div class="dashboard-grid">

        <div class="columna-izquierda">

            @if (Model.IdProximaCita.HasValue)
            {
                <div class="card cita">

                    <div class="card-title">

                        <span class="titulo-cita">
                            TU PRÓXIMA CITA
                        </span>

                        <span class="estado-confirmada">
                            @Model.EstadoProximaCita
                        </span>

                    </div>


                    <div class="cita-contenido">

                        <div>

                            <h2>
                                @Model.ProximoServicio
                            </h2>

                            <p class="especialista">

                                Especialista:

                                <strong>
                                    @Model.EspecialistaProximaCita
                                </strong>

                            </p>

                        </div>


                        <div class="datos-cita">

                            <strong>

                                @if (Model.FechaProximaCita.HasValue)
                                {
                                    @Model.FechaProximaCita.Value.ToString("d 'de' MMMM 'de' yyyy")
                                }

                                @if (Model.HoraProximaCita.HasValue)
                                {
                                    @Model.HoraProximaCita.Value.ToString(@"hh\:mm")
                                }

                            </strong>

                            <span>
                                @Model.SucursalProximaCita
                            </span>

                        </div>

                    </div>

                </div>
            }




            <h2 class="titulo-promociones">
                Promociones Exclusivas para Ti
            </h2>


            <div class="promociones">

                @for (int i = 0; i < Model.Promociones.Count; i++)
                {
                    var promocion = Model.Promociones[i];

                    <div class="promo @(i % 2 == 0 ? "promo-1" : "promo-2")">

                        <div class="promo-contenido">

                            @if (promocion.Descuento.HasValue)
                            {
                                <span class="promo-descuento">
                                    @promocion.Descuento.Value% OFF
                                </span>
                            }

                            <h3>
                                @promocion.NombrePromocion
                            </h3>

                            <p>
                                @promocion.Descripcion
                            </p>

                            <button type="button" class="btn-promo">
                                APROVECHAR →
                            </button>

                        </div>

                    </div>
                }

            </div>

        </div>


        <div class="columna-derecha">

            <div class="membresia">

                <div class="membresia-titulo">

                    <h2>
                        Membresía @Model.Membresia
                    </h2>

                    <span class="icono-membresia">
                        ◇
                    </span>

                </div>


                <h1>
                    @Model.PuntosFidelidad.ToString("N0")
                </h1>

                <p>
                    PUNTOS ACUMULADOS
                </p>


                <div class="membresia-beneficios">

                    <small>
                        @Model.BeneficiosMembresia
                    </small>

                </div>


                @if (Model.InicioMembresia.HasValue && Model.FinMembresia.HasValue)
                {
                    <div class="membresia-fechas">

                        <small>
                            Membresía activa desde
                        </small>

                        <strong>
                            @Model.InicioMembresia.Value.ToString("d 'de' MMMM 'de' yyyy")
                        </strong>

                        <small>
                            Hasta
                        </small>

                        <strong>
                            @Model.FinMembresia.Value.ToString("d 'de' MMMM 'de' yyyy")
                        </strong>

                    </div>
                }

            </div>


            <h2 class="titulo-acciones">
                Acciones Rápidas
            </h2>


            <a class="accion"
               asp-controller="Cliente"
               asp-action="ReservarCita">

                <div class="accion-icono">
                    +
                </div>

                <div class="accion-texto">

                    <h3>
                        Reservar Cita
                    </h3>

                    <p>
                        Agenda un nuevo servicio
                    </p>

                </div>

                <span class="accion-flecha">
                    →
                </span>

            </a>


            <a class="accion"
               asp-controller="Cliente"
               asp-action="MisReservas">

                <div class="accion-icono">
                    ◷
                </div>

                <div class="accion-texto">

                    <h3>
                        Mis Reservas
                    </h3>

                    <p>
                        Consulta y administra tus citas
                    </p>

                </div>

                <span class="accion-flecha">
                    →
                </span>

            </a>


            <a class="accion"
               asp-controller="Cliente"
               asp-action="Promociones">

                <div class="accion-icono">
                    %
                </div>

                <div class="accion-texto">

                    <h3>
                        Promociones
                    </h3>

                    <p>
                        Descubre ofertas disponibles
                    </p>

                </div>

                <span class="accion-flecha">
                    →
                </span>

            </a>


            <a class="accion"
               asp-controller="Cliente"
               asp-action="PerfilCliente">

                <div class="accion-icono">
                    ◉
                </div>

                <div class="accion-texto">

                    <h3>
                        Mi Perfil
                    </h3>

                    <p>
                        Consulta tus datos personales
                    </p>

                </div>

                <span class="accion-flecha">
                    →
                </span>

            </a>


            <div class="card resumen">

                <h2>
                    Resumen de Citas
                </h2>


                <div class="numeros">


                    <div class="numero-cita">

                        <strong>
                            @Model.CitasConfirmadas
                        </strong>

                        <span>
                            Confirmadas
                        </span>

                        <small>
                            Listas para ti
                        </small>

                    </div>


                    <div class="numero-cita">

                        <strong>
                            @Model.CitasPendientes
                        </strong>

                        <span>
                            Pendientes
                        </span>

                        <small>
                            En aprobación
                        </small>

                    </div>


                    <div class="numero-cita">

                        <strong>
                            @Model.CitasCanceladasMes
                        </strong>

                        <span>
                            Canceladas
                        </span>

                        <small>
                            Este mes
                        </small>

                    </div>


                </div>

            </div>


        </div>

    </div>

</div>