@model Lavillemvc.Models.ReservarCita

@using System.Linq
@using System.Text.Json

@{
    ViewData["Title"] = "Reservar Cita";
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";

    var opciones = Model.OpcionesDisponibles ?? new List<Lavillemvc.Models.ReservarCita.ReservaOpcion>();

    var serviciosPrincipales = opciones
    .Where(x => !x.IdServicioPadre.HasValue)
    .GroupBy(x => x.IdServicio)
    .Select(x => x.First())
    .ToList();

    var subservicios = opciones
        .Where(x => x.IdServicioPadre.HasValue)
        .GroupBy(x => x.IdServicio)
        .Select(x => x.First())
        .ToList();

    var sucursales = opciones
        .GroupBy(x => x.IdSucursal)
        .Select(x => x.First())
        .ToList();

    var especialistas = opciones
        .GroupBy(x => x.IdEspecialista)
        .Select(x => x.First())
        .ToList();

    var opcionesJson = JsonSerializer.Serialize(opciones);

    var idServicioInicial = Model.IdServicio ?? 0;
    var idSucursalInicial = Model.IdSucursal ?? 0;
    var idEspecialistaInicial = Model.IdEspecialista ?? 0;

    var fechaInicial = Model.FechaCita.HasValue
        ? Model.FechaCita.Value.ToString("yyyy-MM-dd")
        : "";

    var horaInicial = Model.HoraCita.HasValue
        ? Model.HoraCita.Value.ToString(@"hh\:mm")
        : "";
}

<div class="reserva">

    <!-- ================================================= -->
    <!-- PASOS -->
    <!-- ================================================= -->

    <div class="reserva-pasos">

        <div class="paso activo" id="paso1">
            <span>1</span>
            Servicio
        </div>

        <div class="paso" id="paso2">
            <span>2</span>
            Sucursal
        </div>

        <div class="paso" id="paso3">
            <span>3</span>
            Especialista
        </div>

        <div class="paso" id="paso4">
            <span>4</span>
            Puntos
        </div>

        <div class="paso" id="paso6">
            <span>5</span>
            Confirmación
        </div>

    </div>


    <!-- ================================================= -->
    <!-- FORMULARIO -->
    <!-- ================================================= -->

    <form asp-controller="Cliente"
          asp-action="ConfirmarReserva"
          method="post"
          id="formReserva">

        @Html.AntiForgeryToken()

        <input type="hidden"
               name="IdCliente"
               value="@Model.IdCliente" />

        <input type="hidden"
               name="idPromocion"
               value="@ViewData["IdPromocion"]" />

        <input type="hidden"
               name="IdServicio"
               id="IdServicio"
               value="@Model.IdServicio" />

        <input type="hidden"
               name="IdSucursal"
               id="IdSucursal"
               value="@Model.IdSucursal" />

        <input type="hidden"
               name="IdEspecialista"
               id="IdEspecialista"
               value="@Model.IdEspecialista" />

        <input type="hidden"
               name="FechaCita"
               id="FechaCita"
               value="@fechaInicial" />

        <input type="hidden"
               name="HoraCita"
               id="HoraCita"
               value="@horaInicial" />


        <!-- ================================================= -->
        <!-- 1. SERVICIO -->
        <!-- ================================================= -->

        <section class="reserva-seccion">

            <div class="seccion-titulo">

                <h2>
                    <span>1</span>
                    Selecciona tu Servicio
                </h2>

                <label class="estado-pendiente" id="estadoServicio">
                    Pendiente
                </label>

            </div>

            <!-- SERVICIOS PRINCIPALES -->

            <div class="servicios-grid" id="serviciosPrincipalesGrid">

                @for (int i = 0; i < serviciosPrincipales.Count; i++)
                {
                    var servicio = serviciosPrincipales[i];

                    var imagen =
                        $"/Images/servicio{(i % 6) + 1}.jpeg";

                    <button type="button"
                            class="servicio-card servicio-principal-card"
                            data-id-servicio-principal="@servicio.IdServicio">

                        <img class="servicio-imagen"
                             src="@imagen"
                             alt="@servicio.Servicio" />

                        <div class="servicio-info">

                            <h3>
                                @servicio.Servicio
                            </h3>

                            <p>
                                Selecciona para ver opciones
                            </p>

                        </div>

                    </button>
                }

            </div>


            <!-- SUBSERVICIOS -->

            <div id="subserviciosContainer"
                 style="display:none; margin-top:25px;">

                <div class="seccion-titulo">

                    <h2>
                        <span>1</span>
                        Selecciona el servicio específico
                    </h2>

                </div>

                <div class="servicios-grid"
                     id="subserviciosGrid">

                    @for (int i = 0; i < subservicios.Count; i++)
                    {
                        var sub = subservicios[i];

                        var imagen =
                            $"/Images/servicio{((i + 1) % 6) + 1}.jpeg";

                        <button type="button"
                                class="servicio-card subservicio-card"
                                data-id-servicio="@sub.IdServicio"
                                data-id-servicio-padre="@sub.IdServicioPadre"
                                style="display:none;">

                            <img class="servicio-imagen"
                                 src="@imagen"
                                 alt="@sub.Servicio" />

                            <div class="servicio-info">

                                <h3>
                                    @sub.Servicio
                                </h3>

                                <p>
                                    Bs. @sub.CostoServicio.ToString("N2")
                                </p>

                            </div>

                        </button>
                    }

                </div>

            </div>


            <!-- DETALLE -->

            <div class="servicio-especifico"
                 id="detalleServicio"
                 style="display:none;">

                <div class="servicio-especifico-card">

                    <div>

                        <h3 id="detalleServicioNombre">
                        </h3>

                        <p id="detalleServicioDescripcion">
                        </p>

                        <small id="detalleServicioPrecio">
                        </small>

                    </div>

                    <span>
                        Seleccionado ✓
                    </span>

                </div>

            </div>

        </section>


        <!-- ================================================= -->
        <!-- 2. SUCURSAL -->
        <!-- ================================================= -->

        <section class="reserva-seccion"
                 id="seccionSucursal"
                 style="display:none;">

            <div class="seccion-titulo">

                <h2>
                    <span>2</span>
                    Selecciona tu Sucursal
                </h2>

                <label class="estado-pendiente"
                       id="estadoSucursal">
                    Pendiente
                </label>

            </div>


            <div class="sucursales-grid"
                 id="sucursalesGrid">

                @foreach (var sucursal in sucursales)
                {
                    var serviciosSucursal = string.Join(
                        ",",
                        opciones
                            .Where(x =>
                                x.IdSucursal == sucursal.IdSucursal)
                            .Select(x => x.IdServicio)
                            .Distinct()
                    );

                    <div class="sucursal-card"
                         data-id-sucursal="@sucursal.IdSucursal"
                         data-servicios="@serviciosSucursal">

                        <h3>
                            @sucursal.Sucursal
                        </h3>

                        <p class="direccion">
                            @sucursal.DireccionSucursal
                        </p>

                        <p>
                            Horario:
                            @(sucursal.HorarioApertura?.ToString(@"hh\:mm") ?? "--:--")
                            -
                            @(sucursal.HorarioCierre?.ToString(@"hh\:mm") ?? "--:--")
                        </p>

                        <button type="button"
                                class="btn-sucursal">

                            Seleccionar

                        </button>

                    </div>
                }

            </div>

            <p id="sinSucursales"
               style="display:none;">
                No hay sucursales disponibles para el servicio seleccionado.
            </p>

        </section>

        <!-- ================================================= -->
        <!-- 3. ESPECIALISTA Y HORARIO -->
        <!-- ================================================= -->

        <section class="reserva-seccion"
                 id="seccionEspecialista"
                 style="display:none;">

            <div class="seccion-titulo">

                <h2>
                    <span>3</span>
                    Selecciona tu Especialista y Horario
                </h2>

                <label class="estado-pendiente"
                       id="estadoEspecialista">
                    Pendiente
                </label>

            </div>


            <!-- ESPECIALISTAS -->

            <div class="especialistas-grid"
                 id="especialistasGrid">

                @foreach (var especialista in especialistas)
                {
                    var horario = especialista.HorarioEspecialista ?? "";

                    var diasHorario = horario.ToLowerInvariant();

                    <div class="especialista-card"
                         data-id-especialista="@especialista.IdEspecialista"
                         data-combinaciones="@(
                         string.Join(
                             "|",
                             opciones
                                 .Where(x =>
                                     x.IdEspecialista ==
                                     especialista.IdEspecialista)
                                 .Select(x =>
                                     $"{x.IdServicio}:{x.IdSucursal}")
                                 .Distinct()
                         )
                     )">

                        <img src="/Images/avatar.jpeg"
                             alt="@especialista.Especialista" />

                        <div class="especialista-info">

                            <h3>
                                @especialista.Especialista
                            </h3>

                            <p class="cargo">
                                @especialista.RolEspecialista
                            </p>

                            <p>
                                @(especialista.AniosExperiencia ?? 0)
                                años de experiencia
                            </p>


                            <!-- HORARIO -->

                            <div class="horario-especialista">

                                <strong>Horario:</strong>

                                @if (!string.IsNullOrWhiteSpace(horario))
                                {
                                    <span>
                                        @horario
                                    </span>
                                }
                                else
                                {
                                    <span>
                                        Horario no disponible
                                    </span>
                                }

                            </div>


                            <!-- DÍAS -->

                            <div class="dias-especialista">

                                <strong>
                                    Días disponibles:
                                </strong>

                                <div class="dias-botones">

                                    @if (
                                        diasHorario.Contains("lunes") ||
                                        diasHorario.Contains("lun")
                                    )
                                    {
                                        <button type="button"
                                                class="btn-dia-especialista"
                                                data-dia="1">
                                            Lun
                                        </button>
                                    }

                                    @if (
                                        diasHorario.Contains("martes") ||
                                        diasHorario.Contains("mar")
                                    )
                                    {
                                        <button type="button"
                                                class="btn-dia-especialista"
                                                data-dia="2">
                                            Mar
                                        </button>
                                    }

                                    @if (
                                        diasHorario.Contains("miércoles") ||
                                        diasHorario.Contains("miercoles") ||
                                        diasHorario.Contains("mié") ||
                                        diasHorario.Contains("mie")
                                    )
                                    {
                                        <button type="button"
                                                class="btn-dia-especialista"
                                                data-dia="3">
                                            Mié
                                        </button>
                                    }

                                    @if (
                                        diasHorario.Contains("jueves") ||
                                        diasHorario.Contains("jue")
                                    )
                                    {
                                        <button type="button"
                                                class="btn-dia-especialista"
                                                data-dia="4">
                                            Jue
                                        </button>
                                    }

                                    @if (
                                        diasHorario.Contains("viernes") ||
                                        diasHorario.Contains("vie")
                                    )
                                    {
                                        <button type="button"
                                                class="btn-dia-especialista"
                                                data-dia="5">
                                            Vie
                                        </button>
                                    }

                                    @if (
                                        diasHorario.Contains("sábado") ||
                                        diasHorario.Contains("sabado") ||
                                        diasHorario.Contains("sáb") ||
                                        diasHorario.Contains("sab")
                                    )
                                    {
                                        <button type="button"
                                                class="btn-dia-especialista"
                                                data-dia="6">
                                            Sáb
                                        </button>
                                    }

                                    @if (
                                        diasHorario.Contains("domingo") ||
                                        diasHorario.Contains("dom")
                                    )
                                    {
                                        <button type="button"
                                                class="btn-dia-especialista"
                                                data-dia="0">
                                            Dom
                                        </button>
                                    }

                                </div>

                            </div>


                            <!-- FECHA Y HORARIOS -->

                            <div class="horarios-especialista"
                                 data-horarios-especialista="@especialista.IdEspecialista">

                                <p>
                                    Selecciona uno de los días para consultar horarios.
                                </p>

                            </div>


                            <button type="button"
                                    class="btn-especialista">

                                Seleccionar

                            </button>

                        </div>

                    </div>
                }

            </div>


            <p id="sinEspecialistas"
               style="display:none;">

                No hay especialistas disponibles para esta combinación.

            </p>

        </section>


        <!-- ================================================= -->
        <!-- 4. PUNTOS -->
        <!-- ================================================= -->

        <section class="reserva-seccion"
                 id="seccionPuntos"
                 style="display:none;">

            <div class="seccion-titulo">

                <h2>
                    <span>4</span>
                    Tus Puntos L'Avielle
                </h2>

                <label class="estado-activo">
                    Activo
                </label>

            </div>


            <div class="puntos-card">

                <div class="puntos-superior">

                    <div>

                        <h3>
                            @Model.PuntosFidelidad.ToString("N0")
                            puntos disponibles
                        </h3>

                        <p>
                            Puedes usar tus puntos para obtener
                            descuentos en tu reserva.
                        </p>

                    </div>

                    <div class="porcentaje">
                        @(Model.PuntosFidelidad > 0 ? "100%" : "0%")
                    </div>

                </div>


                <div class="puntos-opcion">

                    <div>

                        <strong>
                            Usar puntos en esta reserva
                        </strong>

                    </div>

                    <label class="switch">

                        <input type="checkbox"
                               id="usarPuntos" />

                        <span class="slider"></span>

                    </label>

                </div>


                <div class="puntos-resumen"
                     id="resumenPuntos"
                     style="display:none;">

                    <span>
                        Puntos disponibles:
                        @Model.PuntosFidelidad.ToString("N0")
                    </span>

                    <strong id="textoDescuento">
                        0 puntos
                    </strong>

                </div>

            </div>

        </section>

        <!-- ================================================= -->
        <!-- 6. CONFIRMACIÓN -->
        <!-- ================================================= -->

        <section class="reserva-seccion confirmacion-seccion"
                 id="seccionConfirmacion"
                 style="display:none;">

            <div class="seccion-titulo">

                <h2>
                    <span>6</span>
                    Confirmación de tu Cita
                </h2>

                <label class="estado-pendiente"
                       id="estadoConfirmacion">
                    Pendiente
                </label>

            </div>


            <div class="confirmacion-card">

                <div class="confirmacion-contenido">


                    <!-- RESUMEN -->

                    <div class="resumen-cita">

                        <h3>
                            Resumen de tu reserva
                        </h3>


                        <div class="resumen-linea">

                            <span>
                                Servicio
                            </span>

                            <strong id="resumenServicio">
                                -
                            </strong>

                        </div>


                        <div class="resumen-linea">

                            <span>
                                Sucursal
                            </span>

                            <strong id="resumenSucursal">
                                -
                            </strong>

                        </div>


                        <div class="resumen-linea">

                            <span>
                                Especialista
                            </span>

                            <strong id="resumenEspecialista">
                                -
                            </strong>

                        </div>


                        <div class="resumen-linea">

                            <span>
                                Fecha
                            </span>

                            <strong id="resumenFecha">
                                -
                            </strong>

                        </div>


                        <div class="resumen-linea">

                            <span>
                                Hora
                            </span>

                            <strong id="resumenHora">
                                -
                            </strong>

                        </div>

                    </div>


                    <!-- PRECIO -->

                    <div class="resumen-precio">

                        <h3>
                            Detalle de pago
                        </h3>


                        <div class="precio-linea">

                            <span>
                                Servicio
                            </span>

                            <strong id="resumenPrecio">
                                Bs. 0.00
                            </strong>

                        </div>


                        <div class="precio-linea">

                            <span>
                                Descuento por puntos
                            </span>

                            <strong class="descuento"
                                    id="resumenDescuento">
                                - Bs. 0.00
                            </strong>

                        </div>


                        <div class="precio-total">

                            <span>
                                Total
                            </span>

                            <strong id="resumenTotal">
                                Bs. 0.00
                            </strong>

                        </div>


                        <p>
                            Los precios corresponden al servicio
                            seleccionado.
                        </p>

                    </div>

                </div>


                <div class="terminos">

                    <label>

                        <input type="checkbox"
                               id="aceptarTerminos" />

                        <span>
                            He leído y acepto los términos y condiciones
                            de reserva, políticas de cancelación y
                            privacidad de L'Avielle.
                        </span>

                    </label>

                </div>


                <div class="botones-confirmacion">

                    <button type="button"
                            class="btn-anterior"
                            id="btnAnterior">

                        ← Anterior

                    </button>


                    <button type="submit"
                            class="btn-pago"
                            id="btnConfirmar"
                            disabled>

                        Proceder al Pago →

                    </button>

                </div>

            </div>

        </section>

    </form>

</div>


<script>
    document.addEventListener("DOMContentLoaded", function () {

        // =====================================================
        // DATOS
        // =====================================================

        const opciones = @Html.Raw(
                        System.Text.Json.JsonSerializer.Serialize(opciones)
                        );

        let idServicio = 0;
        let idSucursal = 0;
        let idEspecialista = 0;

        let fechaSeleccionada = "";
        let horaSeleccionada = "";


        // =====================================================
        // ELEMENTOS
        // =====================================================

        const subserviciosContainer =
            document.getElementById("subserviciosContainer");

        const subserviciosGrid =
            document.getElementById("subserviciosGrid");

        const sucursalesGrid =
            document.getElementById("sucursalesGrid");

        const seccionSucursal =
            document.getElementById("seccionSucursal");

        const especialistasGrid =
            document.getElementById("especialistasGrid");

        const seccionEspecialista =
            document.getElementById("seccionEspecialista");

        const seccionPuntos =
            document.getElementById("seccionPuntos");

        const seccionConfirmacion =
            document.getElementById("seccionConfirmacion");

       

        // =====================================================
        // FUNCIONES GENERALES
        // =====================================================

        function mostrar(elemento) {

            if (elemento) {
                elemento.style.display = "block";
            }
        }


        function ocultar(elemento) {

            if (elemento) {
                elemento.style.display = "none";
            }
        }


        function limpiarPasosPosteriores() {

            idSucursal = 0;
            idEspecialista = 0;

            fechaSeleccionada = "";
            horaSeleccionada = "";

            document.getElementById("IdSucursal").value = "";
            document.getElementById("IdEspecialista").value = "";
            document.getElementById("FechaCita").value = "";
            document.getElementById("HoraCita").value = "";

            ocultar(seccionSucursal);
            ocultar(seccionEspecialista);
            ocultar(seccionPuntos);
            ocultar(seccionConfirmacion);

            document
                .querySelectorAll(".sucursal-card")
                .forEach(card => {

                    card.classList.remove("seleccionado");
                    card.style.display = "none";
                });


            document
                .querySelectorAll(".especialista-card")
                .forEach(card => {

                    card.classList.remove("seleccionado");
                    card.style.display = "none";
                });


            document
                .querySelectorAll(".horarios-especialista")
                .forEach(horario => {

                    horario.innerHTML =
                        "<p>Selecciona una fecha para ver horarios.</p>";
                });


            const btnConfirmar =
                document.getElementById("btnConfirmar");

            if (btnConfirmar) {
                btnConfirmar.disabled = true;
            }
        }


        // =====================================================
        // 1. SERVICIO PRINCIPAL
        // =====================================================

        document
            .querySelectorAll(".servicio-principal-card")
            .forEach(card => {

                card.addEventListener("click", function () {

                    const idPrincipal =
                        parseInt(
                            this.dataset.idServicioPrincipal
                        );


                    // Reiniciar selección anterior

                    idServicio = 0;

                    document.getElementById(
                        "IdServicio"
                    ).value = "";


                    limpiarPasosPosteriores();


                    // Marcar servicio principal

                    document
                        .querySelectorAll(
                            ".servicio-principal-card"
                        )
                        .forEach(x =>
                            x.classList.remove(
                                "seleccionado"
                            )
                        );


                    this.classList.add("seleccionado");


                    // Buscar subservicios

                    const hijos =
                        opciones.filter(x =>
                            Number(x.IdServicioPadre) ===
                            idPrincipal
                        );


                    // =================================================
                    // SI TIENE SUBSERVICIOS
                    // =================================================

                    if (hijos.length > 0) {

                        mostrar(
                            subserviciosContainer
                        );


                        subserviciosGrid
                            .querySelectorAll(
                                ".subservicio-card"
                            )
                            .forEach(sub => {

                                const idPadre =
                                    parseInt(
                                        sub.dataset
                                            .idServicioPadre
                                    );


                                if (
                                    idPadre ===
                                    idPrincipal
                                ) {

                                    sub.style.display =
                                        "block";

                                } else {

                                    sub.style.display =
                                        "none";
                                }


                                sub.classList.remove(
                                    "seleccionado"
                                );
                            });


                        document.getElementById(
                            "estadoServicio"
                        ).textContent =
                            "Selecciona una opción";


                        return;
                    }


                    // =================================================
                    // SI NO TIENE SUBSERVICIOS
                    // =================================================

                    ocultar(
                        subserviciosContainer
                    );


                    seleccionarServicio(
                        idPrincipal
                    );
                });
            });


        // =====================================================
        // 2. SERVICIO ESPECÍFICO
        // =====================================================

        document
            .querySelectorAll(".subservicio-card")
            .forEach(card => {

                card.addEventListener("click", function () {

                    idServicio =
                        parseInt(
                            this.dataset.idServicio
                        );


                    document.getElementById(
                        "IdServicio"
                    ).value =
                        idServicio;


                    document
                        .querySelectorAll(
                            ".subservicio-card"
                        )
                        .forEach(x =>
                            x.classList.remove(
                                "seleccionado"
                            )
                        );


                    this.classList.add(
                        "seleccionado"
                    );


                    // Mostrar sucursales

                    seleccionarServicio(
                        idServicio
                    );
                });
            });


        // =====================================================
        // 3. SELECCIONAR SERVICIO
        // =====================================================

        function seleccionarServicio(id) {

            idServicio = id;


            document.getElementById(
                "IdServicio"
            ).value =
                idServicio;


            // Limpiar sucursal, especialista,
            // fecha y hora anteriores

            idSucursal = 0;
            idEspecialista = 0;
            fechaSeleccionada = "";
            horaSeleccionada = "";


            document.getElementById(
                "IdSucursal"
            ).value = "";


            document.getElementById(
                "IdEspecialista"
            ).value = "";


            document.getElementById(
                "FechaCita"
            ).value = "";


            document.getElementById(
                "HoraCita"
            ).value = "";


            ocultar(seccionEspecialista);
            ocultar(seccionPuntos);
            ocultar(seccionConfirmacion);


            // =================================================
            // DETALLE DEL SERVICIO
            // =================================================

            const opcion =
                opciones.find(x =>
                    Number(x.IdServicio) ===
                    idServicio
                );


            if (opcion) {

                const nombre =
                    document.getElementById(
                        "detalleServicioNombre"
                    );

                const descripcion =
                    document.getElementById(
                        "detalleServicioDescripcion"
                    );

                const precio =
                    document.getElementById(
                        "detalleServicioPrecio"
                    );


                if (nombre) {
                    nombre.textContent =
                        opcion.Servicio || "";
                }


                if (descripcion) {
                    descripcion.textContent =
                        opcion.DescripcionServicio || "";
                }


                if (precio) {

                    precio.textContent =
                        "Bs. " +
                        Number(
                            opcion.CostoServicio || 0
                        ).toLocaleString(
                            "es-SV",
                            {
                                minimumFractionDigits: 2
                            }
                        );
                }


                mostrar(
                    document.getElementById(
                        "detalleServicio"
                    )
                );
            }


            // =================================================
            // MOSTRAR SUCURSALES
            // =================================================

            mostrarSucursales(
                idServicio
            );


            mostrar(
                seccionSucursal
            );


            setTimeout(function () {

                if (seccionSucursal) {

                    seccionSucursal.scrollIntoView({
                        behavior: "smooth",
                        block: "start"
                    });
                }

            }, 100);
        }


        // =====================================================
        // 4. MOSTRAR SUCURSALES
        // =====================================================

        function mostrarSucursales(id) {

            if (!sucursalesGrid) {
                return;
            }

            // Buscar el servicio seleccionado
            const servicioSeleccionado = opciones.find(x =>
                Number(x.IdServicio) === Number(id)
            );

            // Si es un subservicio, también tendremos en cuenta
            // el servicio principal.
            const idPadre =
                servicioSeleccionado &&
                    servicioSeleccionado.IdServicioPadre != null
                    ? Number(servicioSeleccionado.IdServicioPadre)
                    : Number(id);

            let encontradas = 0;

            sucursalesGrid
                .querySelectorAll(".sucursal-card")
                .forEach(card => {

                    const idSucursalCard =
                        Number(card.dataset.idSucursal);

                    const serviciosSucursal =
                        (card.dataset.servicios || "")
                            .split(",")
                            .map(x => Number(x))
                            .filter(x => !isNaN(x));

                    // La sucursal sirve si tiene:
                    // - el servicio específico seleccionado
                    // O
                    // - el servicio principal/padre
                    const tieneServicio =
                        serviciosSucursal.includes(Number(id)) ||
                        serviciosSucursal.includes(idPadre);

                    // Verificamos que exista una opción real
                    // para esa sucursal.
                    const existeEnOpciones =
                        opciones.some(x =>
                            Number(x.IdSucursal) === idSucursalCard &&
                            (
                                Number(x.IdServicio) === Number(id) ||
                                Number(x.IdServicio) === idPadre
                            )
                        );

                    const existe =
                        tieneServicio &&
                        existeEnOpciones;

                    if (existe) {

                        card.style.display = "block";

                        encontradas++;

                    } else {

                        card.style.display = "none";
                    }

                    card.classList.remove("seleccionado");
                });


            const sinSucursales =
                document.getElementById("sinSucursales");

            if (sinSucursales) {

                sinSucursales.style.display =
                    encontradas === 0
                        ? "block"
                        : "none";
            }


            console.log(
                "Servicio seleccionado:",
                id
            );

            console.log(
                "Servicio padre:",
                idPadre
            );

            console.log(
                "Sucursales encontradas:",
                encontradas
            );
        }

        // =====================================================
        // 5. SELECCIONAR SUCURSAL
        // =====================================================

        document
            .querySelectorAll(".btn-sucursal")
            .forEach(button => {

                button.addEventListener(
                    "click",
                    function (e) {

                        e.preventDefault();


                        const card =
                            this.closest(
                                ".sucursal-card"
                            );


                        if (!card) {
                            return;
                        }


                        idSucursal =
                            parseInt(
                                card.dataset
                                    .idSucursal
                            );


                        document.getElementById(
                            "IdSucursal"
                        ).value =
                            idSucursal;


                        document
                            .querySelectorAll(
                                ".sucursal-card"
                            )
                            .forEach(x =>
                                x.classList.remove(
                                    "seleccionado"
                                )
                            );


                        card.classList.add(
                            "seleccionado"
                        );


                        // Mostrar especialistas

                        mostrarEspecialistas();


                        setTimeout(function () {

                            if (
                                seccionEspecialista
                            ) {

                                seccionEspecialista
                                    .scrollIntoView({
                                        behavior:
                                            "smooth",
                                        block:
                                            "start"
                                    });
                            }

                        }, 100);
                    }
                );
            });

        // =====================================================
        // 6. MOSTRAR ESPECIALISTAS
        // =====================================================

        function mostrarEspecialistas() {

            if (!especialistasGrid) {
                return;
            }

            mostrar(seccionEspecialista);

            const servicioSeleccionado = opciones.find(x =>
                Number(x.IdServicio) === Number(idServicio)
            );

            const idPadre =
                servicioSeleccionado &&
                    servicioSeleccionado.IdServicioPadre != null
                    ? Number(servicioSeleccionado.IdServicioPadre)
                    : Number(idServicio);

            let encontrados = 0;

            especialistasGrid
                .querySelectorAll(".especialista-card")
                .forEach(card => {

                    const idEspecialistaCard =
                        Number(card.dataset.idEspecialista);

                    /*
                     * Permitimos el servicio seleccionado
                     * o su servicio padre.
                     */
                    const existe = opciones.some(x =>
                        Number(x.IdSucursal) === Number(idSucursal) &&
                        Number(x.IdEspecialista) === idEspecialistaCard &&
                        (
                            Number(x.IdServicio) === Number(idServicio) ||
                            Number(x.IdServicio) === Number(idPadre)
                        )
                    );

                    if (existe) {

                        card.style.display = "block";
                        encontrados++;

                    } else {

                        card.style.display = "none";
                    }

                    card.classList.remove("seleccionado");

                    card.querySelectorAll(".btn-dia-especialista")
                        .forEach(btn => {

                            btn.classList.remove(
                                "dia-seleccionado"
                            );

                            btn.disabled = false;
                        });

                    const horarios =
                        card.querySelector(
                            ".horarios-especialista"
                        );

                    if (horarios) {

                        horarios.innerHTML =
                            "<p>Selecciona un día para consultar disponibilidad.</p>";
                    }
                });


            const sinEspecialistas =
                document.getElementById(
                    "sinEspecialistas"
                );

            if (sinEspecialistas) {

                sinEspecialistas.style.display =
                    encontrados === 0
                        ? "block"
                        : "none";
            }


            console.log(
                "Especialistas encontrados:",
                encontrados
            );
        }


        // =====================================================
        // 7. FUNCIONES DE FECHA
        // =====================================================

        function formatearFecha(fecha) {

            return fecha.getFullYear() +
                "-" +
                String(
                    fecha.getMonth() + 1
                ).padStart(2, "0") +
                "-" +
                String(
                    fecha.getDate()
                ).padStart(2, "0");
        }


        function formatearFechaVisible(fecha) {

            return fecha.toLocaleDateString(
                "es-SV",
                {
                    weekday: "long",
                    day: "numeric",
                    month: "long"
                }
            );
        }


        // =====================================================
        // 8. OBTENER HORARIOS
        // =====================================================

        async function obtenerHoras(
            idEsp,
            fecha
        ) {

            const url =
                '@Url.Action("ObtenerHorasDisponibles", "Cliente")' +
                "?idEspecialista=" +
                encodeURIComponent(idEsp) +
                "&idSucursal=" +
                encodeURIComponent(idSucursal) +
                "&fecha=" +
                encodeURIComponent(fecha);


            const response =
                await fetch(url);


            if (!response.ok) {

                throw new Error(
                    "No se pudieron obtener los horarios."
                );
            }


            return await response.json();
        }


        // =====================================================
        // 9. BUSCAR PRÓXIMA FECHA DISPONIBLE
        // =====================================================

        async function buscarProximaDisponibilidad(
            idEsp,
            diaSemana
        ) {

            const hoy = new Date();

            hoy.setHours(
                0,
                0,
                0,
                0
            );


            /*
             * Busca ese día durante las
             * próximas 8 semanas.
             */
            for (
                let i = 0;
                i < 56;
                i++
            ) {

                const fecha =
                    new Date(hoy);

                fecha.setDate(
                    hoy.getDate() + i
                );


                if (
                    fecha.getDay() !==
                    diaSemana
                ) {

                    continue;
                }


                const fechaTexto =
                    formatearFecha(
                        fecha
                    );


                const horas =
                    await obtenerHoras(
                        idEsp,
                        fechaTexto
                    );


                /*
                 * Si encontró aunque sea
                 * una hora, esta es una
                 * fecha realmente disponible.
                 */
                if (
                    horas &&
                    horas.length > 0
                ) {

                    return {
                        fecha: fecha,
                        fechaTexto: fechaTexto,
                        horas: horas
                    };
                }
            }


            return null;
        }


        // =====================================================
        // 10. SELECCIONAR ESPECIALISTA
        // =====================================================

        document
            .querySelectorAll(
                ".btn-especialista"
            )
            .forEach(button => {

                button.addEventListener(
                    "click",
                    function (e) {

                        e.preventDefault();


                        const card =
                            this.closest(
                                ".especialista-card"
                            );


                        if (!card) {
                            return;
                        }


                        seleccionarEspecialista(
                            card
                        );
                    }
                );
            });


        function seleccionarEspecialista(
            card
        ) {

            idEspecialista =
                Number(
                    card.dataset.idEspecialista
                );


            document.getElementById(
                "IdEspecialista"
            ).value =
                idEspecialista;


            document
                .querySelectorAll(
                    ".especialista-card"
                )
                .forEach(x =>
                    x.classList.remove(
                        "seleccionado"
                    )
                );


            card.classList.add(
                "seleccionado"
            );


            /*
             * Limpiar una selección
             * anterior de horario.
             */
            horaSeleccionada = "";

            document.getElementById(
                "HoraCita"
            ).value = "";


            ocultar(
                seccionPuntos
            );

            ocultar(
                seccionConfirmacion
            );


            const horarios =
                card.querySelector(
                    ".horarios-especialista"
                );


            if (horarios) {

                horarios.innerHTML =
                    "<p>Ahora selecciona uno de los días disponibles.</p>";
            }


            const estado =
                document.getElementById(
                    "estadoEspecialista"
                );


            if (estado) {

                estado.textContent =
                    "Selecciona un día";
            }
        }


        // =====================================================
        // 11. SELECCIONAR DÍA
        // =====================================================

        document
            .querySelectorAll(
                ".btn-dia-especialista"
            )
            .forEach(button => {

                button.addEventListener(
                    "click",
                    async function (e) {

                        e.preventDefault();


                        const card =
                            this.closest(
                                ".especialista-card"
                            );


                        if (!card) {
                            return;
                        }


                        /*
                         * Seleccionamos automáticamente
                         * al especialista.
                         */
                        seleccionarEspecialista(
                            card
                        );


                        const botonesDia =
                            card.querySelectorAll(
                                ".btn-dia-especialista"
                            );


                        botonesDia.forEach(
                            x =>
                                x.classList.remove(
                                    "dia-seleccionado"
                                )
                        );


                        this.classList.add(
                            "dia-seleccionado"
                        );


                        const diaSemana =
                            Number(
                                this.dataset.dia
                            );


                        const horariosGrid =
                            card.querySelector(
                                ".horarios-especialista"
                            );


                        if (horariosGrid) {

                            horariosGrid.innerHTML =
                                "<p>Buscando la próxima fecha disponible...</p>";
                        }


                        this.disabled = true;


                        try {

                            const disponibilidad =
                                await buscarProximaDisponibilidad(
                                    idEspecialista,
                                    diaSemana
                                );


                            /*
                             * No encontró una fecha
                             * disponible en las próximas
                             * 8 semanas.
                             */
                            if (!disponibilidad) {

                                if (horariosGrid) {

                                    horariosGrid.innerHTML =
                                        "<p>No hay citas disponibles próximamente para este día.</p>";
                                }

                                return;
                            }


                            /*
                             * Guardar la fecha real
                             * encontrada.
                             */
                            fechaSeleccionada =
                                disponibilidad.fechaTexto;


                            document.getElementById(
                                "FechaCita"
                            ).value =
                                fechaSeleccionada;


                            mostrarHoras(
                                card,
                                disponibilidad.horas,
                                disponibilidad.fecha
                            );


                            const estado =
                                document.getElementById(
                                    "estadoEspecialista"
                                );


                            if (estado) {

                                estado.textContent =
                                    "Selecciona un horario";
                            }


                        } catch (error) {

                            console.error(
                                error
                            );


                            if (horariosGrid) {

                                horariosGrid.innerHTML =
                                    "<p>Error al consultar la disponibilidad.</p>";
                            }

                        } finally {

                            this.disabled =
                                false;
                        }
                    }
                );
            });


        // =====================================================
        // 12. MOSTRAR HORAS
        // =====================================================

        function mostrarHoras(
            card,
            horas,
            fecha
        ) {

            const horariosGrid =
                card.querySelector(
                    ".horarios-especialista"
                );


            if (!horariosGrid) {
                return;
            }


            horariosGrid.innerHTML =
                "";


            const titulo =
                document.createElement(
                    "p"
                );


            titulo.textContent =
                "Disponibilidad para " +
                formatearFechaVisible(
                    fecha
                ) +
                ":";


            horariosGrid.appendChild(
                titulo
            );


            horas.forEach(
                hora => {

                    const boton =
                        document.createElement(
                            "button"
                        );


                    boton.type =
                        "button";


                    boton.className =
                        "btn-hora";


                    boton.textContent =
                        String(hora)
                            .substring(
                                0,
                                5
                            );


                    boton.addEventListener(
                        "click",
                        function () {

                            horariosGrid
                                .querySelectorAll(
                                    ".btn-hora"
                                )
                                .forEach(
                                    x =>
                                        x.classList.remove(
                                            "hora-seleccionada"
                                        )
                                );


                            boton.classList.add(
                                "hora-seleccionada"
                            );


                            horaSeleccionada =
                                String(hora)
                                    .substring(
                                        0,
                                        5
                                    );


                            document.getElementById(
                                "HoraCita"
                            ).value =
                                horaSeleccionada;


                            const estado =
                                document.getElementById(
                                    "estadoEspecialista"
                                );


                            if (estado) {

                                estado.textContent =
                                    "Completado";
                            }


                            /*
                             * Pasar al siguiente paso.
                             */
                            mostrar(
                                seccionPuntos
                            );


                            actualizarConfirmacion();
                        }
                    );


                    horariosGrid.appendChild(
                        boton
                    );
                }
            );
        }


        // =====================================================
        // 10. PUNTOS
        // =====================================================

        const usarPuntos =
            document.getElementById(
                "usarPuntos"
            );


        if (usarPuntos) {

            usarPuntos.addEventListener(
                "change",
                function () {

                    const resumenPuntos =
                        document.getElementById(
                            "resumenPuntos"
                        );


                    if (resumenPuntos) {

                        resumenPuntos.style.display =
                            this.checked
                                ? "block"
                                : "none";
                    }


                    actualizarConfirmacion();
                }
            );
        }


        // =====================================================
        // 11. CONFIRMACIÓN
        // =====================================================

        function actualizarConfirmacion() {

            if (
                !idServicio ||
                !idSucursal ||
                !idEspecialista ||
                !fechaSeleccionada ||
                !horaSeleccionada
            ) {
                return;
            }


            const servicio =
                opciones.find(x =>
                    Number(x.IdServicio) ===
                    idServicio
                );


            const sucursal =
                opciones.find(x =>
                    Number(x.IdServicio) ===
                    idServicio &&
                    Number(x.IdSucursal) ===
                    idSucursal
                );


            const especialista =
                opciones.find(x =>
                    Number(x.IdServicio) ===
                    idServicio &&
                    Number(x.IdSucursal) ===
                    idSucursal &&
                    Number(x.IdEspecialista) ===
                    idEspecialista
                );


            document.getElementById(
                "resumenServicio"
            ).textContent =
                servicio?.Servicio || "-";


            document.getElementById(
                "resumenSucursal"
            ).textContent =
                sucursal?.Sucursal || "-";


            document.getElementById(
                "resumenEspecialista"
            ).textContent =
                especialista?.Especialista || "-";


            const fecha =
                new Date(
                    fechaSeleccionada +
                    "T00:00:00"
                );


            document.getElementById(
                "resumenFecha"
            ).textContent =
                fecha.toLocaleDateString(
                    "es-SV",
                    {
                        weekday:
                            "long",
                        day:
                            "numeric",
                        month:
                            "long",
                        year:
                            "numeric"
                    }
                );


            document.getElementById(
                "resumenHora"
            ).textContent =
                horaSeleccionada;


            const precio =
                Number(
                    servicio?.CostoServicio ||
                    0
                );


            const precioTexto =
                "Bs. " +
                precio.toLocaleString(
                    "es-SV",
                    {
                        minimumFractionDigits:
                            2
                    }
                );


            document.getElementById(
                "resumenPrecio"
            ).textContent =
                precioTexto;


            document.getElementById(
                "resumenTotal"
            ).textContent =
                precioTexto;


            mostrar(
                seccionConfirmacion
            );


            const aceptar =
                document.getElementById(
                    "aceptarTerminos"
                );


            const btnConfirmar =
                document.getElementById(
                    "btnConfirmar"
                );


            if (
                aceptar &&
                btnConfirmar
            ) {

                btnConfirmar.disabled =
                    !aceptar.checked;
            }
        }


        // =====================================================
        // TÉRMINOS
        // =====================================================

        const aceptarTerminos =
            document.getElementById(
                "aceptarTerminos"
            );


        if (aceptarTerminos) {

            aceptarTerminos.addEventListener(
                "change",
                actualizarConfirmacion
            );
        }


        // =====================================================
        // INICIALIZAR CALENDARIO
        // =====================================================


        console.log(
            "Reserva de cita cargada correctamente."
        );


        console.log(
            "Opciones:",
            opciones
        );

    });
</script>