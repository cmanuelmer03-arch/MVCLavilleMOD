@model Lavillemvc.Models.ReservarCita

@using System.Linq
@using System.Text.Json

@{
    ViewData["Title"] = "Reservar Cita";
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";

    var opciones = Model.OpcionesDisponibles ?? new List<Lavillemvc.Models.ReservarCita.ReservaOpcion>();

    var servicios = opciones
        .GroupBy(x => x.IdServicio)
        .Select(x => x.First())
        .ToList();

    var sucursales = opciones
        .GroupBy(x => x.IdSucursal)
        .Select(x => x.First())
        .ToList();

    var especialistas = opciones
        .GroupBy(x => x.IdEspecialista)
        .Select(x => x.First())
        .ToList();

    var opcionesJson = JsonSerializer.Serialize(opciones);

    var idServicioInicial = Model.IdServicio ?? 0;
    var idSucursalInicial = Model.IdSucursal ?? 0;
    var idEspecialistaInicial = Model.IdEspecialista ?? 0;

    var fechaInicial = Model.FechaCita.HasValue
        ? Model.FechaCita.Value.ToString("yyyy-MM-dd")
        : "";

    var horaInicial = Model.HoraCita.HasValue
        ? Model.HoraCita.Value.ToString(@"hh\:mm")
        : "";
}

<div class="reserva">

    <!-- ================================================= -->
    <!-- PASOS -->
    <!-- ================================================= -->

    <div class="reserva-pasos">

        <div class="paso activo" id="paso1">
            <span>1</span>
            Servicio
        </div>

        <div class="paso" id="paso2">
            <span>2</span>
            Sucursal
        </div>

        <div class="paso" id="paso3">
            <span>3</span>
            Especialista
        </div>

        <div class="paso" id="paso4">
            <span>4</span>
            Puntos
        </div>

        <div class="paso" id="paso5">
            <span>5</span>
            Horarios
        </div>

        <div class="paso" id="paso6">
            <span>6</span>
            Confirmación
        </div>

    </div>


    <!-- ================================================= -->
    <!-- FORMULARIO -->
    <!-- ================================================= -->

    <form asp-controller="Cliente"
          asp-action="ConfirmarReserva"
          method="post"
          id="formReserva">

        @Html.AntiForgeryToken()

        <input type="hidden"
               name="IdCliente"
               value="@Model.IdCliente" />

        <input type="hidden"
               name="IdServicio"
               id="IdServicio"
               value="@Model.IdServicio" />

        <input type="hidden"
               name="IdSucursal"
               id="IdSucursal"
               value="@Model.IdSucursal" />

        <input type="hidden"
               name="IdEspecialista"
               id="IdEspecialista"
               value="@Model.IdEspecialista" />

        <input type="hidden"
               name="FechaCita"
               id="FechaCita"
               value="@fechaInicial" />

        <input type="hidden"
               name="HoraCita"
               id="HoraCita"
               value="@horaInicial" />


        <!-- ================================================= -->
        <!-- 1. SERVICIO -->
        <!-- ================================================= -->

        <section class="reserva-seccion">

            <div class="seccion-titulo">

                <h2>
                    <span>1</span>
                    Selecciona tu Servicio
                </h2>

                <label class="estado-pendiente"
                       id="estadoServicio">
                    Pendiente
                </label>

            </div>


            <div class="servicios-grid"
                 id="serviciosGrid">

                @for (int i = 0; i < servicios.Count; i++)
                {
                    var servicio = servicios[i];

                    var imagen =
                        $"/Images/servicio{(i % 6) + 1}.jpeg";

                    <button type="button"
                            class="servicio-card"
                            data-id-servicio="@servicio.IdServicio">

                        <img class="servicio-imagen"
                             src="@imagen"
                             alt="@servicio.Servicio" />

                        <div class="servicio-info">

                            <h3>
                                @servicio.Servicio
                            </h3>

                            <p>
                                Bs. @servicio.CostoServicio.ToString("N2")
                            </p>

                        </div>

                    </button>
                }

                @if (!servicios.Any())
                {
                    <p>
                        No hay servicios disponibles actualmente.
                    </p>
                }

            </div>


            <!-- DETALLE DEL SERVICIO -->

            <div class="servicio-especifico"
                 id="detalleServicio"
                 style="display:none;">

                <div class="servicio-especifico-card">

                    <div>

                        <h3 id="detalleServicioNombre">
                        </h3>

                        <p id="detalleServicioDescripcion">
                        </p>

                        <small id="detalleServicioPrecio">
                        </small>

                    </div>

                    <span>
                        Seleccionado ✓
                    </span>

                </div>

            </div>

        </section>


        <!-- ================================================= -->
        <!-- 2. SUCURSAL -->
        <!-- ================================================= -->

        <section class="reserva-seccion"
                 id="seccionSucursal"
                 style="display:none;">

            <div class="seccion-titulo">

                <h2>
                    <span>2</span>
                    Selecciona tu Sucursal
                </h2>

                <label class="estado-pendiente"
                       id="estadoSucursal">
                    Pendiente
                </label>

            </div>


            <div class="sucursales-grid"
                 id="sucursalesGrid">

                @foreach (var sucursal in sucursales)
                {
                    var serviciosSucursal = string.Join(
                        ",",
                        opciones
                            .Where(x =>
                                x.IdSucursal == sucursal.IdSucursal)
                            .Select(x => x.IdServicio)
                            .Distinct()
                    );

                    <div class="sucursal-card"
                         data-id-sucursal="@sucursal.IdSucursal"
                         data-servicios="@serviciosSucursal">

                        <h3>
                            @sucursal.Sucursal
                        </h3>

                        <p class="direccion">
                            @sucursal.DireccionSucursal
                        </p>

                        <p>
                            Horario:
                            @(sucursal.HorarioApertura?.ToString(@"hh\:mm") ?? "--:--")
                            -
                            @(sucursal.HorarioCierre?.ToString(@"hh\:mm") ?? "--:--")
                        </p>

                        <button type="button"
                                class="btn-sucursal">

                            Seleccionar

                        </button>

                    </div>
                }

            </div>

            <p id="sinSucursales"
               style="display:none;">
                No hay sucursales disponibles para el servicio seleccionado.
            </p>

        </section>


        <!-- ================================================= -->
        <!-- 3. ESPECIALISTA -->
        <!-- ================================================= -->

        <section class="reserva-seccion"
                 id="seccionEspecialista"
                 style="display:none;">

            <div class="seccion-titulo">

                <h2>
                    <span>3</span>
                    Selecciona tu Especialista
                </h2>

                <label class="estado-pendiente"
                       id="estadoEspecialista">
                    Pendiente
                </label>

            </div>


            <div class="especialistas-grid"
                 id="especialistasGrid">

                @foreach (var especialista in especialistas)
                {
                    var combinaciones = string.Join(
                        "|",
                        opciones
                            .Where(x =>
                                x.IdEspecialista == especialista.IdEspecialista)
                            .Select(x =>
                                $"{x.IdServicio}:{x.IdSucursal}")
                            .Distinct()
                    );

                    <div class="especialista-card"
                         data-id-especialista="@especialista.IdEspecialista"
                         data-combinaciones="@combinaciones">

                        <img src="/Images/avatar.jpeg"
                             alt="@especialista.Especialista" />

                        <div class="especialista-info">

                            <h3>
                                @especialista.Especialista
                            </h3>

                            <p class="cargo">
                                @especialista.RolEspecialista
                            </p>

                            <p>
                                @(especialista.AniosExperiencia ?? 0)
                                años de experiencia
                            </p>

                            @if (!string.IsNullOrWhiteSpace(
                                especialista.HorarioEspecialista))
                            {
                                <p>
                                    @especialista.HorarioEspecialista
                                </p>
                            }

                            <button type="button"
                                    class="btn-especialista">

                                Seleccionar

                            </button>

                        </div>

                    </div>
                }

            </div>

            <p id="sinEspecialistas"
               style="display:none;">
                No hay especialistas disponibles para esta combinación.
            </p>

        </section>


        <!-- ================================================= -->
        <!-- 4. PUNTOS -->
        <!-- ================================================= -->

        <section class="reserva-seccion"
                 id="seccionPuntos"
                 style="display:none;">

            <div class="seccion-titulo">

                <h2>
                    <span>4</span>
                    Tus Puntos L'Avielle
                </h2>

                <label class="estado-activo">
                    Activo
                </label>

            </div>


            <div class="puntos-card">

                <div class="puntos-superior">

                    <div>

                        <h3>
                            @Model.PuntosFidelidad.ToString("N0")
                            puntos disponibles
                        </h3>

                        <p>
                            Puedes usar tus puntos para obtener
                            descuentos en tu reserva.
                        </p>

                    </div>

                    <div class="porcentaje">
                        @(Model.PuntosFidelidad > 0 ? "100%" : "0%")
                    </div>

                </div>


                <div class="puntos-opcion">

                    <div>

                        <strong>
                            Usar puntos en esta reserva
                        </strong>

                    </div>

                    <label class="switch">

                        <input type="checkbox"
                               id="usarPuntos" />

                        <span class="slider"></span>

                    </label>

                </div>


                <div class="puntos-resumen"
                     id="resumenPuntos"
                     style="display:none;">

                    <span>
                        Puntos disponibles:
                        @Model.PuntosFidelidad.ToString("N0")
                    </span>

                    <strong id="textoDescuento">
                        0 puntos
                    </strong>

                </div>

            </div>

        </section>


        <!-- ================================================= -->
        <!-- 5. FECHA Y HORA -->
        <!-- ================================================= -->

        <section class="reserva-seccion"
                 id="seccionFecha"
                 style="display:none;">

            <div class="seccion-titulo">

                <h2>
                    <span>5</span>
                    Selecciona Fecha y Hora
                </h2>

                <label class="estado-pendiente"
                       id="estadoFecha">
                    Pendiente
                </label>

            </div>


            <div class="fecha-hora-grid">


                <!-- CALENDARIO -->

                <div class="calendario-card">

                    <div class="calendario-header">

                        <button type="button"
                                class="btn-mes"
                                id="mesAnterior">
                            ‹
                        </button>

                        <strong id="mesActual">
                        </strong>

                        <button type="button"
                                class="btn-mes"
                                id="mesSiguiente">
                            ›
                        </button>

                    </div>


                    <table class="calendario-real">

                        <thead>

                            <tr>

                                <th>L</th>
                                <th>M</th>
                                <th>M</th>
                                <th>J</th>
                                <th>V</th>
                                <th>S</th>
                                <th>D</th>

                            </tr>

                        </thead>

                        <tbody id="calendarioBody">
                        </tbody>

                    </table>

                </div>


                <!-- HORARIOS -->

                <div class="horarios-card">

                    <div class="horarios-header">

                        <strong id="tituloHorarios">
                            Selecciona una fecha
                        </strong>

                        <span id="fechaHorario">
                            --
                        </span>

                    </div>


                    <div class="horarios-grid"
                         id="horariosGrid">

                        <p>
                            Primero selecciona una fecha.
                        </p>

                    </div>

                </div>

            </div>

        </section>


        <!-- ================================================= -->
        <!-- 6. CONFIRMACIÓN -->
        <!-- ================================================= -->

        <section class="reserva-seccion confirmacion-seccion"
                 id="seccionConfirmacion"
                 style="display:none;">

            <div class="seccion-titulo">

                <h2>
                    <span>6</span>
                    Confirmación de tu Cita
                </h2>

                <label class="estado-pendiente"
                       id="estadoConfirmacion">
                    Pendiente
                </label>

            </div>


            <div class="confirmacion-card">

                <div class="confirmacion-contenido">


                    <!-- RESUMEN -->

                    <div class="resumen-cita">

                        <h3>
                            Resumen de tu reserva
                        </h3>


                        <div class="resumen-linea">

                            <span>
                                Servicio
                            </span>

                            <strong id="resumenServicio">
                                -
                            </strong>

                        </div>


                        <div class="resumen-linea">

                            <span>
                                Sucursal
                            </span>

                            <strong id="resumenSucursal">
                                -
                            </strong>

                        </div>


                        <div class="resumen-linea">

                            <span>
                                Especialista
                            </span>

                            <strong id="resumenEspecialista">
                                -
                            </strong>

                        </div>


                        <div class="resumen-linea">

                            <span>
                                Fecha
                            </span>

                            <strong id="resumenFecha">
                                -
                            </strong>

                        </div>


                        <div class="resumen-linea">

                            <span>
                                Hora
                            </span>

                            <strong id="resumenHora">
                                -
                            </strong>

                        </div>

                    </div>


                    <!-- PRECIO -->

                    <div class="resumen-precio">

                        <h3>
                            Detalle de pago
                        </h3>


                        <div class="precio-linea">

                            <span>
                                Servicio
                            </span>

                            <strong id="resumenPrecio">
                                Bs. 0.00
                            </strong>

                        </div>


                        <div class="precio-linea">

                            <span>
                                Descuento por puntos
                            </span>

                            <strong class="descuento"
                                    id="resumenDescuento">
                                - Bs. 0.00
                            </strong>

                        </div>


                        <div class="precio-total">

                            <span>
                                Total
                            </span>

                            <strong id="resumenTotal">
                                Bs. 0.00
                            </strong>

                        </div>


                        <p>
                            Los precios corresponden al servicio
                            seleccionado.
                        </p>

                    </div>

                </div>


                <div class="terminos">

                    <label>

                        <input type="checkbox"
                               id="aceptarTerminos" />

                        <span>
                            He leído y acepto los términos y condiciones
                            de reserva, políticas de cancelación y
                            privacidad de L'Avielle.
                        </span>

                    </label>

                </div>


                <div class="botones-confirmacion">

                    <button type="button"
                            class="btn-anterior"
                            id="btnAnterior">

                        ← Anterior

                    </button>


                    <button type="submit"
                            class="btn-pago"
                            id="btnConfirmar"
                            disabled>

                        Confirmar Reserva →

                    </button>

                </div>

            </div>

        </section>

    </form>

</div>


<script>

    /* =========================================================
       DATOS DE LA BASE DE DATOS
       ========================================================= */

    const opciones = @Html.Raw(opcionesJson);


    /* =========================================================
       ESTADO ACTUAL
       ========================================================= */

    let idServicio = @(idServicioInicial);
    let idSucursal = @(idSucursalInicial);
    let idEspecialista = @(idEspecialistaInicial);

    let fechaSeleccionada = "@fechaInicial";
    let horaSeleccionada = "@horaInicial";

    let mesActual = new Date();

    if (fechaSeleccionada) {

        const partes = fechaSeleccionada.split("-");

        if (partes.length === 3) {

            mesActual = new Date(
                parseInt(partes[0]),
                parseInt(partes[1]) - 1,
                1
            );

        }

    }


    /* =========================================================
       ELEMENTOS
       ========================================================= */

    const seccionSucursal =
        document.getElementById("seccionSucursal");

    const seccionEspecialista =
        document.getElementById("seccionEspecialista");

    const seccionPuntos =
        document.getElementById("seccionPuntos");

    const seccionFecha =
        document.getElementById("seccionFecha");

    const seccionConfirmacion =
        document.getElementById("seccionConfirmacion");


    /* =========================================================
       SERVICIO
       ========================================================= */

    document
        .querySelectorAll(".servicio-card")
        .forEach(card => {

            card.addEventListener("click", function () {

                idServicio =
                    parseInt(this.dataset.idServicio);

                document.getElementById("IdServicio").value =
                    idServicio;


                document
                    .querySelectorAll(".servicio-card")
                    .forEach(x =>
                        x.classList.remove("seleccionado")
                    );

                this.classList.add("seleccionado");


                const opcion =
                    opciones.find(x =>
                        x.IdServicio === idServicio
                    );

                if (opcion) {

                    document.getElementById(
                        "detalleServicioNombre"
                    ).textContent =
                        opcion.Servicio;

                    document.getElementById(
                        "detalleServicioDescripcion"
                    ).textContent =
                        opcion.DescripcionServicio || "";

                    document.getElementById(
                        "detalleServicioPrecio"
                    ).textContent =
                        "Bs. " +
                        Number(opcion.CostoServicio)
                            .toFixed(2);

                    document.getElementById(
                        "detalleServicio"
                    ).style.display = "block";

                }


                resetearDesdeSucursal();

                filtrarSucursales();

                seccionSucursal.style.display = "block";

                marcarPaso("paso2");

            });

        });


    /* =========================================================
       SUCURSALES
       ========================================================= */

    function filtrarSucursales() {

        let cantidad = 0;

        document
            .querySelectorAll(".sucursal-card")
            .forEach(card => {

                const ids =
                    card.dataset.servicios
                        .split(",")
                        .map(Number);

                const disponible =
                    ids.includes(idServicio);

                if (disponible) {

                    card.style.display = "";
                    cantidad++;

                } else {

                    card.style.display = "none";

                }

            });


        document.getElementById(
            "sinSucursales"
        ).style.display =
            cantidad === 0 ? "block" : "none";

    }


    document
        .querySelectorAll(".btn-sucursal")
        .forEach(button => {

            button.addEventListener("click", function () {

                const card =
                    this.closest(".sucursal-card");

                idSucursal =
                    parseInt(card.dataset.idSucursal);

                document.getElementById("IdSucursal").value =
                    idSucursal;


                document
                    .querySelectorAll(".sucursal-card")
                    .forEach(x =>
                        x.classList.remove("seleccionado")
                    );

                card.classList.add("seleccionado");


                resetearDesdeEspecialista();

                filtrarEspecialistas();

                seccionEspecialista.style.display =
                    "block";

                marcarPaso("paso3");

            });

        });


    /* =========================================================
       ESPECIALISTAS
       ========================================================= */

    function filtrarEspecialistas() {

        let cantidad = 0;

        document
            .querySelectorAll(".especialista-card")
            .forEach(card => {

                const combinaciones =
                    card.dataset.combinaciones
                        .split("|");

                const combinacion =
                    idServicio + ":" + idSucursal;

                const disponible =
                    combinaciones.includes(combinacion);

                if (disponible) {

                    card.style.display = "";
                    cantidad++;

                } else {

                    card.style.display = "none";

                }

            });


        document.getElementById(
            "sinEspecialistas"
        ).style.display =
            cantidad === 0 ? "block" : "none";

    }


    document
        .querySelectorAll(".btn-especialista")
        .forEach(button => {

            button.addEventListener("click", function () {

                const card =
                    this.closest(".especialista-card");

                idEspecialista =
                    parseInt(card.dataset.idEspecialista);

                document.getElementById(
                    "IdEspecialista"
                ).value =
                    idEspecialista;


                document
                    .querySelectorAll(".especialista-card")
                    .forEach(x =>
                        x.classList.remove("seleccionado")
                    );

                card.classList.add("seleccionado");


                seccionPuntos.style.display =
                    "block";

                seccionFecha.style.display =
                    "block";

                marcarPaso("paso4");

                cargarCalendario();

            });

        });


    /* =========================================================
       PUNTOS
       ========================================================= */

    const usarPuntos =
        document.getElementById("usarPuntos");

    usarPuntos.addEventListener("change", function () {

        const resumen =
            document.getElementById("resumenPuntos");

        if (this.checked) {

            resumen.style.display = "flex";

            document.getElementById(
                "textoDescuento"
            ).textContent =
                "Puntos disponibles: " +
                Number(@Model.PuntosFidelidad)
                    .toLocaleString();

        } else {

            resumen.style.display = "none";

        }

        actualizarResumen();

    });


    /* =========================================================
       CALENDARIO
       ========================================================= */

    const nombresMeses = [
        "Enero",
        "Febrero",
        "Marzo",
        "Abril",
        "Mayo",
        "Junio",
        "Julio",
        "Agosto",
        "Septiembre",
        "Octubre",
        "Noviembre",
        "Diciembre"
    ];


    function cargarCalendario() {

        const year =
            mesActual.getFullYear();

        const month =
            mesActual.getMonth();


        document.getElementById(
            "mesActual"
        ).textContent =
            nombresMeses[month] + " " + year;


        const tbody =
            document.getElementById(
                "calendarioBody"
            );

        tbody.innerHTML = "";


        const primerDia =
            new Date(
                year,
                month,
                1
            );


        let diaSemana =
            primerDia.getDay();

        /*
         * JavaScript:
         * domingo = 0
         * lunes = 1
         */

        diaSemana =
            diaSemana === 0
                ? 6
                : diaSemana - 1;


        const diasMes =
            new Date(
                year,
                month + 1,
                0
            ).getDate();


        let fila =
            document.createElement("tr");


        for (let i = 0; i < diaSemana; i++) {

            const td =
                document.createElement("td");

            fila.appendChild(td);

        }


        for (
            let dia = 1;
            dia <= diasMes;
            dia++
        ) {

            if (fila.children.length === 7) {

                tbody.appendChild(fila);

                fila =
                    document.createElement("tr");

            }


            const td =
                document.createElement("td");

            const enlace =
                document.createElement("a");

            enlace.href = "#";

            enlace.textContent = dia;


            const fecha =
                new Date(
                    year,
                    month,
                    dia
                );


            const hoy =
                new Date();

            hoy.setHours(0, 0, 0, 0);


            if (fecha < hoy) {

                enlace.style.color =
                    "#d8cec6";

                enlace.style.pointerEvents =
                    "none";

            } else {

                enlace.addEventListener(
                    "click",
                    function (event) {

                        event.preventDefault();

                        seleccionarFecha(
                            year,
                            month,
                            dia,
                            enlace
                        );

                    }
                );

            }


            if (
                fechaSeleccionada ===
                formatearFecha(fecha)
            ) {

                enlace.style.background =
                    "#cba45b";

                enlace.style.color =
                    "white";

            }


            td.appendChild(enlace);

            fila.appendChild(td);

        }


        while (
            fila.children.length < 7
        ) {

            fila.appendChild(
                document.createElement("td")
            );

        }


        tbody.appendChild(fila);

    }


    function seleccionarFecha(
        year,
        month,
        day,
        enlace
    ) {

        const fecha =
            new Date(
                year,
                month,
                day
            );


        fechaSeleccionada =
            formatearFecha(fecha);


        document.getElementById(
            "FechaCita"
        ).value =
            fechaSeleccionada;


        document
            .querySelectorAll(
                ".calendario-real a"
            )
            .forEach(x => {

                x.style.background =
                    "";

                x.style.color =
                    "";

            });


        enlace.style.background =
            "#cba45b";

        enlace.style.color =
            "white";


        horaSeleccionada = "";

        document.getElementById(
            "HoraCita"
        ).value = "";


        cargarHorasDisponibles();

    }


    function formatearFecha(fecha) {

        const year =
            fecha.getFullYear();

        const month =
            String(
                fecha.getMonth() + 1
            ).padStart(2, "0");

        const day =
            String(
                fecha.getDate()
            ).padStart(2, "0");


        return `${year}-${month}-${day}`;

    }


    document.getElementById(
        "mesAnterior"
    ).addEventListener(
        "click",
        function () {

            mesActual.setMonth(
                mesActual.getMonth() - 1
            );

            cargarCalendario();

        }
    );


    document.getElementById(
        "mesSiguiente"
    ).addEventListener(
        "click",
        function () {

            mesActual.setMonth(
                mesActual.getMonth() + 1
            );

            cargarCalendario();

        }
    );


    /* =========================================================
       HORARIOS
       ========================================================= */

    async function cargarHorasDisponibles() {

        const grid =
            document.getElementById(
                "horariosGrid"
            );


        if (
            !idEspecialista ||
            !idSucursal ||
            !fechaSeleccionada
        ) {

            grid.innerHTML =
                "<p>Selecciona una fecha.</p>";

            return;

        }


        grid.innerHTML =
            "<p>Consultando disponibilidad...</p>";


        document.getElementById(
            "tituloHorarios"
        ).textContent =
            "Horarios disponibles";


        document.getElementById(
            "fechaHorario"
        ).textContent =
            fechaSeleccionada;


        try {

            const url =
                '@Url.Action("ObtenerHorasDisponibles", "Cliente")'
                +
                '?idEspecialista='
                +
                encodeURIComponent(idEspecialista)
                +
                '&idSucursal='
                +
                encodeURIComponent(idSucursal)
                +
                '&fecha='
                +
                encodeURIComponent(fechaSeleccionada);


            const respuesta =
                await fetch(url);


            if (!respuesta.ok) {

                throw new Error(
                    "No se pudieron obtener los horarios."
                );

            }


            const horas =
                await respuesta.json();


            grid.innerHTML = "";


            if (
                !horas ||
                horas.length === 0
            ) {

                grid.innerHTML =
                    "<p>No hay horarios disponibles para esta fecha.</p>";

                return;

            }


            horas.forEach(hora => {

                let textoHora =
                    String(hora);


                if (
                    textoHora.length >= 5
                ) {

                    textoHora =
                        textoHora.substring(
                            0,
                            5
                        );

                }


                const button =
                    document.createElement(
                        "button"
                    );

                button.type =
                    "button";

                button.textContent =
                    textoHora;


                if (
                    horaSeleccionada ===
                    textoHora
                ) {

                    button.classList.add(
                        "hora-seleccionada"
                    );

                }


                button.addEventListener(
                    "click",
                    function () {

                        document
                            .querySelectorAll(
                                "#horariosGrid button"
                            )
                            .forEach(x =>
                                x.classList.remove(
                                    "hora-seleccionada"
                                )
                            );


                        this.classList.add(
                            "hora-seleccionada"
                        );


                        horaSeleccionada =
                            textoHora;


                        document.getElementById(
                            "HoraCita"
                        ).value =
                            horaSeleccionada;


                        seccionConfirmacion
                            .style.display =
                            "block";


                        marcarPaso("paso6");

                        actualizarResumen();

                    }
                );


                grid.appendChild(button);

            });

        }
        catch (error) {

            grid.innerHTML =
                "<p>Error al consultar los horarios disponibles.</p>";

            console.error(error);

        }

    }


    /* =========================================================
       RESUMEN
       ========================================================= */

    function actualizarResumen() {

        const opcion =
            opciones.find(x =>
                x.IdServicio === idServicio &&
                x.IdSucursal === idSucursal &&
                x.IdEspecialista === idEspecialista
            );


        if (!opcion) {

            return;

        }


        document.getElementById(
            "resumenServicio"
        ).textContent =
            opcion.Servicio;


        document.getElementById(
            "resumenSucursal"
        ).textContent =
            opcion.Sucursal;


        document.getElementById(
            "resumenEspecialista"
        ).textContent =
            opcion.Especialista;


        document.getElementById(
            "resumenFecha"
        ).textContent =
            fechaSeleccionada || "-";


        document.getElementById(
            "resumenHora"
        ).textContent =
            horaSeleccionada || "-";


        const precio =
            Number(
                opcion.CostoServicio
            );


        document.getElementById(
            "resumenPrecio"
        ).textContent =
            "Bs. " +
            precio.toFixed(2);


        /*
         * La aplicación real del descuento
         * debe hacerse también en el Controller.
         */

        document.getElementById(
            "resumenDescuento"
        ).textContent =
            "- Bs. 0.00";


        document.getElementById(
            "resumenTotal"
        ).textContent =
            "Bs. " +
            precio.toFixed(2);


        comprobarFormulario();

    }


    /* =========================================================
       VALIDACIÓN
       ========================================================= */

    const terminos =
        document.getElementById(
            "aceptarTerminos"
        );


    terminos.addEventListener(
        "change",
        comprobarFormulario
    );


    function comprobarFormulario() {

        const completo =
            idServicio > 0 &&
            idSucursal > 0 &&
            idEspecialista > 0 &&
            fechaSeleccionada !== "" &&
            horaSeleccionada !== "" &&
            terminos.checked;


        document.getElementById(
            "btnConfirmar"
        ).disabled =
            !completo;

    }


