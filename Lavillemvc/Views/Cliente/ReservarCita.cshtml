        horaSeleccionada = "";


        document.getElementById(
            "IdEspecialista"
        ).value = "";


        document.getElementById(
            "FechaCita"
        ).value = "";


        document.getElementById(
            "HoraCita"
        ).value = "";


        seccionPuntos.style.display =
            "none";

        seccionFecha.style.display =
            "none";

        seccionConfirmacion.style.display =
            "none";

    }


    /* =========================================================
       PASOS
       ========================================================= */

    function marcarPaso(id) {

        const pasos =
            document.querySelectorAll(
                ".paso"
            );


        pasos.forEach(paso =>
            paso.classList.remove(
                "activo"
            )
        );


        const actual =
            document.getElementById(id);


        if (actual) {

            actual.classList.add(
                "activo"
            );

        }

    }


    /* =========================================================
       INICIALIZACIÓN
       ========================================================= */

    document.addEventListener(
        "DOMContentLoaded",
        function () {

            cargarCalendario();


            if (idServicio > 0) {

                const cardServicio =
                    document.querySelector(
                        `.servicio-card[data-id-servicio="${idServicio}"]`
                    );

                if (cardServicio) {

                    cardServicio.click();

                }

            }

        }
    );

</script>