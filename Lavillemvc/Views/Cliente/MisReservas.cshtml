@model List<Lavillemvc.Models.ClienteProcesoPago>

@{
    ViewData["Title"] = "Mis Reservas";
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";

    DateOnly hoy = DateOnly.FromDateTime(DateTime.Today);
}

<div class="reservas-page">

    <div class="reservas-header">

        <div>
            <h1>Mis Reservas</h1>

            <p>
                Administra tus próximas citas y revisa tu historial.
            </p>
        </div>

        <div class="reservas-filtros">

            <button type="button" class="filtro">
                Todas
            </button>

            <button type="button" class="filtro activo">
                Próximas
            </button>

            <button type="button" class="filtro">
                Completadas
            </button>

            <button type="button" class="filtro">
                Canceladas
            </button>

        </div>

    </div>


    <!-- ================================= -->
    <!-- PRÓXIMAS CITAS -->
    <!-- ================================= -->

    <section class="proximas-reservas">

        <h2>Próximas Citas</h2>

        <div class="reservas-grid">

            @foreach (var reserva in Model)
            {
    <div class="reserva-card">

        <div class="reserva-card-header">

            <div class="reserva-servicio">

                <span class="reserva-icono">
                    ✂
                </span>

                <div>

                    <h3>
                        @reserva.ServicioPrincipal
                    </h3>

                    <p>
                        Con
                        @(reserva.NombreEspecialista
                            ?? "Especialista no especificado")
                    </p>

                </div>

            </div>

            @if (reserva.EstadoReserva.Equals(
                "Confirmada",
                StringComparison.OrdinalIgnoreCase))
            {
                <span class="estado confirmado">
                    Confirmada
                </span>
            }
            else
            {
                <span class="estado pendiente">
                    Pendiente
                </span>
            }

        </div>


        <div class="reserva-info">

            <div>

                <small>
                    FECHA Y HORA
                </small>

                <strong>
                    @reserva.FechaCita.ToString("dd/MM/yyyy"),
                    @reserva.HoraCita.ToString("HH:mm")
                </strong>

            </div>


            <div>

                <small>
                    SUCURSAL
                </small>

                <strong>
                    @(reserva.NombreSucursal
                        ?? "Sucursal no especificada")
                </strong>

            </div>

        </div>


        <div class="reserva-acciones">

            <form asp-controller="Cliente"
                  asp-action="CancelarReserva"
                  method="post">

                <input type="hidden"
                       name="idCita"
                       value="@reserva.IdCita" />

                <button type="submit"
                        class="btn-cancelar"
                        onclick="return confirm('¿Seguro que deseas cancelar esta cita?');">

                    Cancelar

                </button>

            </form>

        </div>

    </div>
}

        </div>

    </section>


    <!-- ================================= -->
    <!-- HISTORIAL -->
    <!-- ================================= -->

    <section class="historial-reservas">

        <h2>Historial de Citas</h2>

        <div class="historial-lista">

            @foreach (var reserva in Model)
            {
                bool esHistorial =
                    reserva.FechaCita < hoy
                    ||
                    reserva.EstadoReserva == null
                    ||
                    reserva.EstadoReserva.Equals(
                        "Cancelada",
                        StringComparison.OrdinalIgnoreCase)
                    ||
                    reserva.EstadoReserva.Equals(
                        "Completada",
                        StringComparison.OrdinalIgnoreCase);

                if (esHistorial)
                {
                    <div class="historial-fila">

                        <div class="historial-servicio">

                            <strong>
                                @reserva.ServicioPrincipal
                            </strong>

                            <span>
                                Con
                                @(reserva.NombreEspecialista
                                    ?? "Especialista no especificado")
                            </span>

                        </div>


                        <div class="historial-fecha">

                            @reserva.FechaCita.ToString("dd/MM/yyyy")

                        </div>


                        @if (reserva.EstadoReserva != null &&
                            reserva.EstadoReserva.Equals(
                                "Cancelada",
                                StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="estado historial-cancelada">
                                Cancelada
                            </span>
                        }
                        else
                        {
                            <span class="estado historial-completada">
                                Completada
                            </span>
                        }


                        <a href="@Url.Action("ReservarCita", "Cliente")">
                            Reservar de Nuevo
                        </a>

                    </div>
                }
            }

        </div>

    </section>


    <!-- ================================= -->
    <!-- NUEVA RESERVA -->
    <!-- ================================= -->

    <div class="reservar-nueva">

        <a href="@Url.Action("ReservarCita", "Cliente")">
            Reservar Nueva Cita
        </a>

    </div>

</div>