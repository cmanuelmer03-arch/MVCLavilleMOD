@using System.Text.Json
@using System.Globalization

@model Lavillemvc.Models.ClientePromosMembresias

@{
    ViewData["Title"] = "Promociones";
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";


    // ==========================================
    // LEER PROMOCIONES DESDE EL JSON DE LA BD
    // ==========================================

    var promociones =
        new List<Dictionary<string, JsonElement>>();

    var ofertas =
        new List<Dictionary<string, JsonElement>>();

    var planes =
        new List<Dictionary<string, JsonElement>>();


    try
    {
        var lista =
            JsonSerializer.Deserialize<
                List<Dictionary<string, JsonElement>>
            >(
                Model.PromocionesActivasJson ?? "[]"
            );

        if (lista != null)
        {
            promociones = lista;
        }
    }
    catch
    {
    }


    try
    {
        var lista =
            JsonSerializer.Deserialize<
                List<Dictionary<string, JsonElement>>
            >(
                Model.OfertasTemporadaJson ?? "[]"
            );

        if (lista != null)
        {
            ofertas = lista;
        }
    }
    catch
    {
    }


    try
    {
        var lista =
            JsonSerializer.Deserialize<
                List<Dictionary<string, JsonElement>>
            >(
                Model.PlanesMembresiaJson ?? "[]"
            );

        if (lista != null)
        {
            planes = lista;
        }
    }
    catch
    {
    }


    // ==========================================
    // OBTENER TEXTO DEL JSON
    // ==========================================

    string ObtenerTexto(
        Dictionary<string, JsonElement> item,
        params string[] nombres)
    {
        foreach (var dato in item)
        {
            foreach (var nombre in nombres)
            {
                if (dato.Key.Equals(
                    nombre,
                    StringComparison.OrdinalIgnoreCase))
                {
                    if (dato.Value.ValueKind ==
                        JsonValueKind.Null)
                    {
                        return "";
                    }

                    return dato.Value.ValueKind ==
                           JsonValueKind.String
                        ? dato.Value.GetString() ?? ""
                        : dato.Value.ToString();
                }
            }
        }

        return "";
    }


    // ==========================================
    // OBTENER NÚMERO DEL JSON
    // ==========================================

    decimal? ObtenerNumero(
        Dictionary<string, JsonElement> item,
        params string[] nombres)
    {
        string texto =
            ObtenerTexto(item, nombres);

        if (decimal.TryParse(
            texto,
            NumberStyles.Any,
            CultureInfo.InvariantCulture,
            out decimal numero))
        {
            return numero;
        }

        if (decimal.TryParse(
            texto,
            out numero))
        {
            return numero;
        }

        return null;
    }


    // ==========================================
    // OBTENER FECHA DEL JSON
    // ==========================================

    string ObtenerFecha(
        Dictionary<string, JsonElement> item,
        params string[] nombres)
    {
        string texto =
            ObtenerTexto(item, nombres);

        if (DateTime.TryParse(
            texto,
            out DateTime fecha))
        {
            return fecha.ToString("dd MMM yyyy");
        }

        return texto;
    }
}


<div class="promociones-page">


    <!-- ========================================== -->
    <!-- ENCABEZADO -->
    <!-- ========================================== -->

    <div class="promociones-header">

        <h1>
            Promociones y Membresías
        </h1>

        <p>
            Explora nuestras ofertas activas y mejora tu estatus de cuidado premium.
        </p>

    </div>


    <!-- ========================================== -->
    <!-- PROMOCIONES ACTIVAS -->
    <!-- ========================================== -->

    <section class="promociones-activas">

        <h2>
            Promociones Activas
        </h2>


        <div class="promociones-cards">

            @if (promociones.Count > 0)
            {

                int numeroImagen = 1;

                foreach (var promocion in promociones)
                {

                    string nombre =
                        ObtenerTexto(
                            promocion,
                            "Nombre",
                            "NombrePromocion",
                            "Titulo");

                    string descripcion =
                        ObtenerTexto(
                            promocion,
                            "Descripcion");

                    decimal? descuento =
                        ObtenerNumero(
                            promocion,
                            "Descuento");

                    string fechaFin =
                        ObtenerFecha(
                            promocion,
                            "FechaFin",
                            "FechaFinPromocion");

                    string idPromocion =
                        ObtenerTexto(
                            promocion,
                            "IdPromocion");


                    string imagen =
                        numeroImagen % 2 == 0
                            ? "/Images/promocion2.jpeg"
                            : "/Images/promocion1.jpeg";


                    <div class="promocion-card">

                        <img src="@imagen"
                             alt="@nombre" />


                        <div class="promocion-contenido">

                            <h3>
                                @nombre
                            </h3>


                            <p>
                                @descripcion
                            </p>


                            @if (descuento.HasValue &&
                                 descuento.Value > 0)
                            {

                                <div class="precio-especial">

                                    Descuento:

                                    <strong>
                                        @descuento.Value.ToString("N0")%
                                    </strong>

                                </div>

                            }


                            <div class="promocion-footer">

                                <small>

                                    @if (!string.IsNullOrWhiteSpace(fechaFin))
                                    {
                                        <span>
                                            Válido hasta @fechaFin
                                        </span>
                                    }
                                    else
                                    {
                                        <span>
                                            Promoción activa
                                        </span>
                                    }

                                </small>


                                <a href="@Url.Action("ReservarCita", "Cliente", new { idPromocion = idPromocion })"
                                   class="btn-promocion">

                                    Aplicar Promoción

                                </a>

                            </div>

                        </div>

                    </div>


                    numeroImagen++;
                }

            }
            else
            {

                <p>
                    No hay promociones activas en este momento.
                </p>

            }

        </div>

    </section>


    <!-- ========================================== -->
    <!-- OFERTAS Y MEMBRESÍA -->
    <!-- ========================================== -->

    <section class="ofertas-membresia">


        <!-- ====================================== -->
        <!-- OFERTAS -->
        <!-- ====================================== -->

        <div class="ofertas-columna">

            <h2>
                Ofertas de Temporada
            </h2>


            @if (ofertas.Count > 0)
            {

                foreach (var oferta in ofertas)
                {

                    string nombreOferta =
                        ObtenerTexto(
                            oferta,
                            "Nombre",
                            "NombrePromocion",
                            "Titulo");

                    string descripcionOferta =
                        ObtenerTexto(
                            oferta,
                            "Descripcion");

                    decimal? descuentoOferta =
                        ObtenerNumero(
                            oferta,
                            "Descuento");


                    <div class="oferta-temporada">

                        <h3>
                            @nombreOferta
                        </h3>


                        <p>
                            @descripcionOferta
                        </p>


                        @if (descuentoOferta.HasValue &&
                             descuentoOferta.Value > 0)
                        {

                            <strong>
                                @descuentoOferta.Value.ToString("N0")%
                                de descuento
                            </strong>

                        }

                    </div>

                }

            }
            else
            {

                <div class="oferta-temporada">

                    <h3>
                        No hay ofertas de temporada
                    </h3>

                    <p>
                        Actualmente no hay ofertas adicionales disponibles.
                    </p>

                </div>

            }

        </div>


        <!-- ====================================== -->
        <!-- MEMBRESÍA ACTUAL -->
        <!-- ====================================== -->

        <div class="membresia-columna">

            <h2>
                Tu Membresía Actual
            </h2>


            <div class="membresia-promociones">


                <div class="membresia-promociones-header">

                    <span>

                        @(Model.MembresiaActual
                            ?? "Sin membresía")

                    </span>


                    <span>
                        ◉
                    </span>

                </div>


                <strong>
                    @Model.PuntosFidelidad.ToString("N0")
                </strong>


                <small>
                    PUNTOS ACUMULADOS
                </small>


                <div class="barra-promociones">

                    <div style="width: 100%;"></div>

                </div>


                <div class="membresia-puntos">

                    <span>

                        @(
                            Model.EstadoMembresia
                            ?? "Estado no disponible"
                        )

                    </span>


                    <strong>
                        @Model.PuntosFidelidad pts
                    </strong>

                </div>


                <div class="renovacion">

                    Próxima renovación


                    <strong>

                        @if (Model.FechaFinMembresia.HasValue)
                        {
                            @Model.FechaFinMembresia.Value.ToString(
                                "dd MMM yyyy")
                        }
                        else
                        {
                            <span>
                                No registrada
                            </span>
                        }

                    </strong>

                </div>


            </div>

        </div>


    </section>


    <!-- ========================================== -->
    <!-- PLANES DE MEMBRESÍA -->
    <!-- ========================================== -->

    <section class="planes-membresia">

        <h2>
            Planes de Membresía
        </h2>


        <div class="planes-grid">


            @if (planes.Count > 0)
            {

                foreach (var plan in planes)
                {

                    string nombrePlan =
                        ObtenerTexto(
                            plan,
                            "Nombre");

                    string beneficios =
                        ObtenerTexto(
                            plan,
                            "Beneficios");

                    string duracion =
                        ObtenerTexto(
                            plan,
                            "Duracion");

                    decimal? precio =
                        ObtenerNumero(
                            plan,
                            "PrecioMensual");

                    string idMembresia =
                        ObtenerTexto(
                            plan,
                            "IdMembresia");


                    bool esActual =
                        !string.IsNullOrWhiteSpace(
                            Model.MembresiaActual)
                        &&
                        nombrePlan.Equals(
                            Model.MembresiaActual,
                            StringComparison.OrdinalIgnoreCase);


                    string clasePlan =
                        nombrePlan.Contains(
                            "Premium",
                            StringComparison.OrdinalIgnoreCase)
                        ? "plan-card plan-gold"
                        : "plan-card";


                    <div class="@clasePlan">


                        @if (nombrePlan.Contains(
                            "Premium",
                            StringComparison.OrdinalIgnoreCase))
                        {

                            <div class="recomendado">
                                RECOMENDADO
                            </div>

                        }


                        @if (esActual)
                        {

                            <div class="recomendado">
                                PLAN ACTUAL
                            </div>

                        }


                        <h3>
                            @nombrePlan
                        </h3>


                        <div class="plan-precio">


                            @if (precio.HasValue)
                            {

                                <span>
                                    $
                                </span>


                                <strong>
                                    @precio.Value.ToString("N0")
                                </strong>


                                <small>
                                    /mes
                                </small>

                            }
                            else
                            {

                                <strong>
                                    Consultar
                                </strong>

                            }

                        </div>


                        <hr />


                        <ul>

                            @if (!string.IsNullOrWhiteSpace(
                                beneficios))
                            {

                                var listaBeneficios =
                                    beneficios.Split(
                                        ',',
                                        StringSplitOptions.RemoveEmptyEntries);


                                foreach (
                                    var beneficio
                                    in listaBeneficios)
                                {

                                    <li>
                                        @beneficio.Trim()
                                    </li>

                                }

                            }
                            else
                            {

                                <li>
                                    Beneficios no especificados.
                                </li>

                            }

                        </ul>


                        @if (!string.IsNullOrWhiteSpace(
                            duracion))
                        {

                            <small>
                                Duración: @duracion
                            </small>

                        }


                        @if (esActual)
                        {

                            <button type="button"
                                    disabled>

                                Membresía Actual

                            </button>

                        }
                        else
                        {
                            <form asp-controller="Cliente"
                                  asp-action="ContratarMembresia"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="idMembresia"
                                       value="@idMembresia" />

                                <button type="submit">
                                    Elegir Plan
                                </button>

                            </form>
                        }


                    </div>

                }

            }
            else
            {

                <p>
                    No hay planes de membresía disponibles.
                </p>

            }


        </div>

    </section>


</div>