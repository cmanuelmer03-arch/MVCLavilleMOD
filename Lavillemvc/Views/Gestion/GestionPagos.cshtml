@using Lavillemvc.Models
@{
    Layout = null;

    var kpis = (KpiPagos)ViewBag.Kpis;
    var transacciones = (List<PagoTransaccion>)ViewBag.Transacciones;
    var desglose = (List<DesgloseMetodo>)ViewBag.Desglose;
    var clientesSelect = (List<(int Id, string Nombre)>)ViewBag.ClientesSelect;

    decimal acum = 0;
    var stops = new List<string>();
    foreach (var d in desglose)
    {
        var ini = acum;
        acum += d.Porcentaje;
        stops.Add($"{d.ColorHex} {ini}% {acum}%");
    }
    var gradiente = stops.Count > 0
        ? "conic-gradient(" + string.Join(", ", stops) + ")"
        : "conic-gradient(#c8a96a 0% 100%)";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Registro de Pagos - L'Avielle</title>

    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <div class="app-container">
        <!-- SIDEBAR -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <div class="brand-logo">L'Avielle</div>
                <div class="role-badge">Recepcionista – Las Mercedes</div>
            </div>

            <ul class="sidebar-menu">
                <li><a href="@Url.Action("PanelPrinciRecepcionista", "Gestion")" class="menu-item"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /></svg>Panel Principal</a></li>
                <li><a href="@Url.Action("GestionCitas", "Gestion")" class="menu-item"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>Gestión de Citas</a></li>
                <li><a href="@Url.Action("GestionClientes", "Gestion")" class="menu-item"><svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>Gestión de Clientes</a></li>
                <li><a href="@Url.Action("GestionPagos", "Gestion")" class="menu-item active"><svg viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="2" ry="2" /><line x1="2" y1="10" x2="22" y2="10" /></svg>Registro de Pagos</a></li>
            </ul>

            <div class="sidebar-footer">
                <form method="post" action="@Url.Action("CerrarSesion","Login")" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="logout-link" style="background:none;border:none;padding:0;cursor:pointer;">
                        <svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>Cerrar Sesión
                    </button>
                </form>
            </div>
        </aside>

        <!-- MAIN CONTENT -->
        <main class="main-content">

            @if (TempData["ToastOk"] != null)
            {
                <div style="background:#ebf3ec;color:#4e7e4f;padding:0.9rem 1.2rem;border-radius:10px;margin-bottom:1.5rem;font-size:0.85rem;border:1px solid #d3e3d6;">
                    @TempData["ToastOk"]
                </div>
            }

            <header class="page-header">
                <div class="page-title">
                    <h1>Registro de Pagos</h1>
                    <div class="filter-label">Filtrado por: <strong>@DateTime.Now.ToString("MMMM yyyy", new System.Globalization.CultureInfo("es-ES"))</strong></div>
                </div>

                <button type="button" class="btn-primary-gold" onclick="abrirModalPago()">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="6" width="20" height="12" rx="2" /><circle cx="12" cy="12" r="2" /><path d="M6 12h.01M18 12h.01" /></svg>
                    Nuevo Pago
                </button>
            </header>

            <section class="kpi-grid">
                <div class="kpi-card">
                    <div class="kpi-header">
                        <span class="kpi-title">Ingresos del Día</span>
                        <div class="kpi-icon kpi-icon-green">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><rect x="3" y="3" width="18" height="18" rx="4" /></svg>
                        </div>
                    </div>
                    <div class="kpi-value">Bs. @kpis.IngresosDia.ToString("N0")</div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-header">
                        <span class="kpi-title">Ingresos del Mes</span>
                        <div class="kpi-icon kpi-icon-blue">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18" /><polyline points="17 6 23 6 23 12" /></svg>
                        </div>
                    </div>
                    <div class="kpi-value">Bs. @kpis.IngresosMes.ToString("N0")</div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-header">
                        <span class="kpi-title">Pagos Pendientes</span>
                        <div class="kpi-icon kpi-icon-orange">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="8" /></svg>
                        </div>
                    </div>
                    <div class="kpi-value">@kpis.Pendientes</div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-header">
                        <span class="kpi-title">Transacciones Hoy</span>
                        <div class="kpi-icon kpi-icon-purple">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="12" y1="18" x2="12" y2="12" /><line x1="9" y1="15" x2="15" y2="15" /></svg>
                        </div>
                    </div>
                    <div class="kpi-value">@kpis.TransaccionesHoy</div>
                </div>
            </section>

            <div class="payments-grid">
                <section class="table-card">
                    <h2 class="table-card-title">Transacciones Recientes</h2>

                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Factura</th>
                                <th>Especialista</th>
                                <th>Monto</th>
                                <th>Método</th>
                                <th>Fecha</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (transacciones.Count == 0)
                            {
                                <tr><td colspan="6" style="text-align:center;color:var(--text-muted);padding:2rem;">Sin transacciones registradas.</td></tr>
                            }
                            @foreach (var t in transacciones)
                            {
                                <tr>
                                    <td class="factura-code">@t.Factura</td>
                                    <td>@t.Especialista</td>
                                    <td class="monto-val">@t.Monto</td>
                                    <td class="metodo-text">@t.Metodo</td>
                                    <td class="metodo-text">@t.Fecha</td>
                                    <td><span class="badge-status @t.BadgeClass">@t.Estado</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <div class="table-pagination">
                        <span>Mostrando 1-@transacciones.Count de @transacciones.Count transacciones</span>
                    </div>
                </section>

                <aside class="methods-card">
                    <h2>Métodos de Pago</h2>

                    <div class="chart-container">
                        <div class="donut-chart" style="background: @gradiente;">
                            <div class="donut-center-text">
                                <span>TOTAL</span>
                                <strong>100%</strong>
                            </div>
                        </div>
                    </div>

                    <div class="legend-list">
                        @if (desglose.Count == 0)
                        {
                            <p style="font-size:0.8rem;color:var(--text-muted);">Sin datos de métodos de pago este mes.</p>
                        }
                        @foreach (var d in desglose)
                        {
                            <div class="legend-row">
                                <div class="legend-info">
                                    <span class="legend-dot" style="background:@d.ColorHex;"></span>
                                    <span>@d.Metodo</span>
                                </div>
                                <div class="legend-values">
                                    <span class="amount">Bs. @d.Monto.ToString("N0")</span>
                                    <span class="percent">@d.Porcentaje%</span>
                                </div>
                            </div>
                        }
                    </div>
                </aside>
            </div>

            <!-- MODAL NUEVO PAGO -->
            <div id="modalPago" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:9999;align-items:center;justify-content:center;">
                <div style="background:var(--white);border-radius:16px;padding:2rem;width:min(520px,92vw);box-shadow:0 20px 60px rgba(0,0,0,0.2);">
                    <h2 style="font-family:var(--font-serif);font-size:1.5rem;color:var(--bg-sidebar);margin-bottom:1.5rem;">Registrar Pago</h2>

                    <form method="post" action="@Url.Action("NuevoPago","Gestion")">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />

                        <div style="margin-bottom:1rem;">
                            <label style="display:block;font-size:0.7rem;font-weight:600;color:var(--text-label);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:0.35rem;">Cliente *</label>
                            <select name="idCliente" required
                                    style="width:100%;padding:0.7rem 0.9rem;border:1px solid var(--border-strong);border-radius:8px;font-size:0.85rem;background:var(--bg-soft);outline:none;">
                                <option value="">— Selecciona un cliente —</option>
                                @foreach (var c in clientesSelect)
                                {
                                    <option value="@c.Id">@c.Nombre</option>
                                }
                            </select>
                        </div>

                        <div style="margin-bottom:1rem;">
                            <label style="display:block;font-size:0.7rem;font-weight:600;color:var(--text-label);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:0.35rem;">Monto (Bs.) *</label>
                            <input type="number" name="monto" required min="0.01" step="0.01"
                                   style="width:100%;padding:0.7rem 0.9rem;border:1px solid var(--border-strong);border-radius:8px;font-size:0.85rem;background:var(--bg-soft);outline:none;" />
                        </div>

                        <div style="margin-bottom:1rem;">
                            <label style="display:block;font-size:0.7rem;font-weight:600;color:var(--text-label);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:0.35rem;">Método de pago *</label>
                            <select name="metodo" required
                                    style="width:100%;padding:0.7rem 0.9rem;border:1px solid var(--border-strong);border-radius:8px;font-size:0.85rem;background:var(--bg-soft);outline:none;">
                                <option value="">— Selecciona —</option>
                                <option>Efectivo</option>
                                <option>Tarjeta Débito</option>
                                <option>Tarjeta Crédito</option>
                                <option>Transferencia</option>
                                <option>Pago Móvil</option>
                                <option>Pagar en Sucursal</option>
                            </select>
                        </div>

                        <div style="margin-bottom:1.5rem;">
                            <label style="display:block;font-size:0.7rem;font-weight:600;color:var(--text-label);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:0.35rem;">Estado *</label>
                            <select name="estado" required
                                    style="width:100%;padding:0.7rem 0.9rem;border:1px solid var(--border-strong);border-radius:8px;font-size:0.85rem;background:var(--bg-soft);outline:none;">
                                <option value="Pagado">Pagado</option>
                                <option value="Pendiente">Pendiente</option>
                            </select>
                        </div>

                        <div style="display:flex;gap:0.8rem;justify-content:flex-end;">
                            <button type="button" class="btn-outline" onclick="cerrarModalPago()" style="padding:0.7rem 1.4rem;">Cancelar</button>
                            <button type="submit" class="btn-primary-gold">Registrar Pago</button>
                        </div>
                    </form>
                </div>
            </div>

        </main>
    </div>

    <footer class="site-footer">
        <div class="footer-grid">
            <div class="footer-brand">
                <h2>L'Avielle</h2>
                <p>Un concepto exclusivo de salón de belleza y spa de bienestar, donde el lujo se traduce en calma, elegancia y atención de nivel internacional.</p>
                <div class="social-icons">
                    <a href="#" class="social-icon"><svg viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5" ry="5" /><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" /><line x1="17.5" y1="6.5" x2="17.51" y2="6.5" /></svg></a>
                    <a href="#" class="social-icon"><svg viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" /></svg></a>
                    <a href="#" class="social-icon"><svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg></a>
                </div>
            </div>
            <div class="footer-col">
                <h3>Navegación</h3>
                <ul class="footer-links">
                    <li><a href="#">Inicio</a></li>
                    <li><a href="#">Servicios</a></li>
                    <li><a href="#">Especialistas</a></li>
                    <li><a href="#">Perfil</a></li>
                    <li><a href="#">Iniciar Sesión</a></li>
                    <li><a href="#">Registrarse</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h3>Contacto & Ubicación</h3>
                <div class="contact-info">
                    <div class="contact-item">
                        <svg viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" /><circle cx="12" cy="10" r="3" /></svg>
                        <span>Paseo de la Reforma<br />402, Juárez, CDMX</span>
                    </div>
                    <div class="contact-item">
                        <svg viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" /></svg>
                        <span>+52 55 1234 5678</span>
                    </div>
                    <div class="contact-item">
                        <svg viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" /><polyline points="22,6 12,13 2,6" /></svg>
                        <span>contacto@lavielle.com</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <span>© 2026 L'Avielle Salón de Belleza. Todos los derechos reservados.</span>
            <div class="footer-legal">
                <a href="#">Política de Privacidad</a>
                <a href="#">Términos del Servicio</a>
            </div>
        </div>
    </footer>

    <script>
        function abrirModalPago() {
            document.getElementById('modalPago').style.display = 'flex';
        }
        function cerrarModalPago() {
            document.getElementById('modalPago').style.display = 'none';
        }
        document.getElementById('modalPago')?.addEventListener('click', function (e) {
            if (e.target === this) cerrarModalPago();
        });
    </script>

</body>
</html>