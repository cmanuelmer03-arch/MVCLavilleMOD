@{
    Layout = null;

    // --- DATOS DE EJEMPLO DE TRANSACCIONES ---
    var transacciones = new[] {
        new { Factura = "#F-0234", Especialista = "Valentina Rojas", Monto = "Bs. 550", Metodo = "Tarjeta Débito", Fecha = "26 Sep 2026", Estado = "Pagado", BadgeClass = "badge-pagado" },
        new { Factura = "#F-0233", Especialista = "Lucía Méndez", Monto = "Bs. 180", Metodo = "Efectivo", Fecha = "26 Sep 2026", Estado = "Pagado", BadgeClass = "badge-pagado" },
        new { Factura = "#F-0232", Especialista = "Camila Hernández", Monto = "Bs. 800", Metodo = "Transferencia", Fecha = "25 Sep 2026", Estado = "Pagado", BadgeClass = "badge-pagado" },
        new { Factura = "#F-0231", Especialista = "Isabella Marchetti", Monto = "Bs. 350", Metodo = "Tarjeta Crédito", Fecha = "25 Sep 2026", Estado = "Pagado", BadgeClass = "badge-pagado" },
        new { Factura = "#F-0230", Especialista = "Lucía Méndez", Monto = "Bs. 200", Metodo = "Pendiente", Fecha = "25 Sep 2026", Estado = "Pendiente", BadgeClass = "badge-pendiente" },
        new { Factura = "#F-0229", Especialista = "Valentina Rojas", Monto = "Bs. 420", Metodo = "Pendiente", Fecha = "24 Sep 2026", Estado = "Pendiente", BadgeClass = "badge-pendiente" },
        new { Factura = "#F-0228", Especialista = "Equipo", Monto = "Bs. 2,500", Metodo = "Transferencia", Fecha = "24 Sep 2026", Estado = "Pagado", BadgeClass = "badge-pagado" }
    };
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Registro de Pagos - L'Avielle</title>

    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

</head>
<body>

    <div class="app-container">
        <!-- SIDEBAR -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <div class="brand-logo">L'Avielle</div>
                <div class="role-badge">Recepcionista – Las Mercedes</div>
            </div>

            <ul class="sidebar-menu">
                <li><a href="@Url.Action("PanelPrinciRecepcionista", "Home")" class="menu-item"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /></svg>Panel Principal</a></li>
                <li><a href="@Url.Action("GestionCitas", "Home")" class="menu-item"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>Gestión de Citas</a></li>
                <li><a href="@Url.Action("GestionClientes", "Home")" class="menu-item"><svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>Gestión de Clientes</a></li>
                <li><a href="@Url.Action("GestionPagos", "Home")" class="menu-item"><svg viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="2" ry="2" /><line x1="2" y1="10" x2="22" y2="10" /></svg>Registro de Pagos</a></li>
            </ul>

            <div class="sidebar-footer">
                <a href="#" class="logout-link"><svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>Cerrar Sesión</a>
            </div>
        </aside>

        <!-- MAIN CONTENT -->
        <main class="main-content">
            <!-- HEADER VISTA -->
            <header class="page-header">
                <div class="page-title">
                    <h1>Registro de Pagos</h1>
                    <div class="filter-label">Filtrado por: <strong>Septiembre 2026</strong></div>
                </div>

                <button class="btn-primary-gold">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="6" width="20" height="12" rx="2" /><circle cx="12" cy="12" r="2" /><path d="M6 12h.01M18 12h.01" /></svg>
                    Nuevo Pago
                </button>
            </header>

            <!-- TARJETAS KPI -->
            <section class="kpi-grid">
                <div class="kpi-card">
                    <div class="kpi-header">
                        <span class="kpi-title">Ingresos del Día</span>
                        <div class="kpi-icon kpi-icon-green">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><rect x="3" y="3" width="18" height="18" rx="4" /></svg>
                        </div>
                    </div>
                    <div class="kpi-value">Bs. 4,250</div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-header">
                        <span class="kpi-title">Ingresos del Mes</span>
                        <div class="kpi-icon kpi-icon-blue">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18" /><polyline points="17 6 23 6 23 12" /></svg>
                        </div>
                    </div>
                    <div class="kpi-value">Bs. 89,500</div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-header">
                        <span class="kpi-title">Pagos Pendientes</span>
                        <div class="kpi-icon kpi-icon-orange">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="12" r="8" /></svg>
                        </div>
                    </div>
                    <div class="kpi-value">3</div>
                </div>

                <div class="kpi-card">
                    <div class="kpi-header">
                        <span class="kpi-title">Transacciones Hoy</span>
                        <div class="kpi-icon kpi-icon-purple">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /><line x1="12" y1="18" x2="12" y2="12" /><line x1="9" y1="15" x2="15" y2="15" /></svg>
                        </div>
                    </div>
                    <div class="kpi-value">8</div>
                </div>
            </section>

            <!-- CONTENIDO PRINCIPAL EN GRID -->
            <div class="payments-grid">
                <!-- TABLA TRANSACCIONES -->
                <section class="table-card">
                    <h2 class="table-card-title">Transacciones Recientes</h2>

                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Factura</th>
                                <th>Especialista</th>
                                <th>Monto</th>
                                <th>Método</th>
                                <th>Fecha</th>
                                <th>Estado</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in transacciones)
                            {
                                <tr>
                                    <td class="factura-code">@t.Factura</td>
                                    <td>@t.Especialista</td>
                                    <td class="monto-val">@t.Monto</td>
                                    <td class="metodo-text">@t.Metodo</td>
                                    <td class="metodo-text">@t.Fecha</td>
                                    <td><span class="badge-status @t.BadgeClass">@t.Estado</span></td>
                                    <td>
                                        <div class="action-icons">
                                            <button class="action-icon-btn" title="Ver detalle">
                                                <svg viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" /><circle cx="12" cy="12" r="3" /></svg>
                                            </button>
                                            <button class="action-icon-btn" title="Imprimir">
                                                <svg viewBox="0 0 24 24"><polyline points="6 9 6 2 18 2 18 9" /><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" /><rect x="6" y="14" width="12" height="8" /></svg>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <div class="table-pagination">
                        <span>Mostrando 1-7 de 86 transacciones</span>
                        <div class="pagination-btns">
                            <button class="pagination-btn">&lt;</button>
                            <button class="pagination-btn">&gt;</button>
                        </div>
                    </div>
                </section>

                <!-- MÉTODOS DE PAGO (PANEL DERECHO) -->
                <aside class="methods-card">
                    <h2>Métodos de Pago</h2>

                    <div class="chart-container">
                        <div class="donut-chart">
                            <div class="donut-center-text">
                                <span>TOTAL</span>
                                <strong>100%</strong>
                            </div>
                        </div>
                    </div>

                    <div class="legend-list">
                        <div class="legend-row">
                            <div class="legend-info">
                                <span class="legend-dot dot-efectivo"></span>
                                <span>Efectivo</span>
                            </div>
                            <div class="legend-values">
                                <span class="amount">Bs. 1,487</span>
                                <span class="percent">35%</span>
                            </div>
                        </div>

                        <div class="legend-row">
                            <div class="legend-info">
                                <span class="legend-dot dot-debito"></span>
                                <span>Tarjeta Débito</span>
                            </div>
                            <div class="legend-values">
                                <span class="amount">Bs. 1,190</span>
                                <span class="percent">28%</span>
                            </div>
                        </div>

                        <div class="legend-row">
                            <div class="legend-info">
                                <span class="legend-dot dot-transferencia"></span>
                                <span>Transferencia</span>
                            </div>
                            <div class="legend-values">
                                <span class="amount">Bs. 935</span>
                                <span class="percent">22%</span>
                            </div>
                        </div>

                        <div class="legend-row">
                            <div class="legend-info">
                                <span class="legend-dot dot-credito"></span>
                                <span>Tarjeta Crédito</span>
                            </div>
                            <div class="legend-values">
                                <span class="amount">Bs. 638</span>
                                <span class="percent">15%</span>
                            </div>
                        </div>
                    </div>
                </aside>
            </div>
        </main>
    </div>

    <!-- FOOTER OSCURO COMPARTIDO -->
    <footer class="site-footer">
        <div class="footer-grid">
            <div class="footer-brand">
                <h2>L'Avielle</h2>
                <p>Un concepto exclusivo de salón de belleza y spa de bienestar, donde el lujo se traduce en calma, elegancia y atención de nivel internacional.</p>
                <div class="social-icons">
                    <a href="#" class="social-icon"><svg viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5" ry="5" /><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" /><line x1="17.5" y1="6.5" x2="17.51" y2="6.5" /></svg></a>
                    <a href="#" class="social-icon"><svg viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" /></svg></a>
                    <a href="#" class="social-icon"><svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg></a>
                </div>
            </div>
            <div class="footer-col">
                <h3>Navegación</h3>
                <ul class="footer-links">
                    <li><a href="#">Inicio</a></li>
                    <li><a href="#">Servicios</a></li>
                    <li><a href="#">Especialistas</a></li>
                    <li><a href="#">Perfil</a></li>
                    <li><a href="#">Iniciar Sesión</a></li>
                    <li><a href="#">Registrarse</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h3>Contacto & Ubicación</h3>
                <div class="contact-info">
                    <div class="contact-item">
                        <svg viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" /><circle cx="12" cy="10" r="3" /></svg>
                        <span>Paseo de la Reforma<br />402, Juárez, CDMX</span>
                    </div>
                    <div class="contact-item">
                        <svg viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" /></svg>
                        <span>+52 55 1234 5678</span>
                    </div>
                    <div class="contact-item">
                        <svg viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" /><polyline points="22,6 12,13 2,6" /></svg>
                        <span>contacto@lavielle.com</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <span>© 2026 L'Avielle Salón de Belleza. Todos los derechos reservados.</span>
            <div class="footer-legal">
                <a href="#">Política de Privacidad</a>
                <a href="#">Términos del Servicio</a>
            </div>
        </div>
    </footer>

</body>
</html>