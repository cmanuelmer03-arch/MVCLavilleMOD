@using Lavillemvc.Models
@{
    Layout = null;

    var citas = (List<CitaCalendario>)ViewBag.Citas;
    var lunes = (DateTime)ViewBag.Lunes;
    var sabado = (DateTime)ViewBag.Sabado;
    var fechaRef = (DateTime)ViewBag.FechaRef;
    var mesTexto = (string)ViewBag.MesTexto;
    var detalle = ViewBag.Detalle as CitaDetalle;

    var clientesSelect = (List<(int Id, string Nombre)>)ViewBag.ClientesSelect;
    var serviciosSelect = (List<(int Id, string Nombre)>)ViewBag.ServiciosSelect;
    var especialistasSelect = (List<(int Id, string Nombre)>)ViewBag.EspecialistasSelect;

    var cultura = new System.Globalization.CultureInfo("es-ES");
    var prevSemana = lunes.AddDays(-7).ToString("yyyy-MM-dd");
    var nextSemana = lunes.AddDays(7).ToString("yyyy-MM-dd");

    var citaActivaId = detalle?.IdCita ?? 0;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Gestión de Citas - L'Avielle</title>

    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <div class="app-container">
        <!-- SIDEBAR -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <div class="brand-logo">L'Avielle</div>
                <div class="role-badge">Recepcionista – Las Mercedes</div>
            </div>

            <ul class="sidebar-menu">
                <li><a href="@Url.Action("PanelPrinciRecepcionista", "Gestion")" class="menu-item"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /></svg>Panel Principal</a></li>
                <li><a href="@Url.Action("GestionCitas", "Gestion")" class="menu-item active"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>Gestión de Citas</a></li>
                <li><a href="@Url.Action("GestionClientes", "Gestion")" class="menu-item"><svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>Gestión de Clientes</a></li>
                <li><a href="@Url.Action("GestionPagos", "Gestion")" class="menu-item"><svg viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="2" ry="2" /><line x1="2" y1="10" x2="22" y2="10" /></svg>Registro de Pagos</a></li>
            </ul>

            <div class="sidebar-footer">
                <form method="post" action="@Url.Action("CerrarSesion","Login")" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="logout-link" style="background:none;border:none;padding:0;cursor:pointer;">
                        <svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>Cerrar Sesión
                    </button>
                </form>
            </div>
        </aside>

        <!-- MAIN CONTENT -->
        <main class="main-content">

            @if (TempData["ToastOk"] != null)
            {
                <div style="background:#ebf3ec;color:#4e7e4f;padding:0.9rem 1.2rem;border-radius:10px;margin-bottom:1.5rem;font-size:0.85rem;border:1px solid #d3e3d6;">
                    @TempData["ToastOk"]
                </div>
            }

            <header class="page-header">
                <div class="header-title-area">
                    <div class="page-title">
                        <h1>Gestión de Citas</h1>
                    </div>
                    <div class="month-selector">
                        <a href="@Url.Action("GestionCitas", "Gestion", new { semana = prevSemana })" class="btn-arrow" style="text-decoration:none;">&lt;</a>
                        <span>@mesTexto</span>
                        <a href="@Url.Action("GestionCitas", "Gestion", new { semana = nextSemana })" class="btn-arrow" style="text-decoration:none;">&gt;</a>
                    </div>
                </div>

                <div class="header-controls">
                    <div class="view-switcher">
                        <button class="view-btn">Día</button>
                        <button class="view-btn active">Semana</button>
                        <button class="view-btn">Mes</button>
                        <button class="view-btn">Lista</button>
                    </div>
                    <button type="button" class="btn-primary-gold" onclick="abrirModalCita()"><span>+</span> Nueva Cita</button>
                </div>
            </header>

            <div class="citas-layout">
                <section class="calendar-card">
                    <div class="calendar-grid">
                        <div class="col-header"></div>
                        @for (int d = 0; d < 6; d++)
                        {
                            var dia = lunes.AddDays(d);
                            var activo = dia == fechaRef;
                            if (activo)
                            {
                                <div class="col-header active-day"><span>@dia.ToString("ddd d", cultura)</span></div>
                            }
                            else
                            {
                                <div class="col-header">@dia.ToString("ddd d", cultura)</div>
                            }
                        }

                        @for (int h = 8; h <= 18; h++)
                        {
                            var horaTxt = h > 12 ? (h - 12) + ":00 PM" : (h == 12 ? "12:00 PM" : h + ":00 AM");
                            <div class="time-label">@horaTxt</div>

                            @for (int d = 0; d < 6; d++)
                            {
                                var dia = lunes.AddDays(d);
                                var c = citas.FirstOrDefault(x => x.Fecha.Date == dia.Date && x.Hora.Hour == h);

                                <div class="time-cell">
                                    @if (c != null)
                                    {
                                        var dotCss = c.Estado == "Confirmada" ? "dot-confirmada"
                                        : c.Estado == "Pendiente" ? "dot-pendiente"
                                        : c.Estado == "Cancelada" ? "dot-cancelada"
                                        : "dot-completada";

                                        var claseExtra = c.IdCita == citaActivaId ? "active-selected" : "";

                                        <a href="@Url.Action("GestionCitas", "Gestion", new { semana = lunes.ToString("yyyy-MM-dd"), id = c.IdCita })"
                                           class="cita-item @claseExtra"
                                           style="display:block;text-decoration:none;color:inherit;">
                                            <div class="cita-header">
                                                <span>@c.Cliente</span>
                                                <span class="cita-status-dot @dotCss"></span>
                                            </div>
                                            <div class="cita-sub">@c.Servicio</div>
                                            <div class="cita-staff">@c.Especialista</div>
                                        </a>
                                    }
                                </div>
                            }
                        }
                    </div>

                    <div class="calendar-legend">
                        <div class="legend-item"><span class="cita-status-dot dot-confirmada"></span> Confirmada</div>
                        <div class="legend-item"><span class="cita-status-dot dot-pendiente"></span> Pendiente</div>
                        <div class="legend-item"><span class="cita-status-dot dot-cancelada"></span> Cancelada</div>
                        <div class="legend-item"><span class="cita-status-dot dot-completada"></span> Completada</div>
                    </div>
                </section>

                <aside class="detail-card">
                    <h2>Detalle de Cita</h2>

                    @if (detalle == null)
                    {
                        <p style="font-size:0.85rem;color:var(--text-muted);">Selecciona una cita del calendario para ver su detalle.</p>
                    }
                    else
                    {
                        <div class="client-profile-box">
                            <div class="avatar-placeholder">@detalle.Iniciales</div>
                            <div class="client-profile-info">
                                <h3>@detalle.Cliente</h3>
                                <span class="client-vip-badge">@(string.IsNullOrWhiteSpace(detalle.Membresia) ? "Cliente" : detalle.Membresia)</span>
                            </div>
                        </div>

                        <div class="detail-group">
                            <div class="detail-label">Servicio</div>
                            <div class="detail-value">@detalle.Servicio</div>
                        </div>

                        <div class="detail-group">
                            <div class="detail-label">Especialista</div>
                            <div class="detail-value">@detalle.Especialista</div>
                        </div>

                        <div class="detail-group">
                            <div class="detail-label">Horario</div>
                            <div class="detail-value">@detalle.HorarioTexto</div>
                        </div>

                        <div class="detail-group">
                            <div class="detail-label">Estado</div>
                            <div>
                                <span class="status-pill-green">@detalle.Estado</span>
                            </div>
                        </div>

                        <div class="detail-group">
                            <div class="detail-label">Notas de Recepción</div>
                            <div class="notes-box">
                                Sin notas adicionales registradas para esta cita.
                            </div>
                        </div>

                        <div style="margin-top: auto;">
                            <div class="action-buttons-row">
                                <button type="button" class="btn-outline" disabled title="Próximamente" style="opacity:0.55;cursor:not-allowed;">
                                    Modificar
                                </button>

                                @if (detalle.Estado != "Cancelada")
                                {
                                    <form method="post" action="@Url.Action("CancelarCita","Gestion")" style="margin:0;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@detalle.IdCita" />
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                        <button type="submit" class="btn-outline btn-outline-red" style="width:100%;"
                                                onclick="return confirm('¿Cancelar esta cita?');">
                                            Cancelar
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <button type="button" class="btn-outline btn-outline-red" disabled style="opacity:0.55;cursor:not-allowed;">
                                        Ya cancelada
                                    </button>
                                }
                            </div>

                            @if (detalle.Estado != "Confirmada" && detalle.Estado != "Cancelada")
                            {
                                <form method="post" action="@Url.Action("ConfirmarCita","Gestion")" style="margin:0;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@detalle.IdCita" />
                                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                    <button type="submit" class="btn-gold-full">Confirmar Cita</button>
                                </form>
                            }
                            else if (detalle.Estado == "Confirmada")
                            {
                                <button type="button" class="btn-gold-full" disabled style="opacity:0.6;cursor:not-allowed;">
                                    ✓ Cita ya confirmada
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn-gold-full" disabled style="opacity:0.6;cursor:not-allowed;">
                                    Cita cancelada
                                </button>
                            }
                        </div>
                    }
                </aside>
            </div>

            <!-- MODAL NUEVA CITA -->
            <div id="modalCita" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:9999;align-items:center;justify-content:center;">
                <div style="background:var(--white);border-radius:16px;padding:2rem;width:min(560px,92vw);box-shadow:0 20px 60px rgba(0,0,0,0.2);max-height:90vh;overflow-y:auto;">
                    <h2 style="font-family:var(--font-serif);font-size:1.5rem;color:var(--bg-sidebar);margin-bottom:1.5rem;">Nueva Cita</h2>

                    <form method="post" action="@Url.Action("NuevaCita","Gestion")">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />

                        <div style="margin-bottom:1rem;">
                            <label style="display:block;font-size:0.7rem;font-weight:600;color:var(--text-label);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:0.35rem;">Cliente *</label>
                            <select name="idCliente" required
                                    style="width:100%;padding:0.7rem 0.9rem;border:1px solid var(--border-strong);border-radius:8px;font-size:0.85rem;background:var(--bg-soft);outline:none;">
                                <option value="">— Selecciona un cliente —</option>
                                @foreach (var c in clientesSelect)
                                {
                                    <option value="@c.Id">@c.Nombre</option>
                                }
                            </select>
                        </div>

                        <div style="margin-bottom:1rem;">
                            <label style="display:block;font-size:0.7rem;font-weight:600;color:var(--text-label);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:0.35rem;">Servicio *</label>
                            <select name="idServicio" required
                                    style="width:100%;padding:0.7rem 0.9rem;border:1px solid var(--border-strong);border-radius:8px;font-size:0.85rem;background:var(--bg-soft);outline:none;">
                                <option value="">— Selecciona un servicio —</option>
                                @foreach (var s in serviciosSelect)
                                {
                                    <option value="@s.Id">@s.Nombre</option>
                                }
                            </select>
                        </div>

                        <div style="margin-bottom:1rem;">
                            <label style="display:block;font-size:0.7rem;font-weight:600;color:var(--text-label);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:0.35rem;">Especialista</label>
                            <select name="idEmpleado"
                                    style="width:100%;padding:0.7rem 0.9rem;border:1px solid var(--border-strong);border-radius:8px;font-size:0.85rem;background:var(--bg-soft);outline:none;">
                                <option value="">— Sin asignar —</option>
                                @foreach (var e in especialistasSelect)
                                {
                                    <option value="@e.Id">@e.Nombre</option>
                                }
                            </select>
                        </div>

                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1.5rem;">
                            <div>
                                <label style="display:block;font-size:0.7rem;font-weight:600;color:var(--text-label);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:0.35rem;">Fecha *</label>
                                <input type="date" name="fecha" required
                                       value="@DateTime.Today.ToString("yyyy-MM-dd")"
                                       style="width:100%;padding:0.7rem 0.9rem;border:1px solid var(--border-strong);border-radius:8px;font-size:0.85rem;background:var(--bg-soft);outline:none;" />
                            </div>
                            <div>
                                <label style="display:block;font-size:0.7rem;font-weight:600;color:var(--text-label);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:0.35rem;">Hora *</label>
                                <input type="time" name="hora" required value="09:00"
                                       style="width:100%;padding:0.7rem 0.9rem;border:1px solid var(--border-strong);border-radius:8px;font-size:0.85rem;background:var(--bg-soft);outline:none;" />
                            </div>
                        </div>

                        <div style="display:flex;gap:0.8rem;justify-content:flex-end;">
                            <button type="button" class="btn-outline" onclick="cerrarModalCita()" style="padding:0.7rem 1.4rem;">Cancelar</button>
                            <button type="submit" class="btn-primary-gold">Crear Cita</button>
                        </div>
                    </form>
                </div>
            </div>

        </main>
    </div>

    <footer class="site-footer">
        <div class="footer-grid">
            <div class="footer-brand">
                <h2>L'Avielle</h2>
                <p>Un concepto exclusivo de salón de belleza y spa de bienestar, donde el lujo se traduce en calma, elegancia y atención de nivel internacional.</p>
                <div class="social-icons">
                    <a href="#" class="social-icon"><svg viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5" ry="5" /><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" /><line x1="17.5" y1="6.5" x2="17.51" y2="6.5" /></svg></a>
                    <a href="#" class="social-icon"><svg viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" /></svg></a>
                    <a href="#" class="social-icon"><svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg></a>
                </div>
            </div>
            <div class="footer-col">
                <h3>Navegación</h3>
                <ul class="footer-links">
                    <li><a href="#">Inicio</a></li>
                    <li><a href="#">Servicios</a></li>
                    <li><a href="#">Especialistas</a></li>
                    <li><a href="#">Perfil</a></li>
                    <li><a href="#">Iniciar Sesión</a></li>
                    <li><a href="#">Registrarse</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h3>Contacto & Ubicación</h3>
                <div class="contact-info">
                    <div class="contact-item">
                        <svg viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" /><circle cx="12" cy="10" r="3" /></svg>
                        <span>Paseo de la Reforma<br />402, Juárez, CDMX</span>
                    </div>
                    <div class="contact-item">
                        <svg viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" /></svg>
                        <span>+52 55 1234 5678</span>
                    </div>
                    <div class="contact-item">
                        <svg viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" /><polyline points="22,6 12,13 2,6" /></svg>
                        <span>contacto@lavielle.com</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <span>© 2026 L'Avielle Salón de Belleza. Todos los derechos reservados.</span>
            <div class="footer-legal">
                <a href="#">Política de Privacidad</a>
                <a href="#">Términos del Servicio</a>
            </div>
        </div>
    </footer>

    <script>
        function abrirModalCita() {
            document.getElementById('modalCita').style.display = 'flex';
        }
        function cerrarModalCita() {
            document.getElementById('modalCita').style.display = 'none';
        }
        document.getElementById('modalCita')?.addEventListener('click', function (e) {
            if (e.target === this) cerrarModalCita();
        });
    </script>

</body>
</html>