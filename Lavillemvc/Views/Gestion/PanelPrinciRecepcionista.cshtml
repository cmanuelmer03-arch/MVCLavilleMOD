@{
    Layout = null;

    // --- DATOS REALES EXTRAÍDOS DE LA IMAGEN ---
    var topCards = new[] {
        new { Titulo = "CITAS HOY", Valor = "12", Icono = "calendar" },
        new { Titulo = "PENDIENTES", Valor = "3", Icono = "clock" },
        new { Titulo = "CLIENTES NUEVOS", Valor = "5", Icono = "user" },
        new { Titulo = "PAGOS DEL DÍA", Valor = "Bs. 4,250", Icono = "cash" }
    };

    var citas = new[] {
        new { Hora = "9:00 AM", Cliente = "María García", TipoCliente = "VIP Gold", Servicio = "Balayage + Corte", Especialista = "Valentina Rojas", Estado = "Confirmada", CssEstado = "estado-confirmada", MostrarConfirmar = false },
        new { Hora = "10:30 AM", Cliente = "Laura Pérez", TipoCliente = "Socio Platinum", Servicio = "Manicura Semipermanente", Especialista = "Lucía Méndez", Estado = "Confirmada", CssEstado = "estado-confirmada", MostrarConfirmar = false },
        new { Hora = "11:00 AM", Cliente = "Carmen Silva", TipoCliente = "Nueva", Servicio = "Tratamiento Keratina", Especialista = "Camila Hernández", Estado = "Pendiente", CssEstado = "estado-pendiente", MostrarConfirmar = true },
        new { Hora = "1:00 PM", Cliente = "Isabel Torres", TipoCliente = "Recurrente", Servicio = "Corte + Peinado", Especialista = "Isabella Marchetti", Estado = "Confirmada", CssEstado = "estado-confirmada", MostrarConfirmar = false },
        new { Hora = "3:30 PM", Cliente = "Andrea Ruiz", TipoCliente = "VIP Gold", Servicio = "Pedicura Spa", Especialista = "Lucía Méndez", Estado = "Sin Confirmar", CssEstado = "estado-sinconfirmar", MostrarConfirmar = true }
    };

    var reservas = new[] {
        new { Nombre = "Patricia Luna", Servicio = "Corte Bob + Tintura", Fecha = "Mañanas — 10:00 AM" },
        new { Nombre = "Gabriela Espinoza", Servicio = "Lifting de Pestañas", Fecha = "Lunes 28 — 2:30 PM" },
        new { Nombre = "Mónica Gómez", Servicio = "Spa de Manos Completo", Fecha = "Lunes 28 — 4:00 PM" }
    };

    var registros = new[] {
        new { Nombre = "Verónica Rivas", Tiempo = "Hoy, 10:12 AM" },
        new { Nombre = "Clara Méndez", Tiempo = "Hoy, 09:45 AM" },
        new { Nombre = "Diana Salazar", Tiempo = "Ayer, 05:20 PM" },
        new { Nombre = "Regina Phalange", Tiempo = "Ayer, 11:30 AM" },
        new { Nombre = "Natalia Vega", Tiempo = "24 Sep 2026" }
    };
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Panel de Recepción - L'Avielle</title>

    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <div class="app-container">
        <!-- SIDEBAR -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <div class="brand-logo">L'Avielle</div>
                <div class="role-badge">Recepcionista – Las Mercedes</div>
            </div>

            <ul class="sidebar-menu">
                <li><a href="@Url.Action("PanelPrinciRecepcionista", "Home")" class="menu-item"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /></svg>Panel Principal</a></li>
                <li><a href="@Url.Action("GestionCitas", "Home")" class="menu-item"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>Gestión de Citas</a></li>
                <li><a href="@Url.Action("GestionClientes", "Home")" class="menu-item"><svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>Gestión de Clientes</a></li>
                <li><a href="@Url.Action("GestionPagos", "Home")" class="menu-item"><svg viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="2" ry="2" /><line x1="2" y1="10" x2="22" y2="10" /></svg>Registro de Pagos</a></li>
            </ul>

            <div class="sidebar-footer">
                <a href="#" class="logout-link"><svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>Cerrar Sesión</a>
            </div>
        </aside>

        <!-- MAIN CONTENT -->
        <main class="main-content">
            <!-- HEADER -->
            <header class="top-header">
                <div class="greeting">
                    <h1>Buenos Días, Ana</h1>
                    <p>Panel de Recepción — L'Avielle Las Mercedes • Viernes, 26 de Septiembre 2026</p>
                </div>
                <div class="user-profile">
                    <img src="https://via.placeholder.com/40" alt="Ana de Armas" class="user-avatar" />
                    <div class="user-info">
                        <strong>Ana de Armas</strong>
                        <span>Host Principal</span>
                    </div>
                </div>
            </header>

            <!-- STATS CARDS -->
            <div class="stats-grid">
                @foreach (var card in topCards)
                {
                    <div class="stat-card">
                        <h3>@card.Titulo</h3>
                        <div class="value">@card.Valor</div>
                        <div class="stat-icon">
                            @if (card.Icono == "calendar")
                            {
                                <svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>
                            }
                            @if (card.Icono == "clock")
                            {
                                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
                            }
                            @if (card.Icono == "user")
                            {
                                <svg viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="8.5" cy="7" r="4" /><line x1="20" y1="8" x2="20" y2="14" /><line x1="23" y1="11" x2="17" y2="11" /></svg>
                            }
                            @if (card.Icono == "cash")
                            {
                                <svg viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="2" ry="2" /><line x1="2" y1="10" x2="22" y2="10" /></svg>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="dashboard-grid">
                <!-- COLUMNA IZQUIERDA: CITAS DEL DÍA -->
                <div class="card-container">
                    <div class="card-header">
                        <h2 class="card-title">Citas del Día</h2>
                        <a href="#" class="btn-pill">Ver todas (12)</a>
                    </div>

                    <div class="table-responsive">
                        <table class="citas-table">
                            <thead>
                                <tr>
                                    <th>Hora</th>
                                    <th>Cliente</th>
                                    <th>Servicio</th>
                                    <th>Especialista</th>
                                    <th>Estado</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var cita in citas)
                                {
                                    <tr>
                                        <td class="td-hora">@cita.Hora</td>
                                        <td>
                                            <span class="cliente-nombre">@cita.Cliente</span>
                                            <span class="cliente-tipo">@cita.TipoCliente</span>
                                        </td>
                                        <td><span class="servicio-texto">@cita.Servicio</span></td>
                                        <td style="color: var(--text-muted);">@cita.Especialista</td>
                                        <td><span class="badge @cita.CssEstado">@cita.Estado</span></td>
                                        <td>
                                            <div class="acciones-td">
                                                @if (cita.MostrarConfirmar)
                                                {
                                                    <a href="#" class="btn-text-green">Confirmar</a>
                                                }
                                                <a href="#" class="btn-text-gold">Ver</a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- COLUMNA DERECHA: WIDGETS -->
                <div class="widgets-column">

                    <!-- 1. Reservas por Confirmar -->
                    <div class="widget-card">
                        <div class="card-header" style="margin-bottom: 1rem;">
                            <h2 class="card-title" style="font-size: 1.1rem;">3 Reservas por Confirmar</h2>
                        </div>
                        <div class="widget-body">
                            @foreach (var reserva in reservas)
                            {
                                <div class="reserva-item">
                                    <div class="reserva-info">
                                        <h4>@reserva.Nombre</h4>
                                        <p>@reserva.Servicio</p>
                                        <small>@reserva.Fecha</small>
                                    </div>
                                    <button class="btn-gold-solid">Confirmar</button>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- 2. Atención Actual -->
                    <div class="widget-card">
                        <div class="card-header" style="margin-bottom: 1.5rem;">
                            <h2 class="card-title" style="font-size: 1.1rem;">Atención Actual</h2>
                        </div>
                        <div class="widget-body">
                            <div class="atencion-item">
                                <div class="atencion-labels">
                                    <span>Especialistas Activos</span>
                                    <strong>4/6</strong>
                                </div>
                                <div class="progress-bar"><div class="progress-fill" style="width: 66%;"></div></div>
                            </div>
                            <div class="atencion-item">
                                <div class="atencion-labels">
                                    <span>Cabinas Ocupadas</span>
                                    <strong>3/5</strong>
                                </div>
                                <div class="progress-bar"><div class="progress-fill" style="width: 60%; background-color: var(--border-light);"></div></div>
                            </div>
                            <div class="espera-row">
                                <span>Tiempo Promedio de Espera</span>
                                <strong>15 min</strong>
                            </div>
                        </div>
                    </div>

                    <!-- 3. Últimos Registros -->
                    <div class="widget-card">
                        <div class="card-header" style="margin-bottom: 1rem;">
                            <h2 class="card-title" style="font-size: 1.1rem;">5 Últimos Registros</h2>
                        </div>
                        <div class="widget-body">
                            @foreach (var reg in registros)
                            {
                                <div class="registro-item">
                                    <div class="registro-info">
                                        <h4>@reg.Nombre</h4>
                                        <p>@reg.Tiempo</p>
                                    </div>
                                    <a href="#" class="btn-text-gold">Ver Perfil</a>
                                </div>
                            }
                        </div>
                    </div>

                </div>
            </div>
        </main>
    </div>

    <!-- FOOTER -->
    <footer class="site-footer">
        <div class="footer-grid">
            <div class="footer-brand">
                <h2>L'Avielle</h2>
                <p>Un concepto exclusivo de salón de belleza y spa de bienestar, donde el lujo se traduce en calma, elegancia y atención de nivel internacional.</p>
                <div class="social-icons">
                    <a href="#" class="social-icon"><svg viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5" ry="5" /><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" /><line x1="17.5" y1="6.5" x2="17.51" y2="6.5" /></svg></a>
                    <a href="#" class="social-icon"><svg viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" /></svg></a>
                    <a href="#" class="social-icon"><svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg></a>
                </div>
            </div>
            <div class="footer-col">
                <h3>Navegación</h3>
                <ul class="footer-links">
                    <li><a href="#">Inicio</a></li>
                    <li><a href="#">Servicios</a></li>
                    <li><a href="#">Especialistas</a></li>
                    <li><a href="#">Perfil</a></li>
                    <li><a href="#">Iniciar Sesión</a></li>
                    <li><a href="#">Registrarse</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h3>Contacto & Ubicación</h3>
                <div class="contact-info">
                    <div class="contact-item">
                        <svg viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" /><circle cx="12" cy="10" r="3" /></svg>
                        <span>Paseo de la Reforma<br />402, Juárez, CDMX</span>
                    </div>
                    <div class="contact-item">
                        <svg viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" /></svg>
                        <span>+52 55 1234 5678</span>
                    </div>
                    <div class="contact-item">
                        <svg viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" /><polyline points="22,6 12,13 2,6" /></svg>
                        <span>contacto@lavielle.com</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <span>© 2026 L'Avielle Salón de Belleza. Todos los derechos reservados.</span>
            <div class="footer-legal">
                <a href="#">Política de Privacidad</a>
                <a href="#">Términos del Servicio</a>
            </div>
        </div>
    </footer>

</body>
</html>