@using Lavillemvc.Models
@{
    Layout = null;

    var clientes = (List<ClienteDirectorio>)ViewBag.Clientes;
    var total = (int)ViewBag.Total;
    var page = (int)ViewBag.Page;
    var totalPages = (int)ViewBag.TotalPages;
    var buscar = (string?)ViewBag.Buscar;

    var desde = total == 0 ? 0 : ((page - 1) * 6) + 1;
    var hasta = Math.Min(page * 6, total);
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Gestión de Clientes - L'Avielle</title>

    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <div class="app-container">
        <!-- SIDEBAR -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <div class="brand-logo">L'Avielle</div>
                <div class="role-badge">Recepcionista – Las Mercedes</div>
            </div>

            <ul class="sidebar-menu">
                <li><a href="@Url.Action("PanelPrinciRecepcionista", "Gestion")" class="menu-item"><svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><rect x="14" y="14" width="7" height="7" rx="1" /></svg>Panel Principal</a></li>
                <li><a href="@Url.Action("GestionCitas", "Gestion")" class="menu-item"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>Gestión de Citas</a></li>
                <li><a href="@Url.Action("GestionClientes", "Gestion")" class="menu-item active"><svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>Gestión de Clientes</a></li>
                <li><a href="@Url.Action("GestionPagos", "Gestion")" class="menu-item"><svg viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="2" ry="2" /><line x1="2" y1="10" x2="22" y2="10" /></svg>Registro de Pagos</a></li>
            </ul>

            <div class="sidebar-footer">
                <form method="post" action="@Url.Action("CerrarSesion","Login")" style="display:inline;">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="logout-link" style="background:none;border:none;padding:0;cursor:pointer;">
                        <svg viewBox="0 0 24 24"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>Cerrar Sesión
                    </button>
                </form>
            </div>
        </aside>

        <!-- MAIN CONTENT -->
        <main class="main-content">

            @if (TempData["ToastOk"] != null)
            {
                <div style="background:#ebf3ec;color:#4e7e4f;padding:0.9rem 1.2rem;border-radius:10px;margin-bottom:1.5rem;font-size:0.85rem;border:1px solid #d3e3d6;">
                    @TempData["ToastOk"]
                </div>
            }

            <header class="page-header">
                <div class="page-title">
                    <h1>Gestión de Clientes</h1>
                    <p>Directorio de Socias L'Avielle y Registro Único</p>
                </div>
                <button type="button" class="btn-primary-gold" onclick="abrirModalCliente()">Registrar Nuevo Cliente</button>
            </header>

            <section class="filter-card">
                <form method="get" action="@Url.Action("GestionClientes","Gestion")">
                    <div class="filter-top-row">
                        <div class="search-box">
                            <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                            <input type="text" name="q" value="@buscar" class="search-input" placeholder="Buscar por nombre, email o teléfono..." />
                        </div>
                        <select class="select-order" name="orden">
                            <option>Orden: Última Visita</option>
                            <option>Orden: Nombre (A-Z)</option>
                            <option>Orden: Mayor Citas</option>
                        </select>
                    </div>

                    <div class="filter-pills-row">
                        <div class="pills-group">
                            <a href="@Url.Action("GestionClientes", "Gestion")" class="pill active">Todos (@total)</a>
                            <a href="#" class="pill">Activos</a>
                            <a href="#" class="pill">Inactivos</a>
                            <a href="#" class="pill">Nuevos (mes)</a>
                        </div>
                        <div class="quick-filter">
                            Filtro rápido: <strong>Socias Gold &amp; Platinum</strong>
                        </div>
                    </div>
                </form>
            </section>

            <section class="table-card">
                <div style="overflow-x: auto;">
                    <table class="clientes-table">
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Email</th>
                                <th>Teléfono</th>
                                <th>Última Visita</th>
                                <th>Citas</th>
                                <th>Membresía</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (clientes.Count == 0)
                            {
                                <tr><td colspan="6" style="text-align:center;color:var(--text-muted);padding:2rem;">No se encontraron clientes.</td></tr>
                            }
                            @foreach (var item in clientes)
                            {
                                <tr>
                                    <td class="client-name">@item.Nombre</td>
                                    <td class="client-email">@item.Email</td>
                                    <td>@item.Telefono</td>
                                    <td>@item.UltimaVisita</td>
                                    <td style="font-weight: 500;">@item.Citas</td>
                                    <td>
                                        <span class="badge-membership @item.CssMembresia">@item.Membresia</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="table-pagination">
                    <span>Mostrando @desde-@hasta de @total clientes</span>
                    <div class="pagination-controls">
                        @if (page > 1)
                        {
                            <a href="@Url.Action("GestionClientes", "Gestion", new { page = page - 1, q = buscar })" class="page-btn">&lt;</a>
                        }
                        else
                        {
                            <span class="page-btn" style="opacity:0.5;">&lt;</span>
                        }

                        @for (int i = 1; i <= totalPages; i++)
                        {
                            <a href="@Url.Action("GestionClientes", "Gestion", new { page = i, q = buscar })"
                               class="page-btn @(i == page ? "active" : "")">@i</a>
                        }

                        @if (page < totalPages)
                        {
                            <a href="@Url.Action("GestionClientes", "Gestion", new { page = page + 1, q = buscar })" class="page-btn">&gt;</a>
                        }
                        else
                        {
                            <span class="page-btn" style="opacity:0.5;">&gt;</span>
                        }
                    </div>
                </div>
            </section>

            <section class="summary-banner">
                <div class="summary-col">
                    <span class="summary-label">Clientes Totales</span>
                    <span class="summary-value">@total Registradas</span>
                </div>
                <div class="summary-col">
                    <span class="summary-label">Clientes Gold / Platinum</span>
                    <span class="summary-value">— Socias VIP</span>
                </div>
                <div class="summary-col">
                    <span class="summary-label">Nuevos Este Mes</span>
                    <span class="summary-value">+— Creados</span>
                </div>
            </section>

            <!-- MODAL NUEVO CLIENTE -->
            <div id="modalCliente" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.5);z-index:9999;align-items:center;justify-content:center;">
                <div style="background:var(--white);border-radius:16px;padding:2rem;width:min(500px,90vw);box-shadow:0 20px 60px rgba(0,0,0,0.2);">
                    <h2 style="font-family:var(--font-serif);font-size:1.5rem;color:var(--bg-sidebar);margin-bottom:1.5rem;">Registrar Nuevo Cliente</h2>

                    <form method="post" action="@Url.Action("NuevoCliente","Gestion")">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />

                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin-bottom:1rem;">
                            <div>
                                <label style="display:block;font-size:0.7rem;font-weight:600;color:var(--text-label);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:0.35rem;">Nombre *</label>
                                <input type="text" name="nombre" required maxlength="100"
                                       style="width:100%;padding:0.7rem 0.9rem;border:1px solid var(--border-strong);border-radius:8px;font-size:0.85rem;background:var(--bg-soft);outline:none;" />
                            </div>
                            <div>
                                <label style="display:block;font-size:0.7rem;font-weight:600;color:var(--text-label);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:0.35rem;">Apellido *</label>
                                <input type="text" name="apellido" required maxlength="100"
                                       style="width:100%;padding:0.7rem 0.9rem;border:1px solid var(--border-strong);border-radius:8px;font-size:0.85rem;background:var(--bg-soft);outline:none;" />
                            </div>
                        </div>

                        <div style="margin-bottom:1rem;">
                            <label style="display:block;font-size:0.7rem;font-weight:600;color:var(--text-label);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:0.35rem;">Teléfono</label>
                            <input type="text" name="telefono" maxlength="20"
                                   style="width:100%;padding:0.7rem 0.9rem;border:1px solid var(--border-strong);border-radius:8px;font-size:0.85rem;background:var(--bg-soft);outline:none;" />
                        </div>

                        <div style="margin-bottom:1.5rem;">
                            <label style="display:block;font-size:0.7rem;font-weight:600;color:var(--text-label);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:0.35rem;">Correo electrónico</label>
                            <input type="email" name="correo" maxlength="150"
                                   style="width:100%;padding:0.7rem 0.9rem;border:1px solid var(--border-strong);border-radius:8px;font-size:0.85rem;background:var(--bg-soft);outline:none;" />
                        </div>

                        <div style="display:flex;gap:0.8rem;justify-content:flex-end;">
                            <button type="button" class="btn-outline" onclick="cerrarModalCliente()" style="padding:0.7rem 1.4rem;">Cancelar</button>
                            <button type="submit" class="btn-primary-gold">Registrar Cliente</button>
                        </div>
                    </form>
                </div>
            </div>

        </main>
    </div>

    <footer class="site-footer">
        <div class="footer-grid">
            <div class="footer-brand">
                <h2>L'Avielle</h2>
                <p>Un concepto exclusivo de salón de belleza y spa de bienestar, donde el lujo se traduce en calma, elegancia y atención de nivel internacional.</p>
                <div class="social-icons">
                    <a href="#" class="social-icon"><svg viewBox="0 0 24 24"><rect x="2" y="2" width="20" height="20" rx="5" ry="5" /><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" /><line x1="17.5" y1="6.5" x2="17.51" y2="6.5" /></svg></a>
                    <a href="#" class="social-icon"><svg viewBox="0 0 24 24"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" /></svg></a>
                    <a href="#" class="social-icon"><svg viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18" /><line x1="6" y1="6" x2="18" y2="18" /></svg></a>
                </div>
            </div>
            <div class="footer-col">
                <h3>Navegación</h3>
                <ul class="footer-links">
                    <li><a href="#">Inicio</a></li>
                    <li><a href="#">Servicios</a></li>
                    <li><a href="#">Especialistas</a></li>
                    <li><a href="#">Perfil</a></li>
                    <li><a href="#">Iniciar Sesión</a></li>
                    <li><a href="#">Registrarse</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h3>Contacto & Ubicación</h3>
                <div class="contact-info">
                    <div class="contact-item">
                        <svg viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z" /><circle cx="12" cy="10" r="3" /></svg>
                        <span>Paseo de la Reforma<br />402, Juárez, CDMX</span>
                    </div>
                    <div class="contact-item">
                        <svg viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" /></svg>
                        <span>+52 55 1234 5678</span>
                    </div>
                    <div class="contact-item">
                        <svg viewBox="0 0 24 24"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" /><polyline points="22,6 12,13 2,6" /></svg>
                        <span>contacto@lavielle.com</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <span>© 2026 L'Avielle Salón de Belleza. Todos los derechos reservados.</span>
            <div class="footer-legal">
                <a href="#">Política de Privacidad</a>
                <a href="#">Términos del Servicio</a>
            </div>
        </div>
    </footer>

    <script>
        function abrirModalCliente() {
            document.getElementById('modalCliente').style.display = 'flex';
        }
        function cerrarModalCliente() {
            document.getElementById('modalCliente').style.display = 'none';
        }
        document.getElementById('modalCliente')?.addEventListener('click', function (e) {
            if (e.target === this) cerrarModalCliente();
        });
    </script>

</body>
</html>